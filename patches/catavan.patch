diff --git a/kdenlive-26.08.2/CMakeLists.txt b/kdenlive-26.08.2/CMakeLists.txt
index 93482e2..428703f 100644
--- a/kdenlive-26.08.2/CMakeLists.txt
+++ b/kdenlive-26.08.2/CMakeLists.txt
@@ -81,7 +81,8 @@ if (NOT DEFINED KF_MAJOR)
   set(KF_MAJOR ${QT_MAJOR_VERSION})
 endif()
 
-add_definitions(-DTRANSLATION_DOMAIN=\"kdenlive\")
+# Catavan: own translation domain (catavan.mo), apart from an installed Kdenlive
+add_definitions(-DTRANSLATION_DOMAIN=\"catavan\")
 find_package(KF${KF_MAJOR} ${KF_DEP_VERSION}
     REQUIRED COMPONENTS
     I18n
@@ -186,7 +187,8 @@ endif()
 if(APPLE)
     set(DATA_INSTALL_PREFIX "")
 else()
-    set(DATA_INSTALL_PREFIX "/kdenlive")
+    # Catavan: own data folder (share/catavan)
+    set(DATA_INSTALL_PREFIX "/catavan")
 endif()
 
 if(KF${KF_MAJOR}DocTools_FOUND)
@@ -196,6 +198,13 @@ endif()
 
 # Get current version.
 set(KDENLIVE_VERSION_STRING "${KDENLIVE_VERSION}")
+# Catavan: version of the fork
+set(CATAVAN_VERSION "0.1.0")
+# Catavan: application ID (desktop file, metainfo, Wayland app id); also written in data/catavan.notifyrc,
+# data/org.kde.kdenlive.desktop (X-DBUS-ServiceName) and data/org.kde.kdenlive.appdata.xml
+set(CATAVAN_APP_ID "com.hexoby.Catavan")
+# Catavan: source repository (About, Report Bug, splash release notes); also in data/org.kde.kdenlive.appdata.xml
+set(CATAVAN_REPOSITORY "https://github.com/Matheus290/Catavan")
 if(EXISTS ${CMAKE_SOURCE_DIR}/.git)
   # Probably a Git workspace; determine the revision.
   find_package(Git QUIET)
@@ -235,7 +244,14 @@ add_subdirectory(thumbnailer)
 add_subdirectory(data)
 
 # Install
-ki18n_install(po)
+# Catavan: the translations are installed as catavan.mo (the sources stay po/<lang>/kdenlive.po)
+file(GLOB CATAVAN_PO_FILES ${CMAKE_SOURCE_DIR}/po/*/kdenlive.po)
+foreach(po_file ${CATAVAN_PO_FILES})
+    get_filename_component(po_dir ${po_file} DIRECTORY)
+    get_filename_component(po_lang ${po_dir} NAME)
+    configure_file(${po_file} ${CMAKE_BINARY_DIR}/po-catavan/${po_lang}/catavan.po COPYONLY)
+endforeach()
+ki18n_install(${CMAKE_BINARY_DIR}/po-catavan)
 
 if (BUILD_QCH)
     ecm_install_qch_export(
@@ -252,7 +268,7 @@ install(DIRECTORY LICENSES DESTINATION ${CMAKE_INSTALL_DOCDIR})
 
 ecm_qt_install_logging_categories(
     EXPORT KDENLIVE
-    FILE kdenlive.categories
+    FILE catavan.categories
     DESTINATION ${KDE_INSTALL_LOGGINGCATEGORIESDIR}
 )
 
