+/*
+    Catavan: Auto Ripple and pushing drop
+    SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+#include "catch.hpp"
+#include "test_utils.hpp"
+// test specific headers
+#include "core.h"
+#include "doc/docundostack.hpp"
+#include "doc/kdenlivedoc.h"
+
+#include <climits>
+
+using namespace fakeit;
+
+TEST_CASE("Auto Ripple", "[VegasRipple]")
+{
+    // Create timeline
+    auto binModel = pCore->projectItemModel();
+    binModel->clean();
+    std::shared_ptr<DocUndoStack> undoStack = std::make_shared<DocUndoStack>(nullptr);
+
+    KdenliveDoc document(undoStack, {1, 2});
+    pCore->projectManager()->testSetDocument(&document);
+    QDateTime documentDate = QDateTime::currentDateTime();
+    KdenliveTests::updateTimeline(false, QString(), QString(), documentDate, 0);
+    auto timeline = document.getTimeline(document.uuid());
+    pCore->projectManager()->testSetActiveTimeline(timeline);
+
+    int tid1 = timeline->getTrackIndexFromPosition(2);
+    int tid2 = timeline->getTrackIndexFromPosition(1);
+
+    // Clips of 20 frames
+    QString binId = KdenliveTests::createProducer(pCore->getProjectProfile(), "red", binModel, 20);
+
+    Fun undo = []() { return true; };
+    Fun redo = []() { return true; };
+
+    SECTION("Shift forward moves only the items starting after the position")
+    {
+        int a, b, c;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 10, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 40, b));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 50, c));
+        REQUIRE(TimelineFunctions::rippleShift(timeline, 30, 15, {}, false, undo, redo) == 15);
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 10);
+        REQUIRE(timeline->getClipPosition(b) == 55);
+        REQUIRE(timeline->getClipPosition(c) == 65);
+        REQUIRE(undo());
+        REQUIRE(timeline->getClipPosition(b) == 40);
+        REQUIRE(timeline->getClipPosition(c) == 50);
+    }
+
+    SECTION("Shift forward on some tracks only")
+    {
+        int b, c;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 40, b));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 50, c));
+        REQUIRE(TimelineFunctions::rippleShift(timeline, 30, 15, {tid1}, false, undo, redo) == 15);
+        REQUIRE(timeline->getClipPosition(b) == 55);
+        REQUIRE(timeline->getClipPosition(c) == 50);
+    }
+
+    SECTION("Shift back is limited by the free space of every track")
+    {
+        int a, b, c, d;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 0, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 40, b));
+        // Crosses position 40 on track 2: it stays and limits the move of the clip after it
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 25, c));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 60, d));
+        REQUIRE(TimelineFunctions::rippleShift(timeline, 40, -20, {}, false, undo, redo) == -15);
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 0);
+        REQUIRE(timeline->getClipPosition(b) == 25);
+        REQUIRE(timeline->getClipPosition(c) == 25);
+        REQUIRE(timeline->getClipPosition(d) == 45);
+    }
+
+    SECTION("Ripple delete pulls back all tracks")
+    {
+        int a, b, c, d;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 0, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 20, b));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 40, c));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 50, d));
+        REQUIRE(TimelineFunctions::rippleDelete(timeline, {b}, false, undo, redo) == -20);
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(!timeline->isClip(b));
+        REQUIRE(timeline->getClipPosition(a) == 0);
+        REQUIRE(timeline->getClipPosition(c) == 20);
+        REQUIRE(timeline->getClipPosition(d) == 30);
+        REQUIRE(undo());
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipsCount() == 4);
+        REQUIRE(timeline->getClipPosition(c) == 40);
+        REQUIRE(timeline->getClipPosition(d) == 50);
+    }
+
+    SECTION("Ripple delete of a clip crossed by a later clip on another track")
+    {
+        // A: 10..30 on track 1, B: 15..35 on track 2. Deleting A moves B back to where A started
+        int a, b;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 10, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 15, b));
+        REQUIRE(TimelineFunctions::rippleDelete(timeline, {a}, false, undo, redo) != INT_MIN);
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(b) == 10);
+    }
+
+    SECTION("Ripple delete keeps the gap that existed before the next clip")
+    {
+        // A: 10..12, B at 15: B moves back the duration of A only
+        QString tinyBinId = KdenliveTests::createProducer(pCore->getProjectProfile(), "green", binModel, 2);
+        int a, b;
+        REQUIRE(timeline->requestClipInsertion(tinyBinId, tid1, 10, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 15, b));
+        REQUIRE(TimelineFunctions::rippleDelete(timeline, {a}, false, undo, redo) != INT_MIN);
+        REQUIRE(timeline->getClipPosition(b) == 13);
+    }
+
+    SECTION("Ripple trim of the right edge")
+    {
+        // A: 0..20 (from a 60 frames source, so it can grow) and B: 20..40 on track 1, C: 30..50 on track 2
+        QString longBinId = KdenliveTests::createProducer(pCore->getProjectProfile(), "yellow", binModel, 60);
+        int a, b, c;
+        REQUIRE(timeline->requestClipInsertion(longBinId, tid1, 0, a));
+        REQUIRE(timeline->requestItemResize(a, 20, true, false) == 20);
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 20, b));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 30, c));
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 15, true, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(a) == 15);
+        REQUIRE(timeline->getClipPosition(b) == 15);
+        REQUIRE(timeline->getClipPosition(c) == 25);
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 30, true, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(a) == 30);
+        REQUIRE(timeline->getClipPosition(b) == 30);
+        REQUIRE(timeline->getClipPosition(c) == 40);
+        REQUIRE(undo());
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(a) == 20);
+        REQUIRE(timeline->getClipPosition(b) == 20);
+        REQUIRE(timeline->getClipPosition(c) == 30);
+    }
+
+    SECTION("Ripple trim of the left edge keeps the clip start")
+    {
+        // A: 10..30 and B: 30..50 on track 1
+        int a, b;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 10, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 30, b));
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 15, false, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 10);
+        REQUIRE(timeline->getClipPlaytime(a) == 15);
+        REQUIRE(timeline->getClipIn(a) == 5);
+        REQUIRE(timeline->getClipPosition(b) == 25);
+        // Extend it back from the left
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 20, false, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 10);
+        REQUIRE(timeline->getClipPlaytime(a) == 20);
+        REQUIRE(timeline->getClipIn(a) == 0);
+        REQUIRE(timeline->getClipPosition(b) == 30);
+    }
+
+    SECTION("Ripple trim moves what starts after the clip start, as the drag does")
+    {
+        // A: 0..20 on track 1, B: 10..30 on track 2 (parallel), D: 40..60 on track 1
+        int a, b, d;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 0, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 10, b));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 40, d));
+        // Left edge of B 2 frames to the right: B keeps its start, D (starts after B) moves back, A stays
+        REQUIRE(TimelineFunctions::rippleResize(timeline, b, 18, false, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(b) == 10);
+        REQUIRE(timeline->getClipPlaytime(b) == 18);
+        REQUIRE(timeline->getClipPosition(a) == 0);
+        REQUIRE(timeline->getClipPosition(d) == 38);
+        // Right edge of A 2 frames to the left: B and D (start after A) move back too
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 18, true, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(a) == 18);
+        REQUIRE(timeline->getClipPosition(b) == 8);
+        REQUIRE(timeline->getClipPosition(d) == 36);
+    }
+
+    SECTION("Ripple trim also moves the members of the group that follow, each one alone")
+    {
+        // A: 0..20 grouped with G: 25..45 on track 1, C: 30..50 on track 2
+        int a, g, c;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 0, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 25, g));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 30, c));
+        REQUIRE(timeline->requestClipsGroup({a, g}) > -1);
+        // Right edge: what ends after the old end of A moves back, group member included
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 15, true, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(a) == 15);
+        REQUIRE(timeline->getClipPosition(g) == 20);
+        REQUIRE(timeline->getClipPosition(c) == 25);
+        // Left edge: the start of A stays, what starts after it moves back
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 10, false, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 0);
+        REQUIRE(timeline->getClipPlaytime(a) == 10);
+        REQUIRE(timeline->getClipPosition(g) == 15);
+        REQUIRE(timeline->getClipPosition(c) == 20);
+        REQUIRE(undo());
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(a) == 20);
+        REQUIRE(timeline->getClipPosition(g) == 25);
+        REQUIRE(timeline->getClipPosition(c) == 30);
+    }
+
+    SECTION("Grouped clips: an edge pushes the edges it reaches, each clip stops at the end of its material")
+    {
+        // A: 0..20 (all of its 20 frames material) on track 1, B: 0..25 (60 frames material) on track 2, grouped
+        QString longBinId = KdenliveTests::createProducer(pCore->getProjectProfile(), "yellow", binModel, 60);
+        int a, b;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 0, a));
+        REQUIRE(timeline->requestClipInsertion(longBinId, tid2, 0, b));
+        REQUIRE(timeline->requestItemResize(b, 25, true, false) == 25);
+        REQUIRE(timeline->requestClipsGroup({a, b}) > -1);
+        // Right edge of A, either way: B does not change
+        REQUIRE(timeline->requestItemResize(a, 15, true, false) == 15);
+        REQUIRE(timeline->getClipPlaytime(b) == 25);
+        REQUIRE(timeline->requestItemResize(a, 20, true, false) == 20);
+        REQUIRE(timeline->getClipPlaytime(b) == 25);
+        // Right edge of B to the left: nothing happens to A until 20...
+        REQUIRE(timeline->requestItemResize(b, 22, true, false) == 22);
+        REQUIRE(timeline->getClipPlaytime(a) == 20);
+        // ... then A is pushed (also when the edge jumps over A's edge)
+        REQUIRE(timeline->requestItemResize(b, 17, true, false) == 17);
+        REQUIRE(timeline->getClipPlaytime(a) == 17);
+        REQUIRE(timeline->requestItemResize(b, 15, true, false) == 15);
+        REQUIRE(timeline->getClipPlaytime(a) == 15);
+        // Growing again: A follows until the end of its material (20), B goes on
+        REQUIRE(timeline->requestItemResize(b, 25, true, false) == 25);
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(a) == 20);
+        REQUIRE(timeline->getClipPlaytime(b) == 25);
+    }
+
+    SECTION("Grouped clips aligned: growing the right edge of one makes the other follow, a clip in the way stops it")
+    {
+        // A and B: 0..20 (60 frames material), grouped; C at 30 after A. The timeline uses this while dragging,
+        // before the ripple of the release
+        QString longBinId = KdenliveTests::createProducer(pCore->getProjectProfile(), "yellow", binModel, 60);
+        int a, b, c;
+        REQUIRE(timeline->requestClipInsertion(longBinId, tid1, 0, a));
+        REQUIRE(timeline->requestClipInsertion(longBinId, tid2, 0, b));
+        REQUIRE(timeline->requestItemResize(a, 20, true, false) == 20);
+        REQUIRE(timeline->requestItemResize(b, 20, true, false) == 20);
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 30, c));
+        REQUIRE(timeline->requestClipsGroup({a, b}) > -1);
+        REQUIRE(timeline->requestItemResize(a, 26, true, false) == 26);
+        REQUIRE(timeline->getClipPlaytime(b) == 26);
+        // Past the start of C: the trim stops at C (shorter than asked)
+        REQUIRE(timeline->requestItemResize(a, 40, true, false) == 30);
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(b) == 30);
+        REQUIRE(timeline->getClipPosition(c) == 30);
+    }
+
+    SECTION("Grouped clips: growing the right edge past the edge of another clip of the group makes it follow")
+    {
+        // A: 0..10 (60 frames material) on track 1, B: 0..15 (20 frames material) on track 2, grouped
+        QString longBinId = KdenliveTests::createProducer(pCore->getProjectProfile(), "yellow", binModel, 60);
+        int a, b;
+        REQUIRE(timeline->requestClipInsertion(longBinId, tid1, 0, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 0, b));
+        REQUIRE(timeline->requestItemResize(a, 10, true, false) == 10);
+        REQUIRE(timeline->requestItemResize(b, 15, true, false) == 15);
+        REQUIRE(timeline->requestClipsGroup({a, b}) > -1);
+        // Not reached yet: B does not change
+        REQUIRE(timeline->requestItemResize(a, 13, true, false) == 13);
+        REQUIRE(timeline->getClipPlaytime(b) == 15);
+        // Past the end of B: B follows, up to the end of its material (20)
+        REQUIRE(timeline->requestItemResize(a, 18, true, false) == 18);
+        REQUIRE(timeline->getClipPlaytime(b) == 18);
+        REQUIRE(timeline->requestItemResize(a, 30, true, false) == 30);
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(a) == 30);
+        REQUIRE(timeline->getClipPlaytime(b) == 20);
+    }
+
+    SECTION("Grouped clips with Auto Ripple: growing the right edge past the edge of another clip of the group")
+    {
+        // A: 0..10 (60 frames material), B: 0..15 (20 frames material), grouped; C at 40 after A
+        QString longBinId = KdenliveTests::createProducer(pCore->getProjectProfile(), "yellow", binModel, 60);
+        int a, b, c;
+        REQUIRE(timeline->requestClipInsertion(longBinId, tid1, 0, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 0, b));
+        REQUIRE(timeline->requestItemResize(a, 10, true, false) == 10);
+        REQUIRE(timeline->requestItemResize(b, 15, true, false) == 15);
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 40, c));
+        REQUIRE(timeline->requestClipsGroup({a, b}) > -1);
+        // A to 30: B follows its edge up to its material (20) and is not moved, C moves by 20
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 30, true, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(a) == 30);
+        REQUIRE(timeline->getClipPosition(b) == 0);
+        REQUIRE(timeline->getClipPlaytime(b) == 20);
+        REQUIRE(timeline->getClipPosition(c) == 60);
+        REQUIRE(undo());
+        REQUIRE(timeline->getClipPlaytime(a) == 10);
+        REQUIRE(timeline->getClipPlaytime(b) == 15);
+        REQUIRE(timeline->getClipPosition(c) == 40);
+        // A to 13 (B not reached): B does not change
+        undo = []() { return true; };
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 13, true, false, undo, redo));
+        REQUIRE(timeline->getClipPlaytime(b) == 15);
+    }
+
+    SECTION("Grouped clips with Auto Ripple: same edges behavior, no ripple inside the group")
+    {
+        QString longBinId = KdenliveTests::createProducer(pCore->getProjectProfile(), "yellow", binModel, 60);
+        int a, b, c;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 0, a));
+        REQUIRE(timeline->requestClipInsertion(longBinId, tid2, 0, b));
+        REQUIRE(timeline->requestItemResize(b, 25, true, false) == 25);
+        REQUIRE(timeline->requestClipsGroup({a, b}) > -1);
+        // C: outside the group, after them
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 30, c));
+        REQUIRE(TimelineFunctions::rippleResize(timeline, b, 15, true, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(b) == 15);
+        REQUIRE(timeline->getClipPlaytime(a) == 15);
+        REQUIRE(timeline->getClipPosition(a) == 0);
+        REQUIRE(timeline->getClipPosition(c) == 20);
+        REQUIRE(TimelineFunctions::rippleResize(timeline, b, 25, true, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(b) == 25);
+        REQUIRE(timeline->getClipPlaytime(a) == 20);
+        REQUIRE(timeline->getClipPosition(c) == 30);
+    }
+
+    SECTION("Ripple moves the markers when asked")
+    {
+        int b;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 40, b));
+        double fps = pCore->getCurrentFps();
+        timeline->getGuideModel()->addMarker(GenTime(10, fps), QStringLiteral("before"));
+        timeline->getGuideModel()->addMarker(GenTime(45, fps), QStringLiteral("after"));
+        REQUIRE(TimelineFunctions::rippleShift(timeline, 30, 15, {}, true, undo, redo) == 15);
+        bool ok = false;
+        timeline->getGuideModel()->getMarker(GenTime(10, fps), &ok);
+        REQUIRE(ok);
+        timeline->getGuideModel()->getMarker(GenTime(60, fps), &ok);
+        REQUIRE(ok);
+        timeline->getGuideModel()->getMarker(GenTime(45, fps), &ok);
+        REQUIRE(!ok);
+    }
+
+    SECTION("Regions follow their content in a ripple")
+    {
+        double fps = pCore->getCurrentFps();
+        auto guides = timeline->getGuideModel();
+        // Returns the duration of the marker at frame (0 for a point marker), or -1 when there is none
+        auto markerAt = [&](int frame) {
+            bool ok = false;
+            CommentedTime marker = guides->getMarker(GenTime(frame, fps), &ok);
+            return ok ? (marker.hasRange() ? marker.duration().frames(fps) : 0) : -1;
+        };
+        auto markerCount = [&]() { return guides->getAllMarkers().size(); };
+        guides->addMarker(GenTime(5, fps), QStringLiteral("point before"));
+        guides->addRangeMarker(GenTime(10, fps), GenTime(20, fps), QStringLiteral("crossing"));
+        guides->addRangeMarker(GenTime(40, fps), GenTime(10, fps), QStringLiteral("after"));
+        guides->addMarker(GenTime(60, fps), QStringLiteral("point after"));
+
+        // Inserting 15 frames at 20: the region crossing it grows, what follows moves
+        REQUIRE(guides->rippleMarkers(20, 15, undo, redo));
+        REQUIRE(markerAt(5) == 0);
+        REQUIRE(markerAt(10) == 35);
+        REQUIRE(markerAt(55) == 10);
+        REQUIRE(markerAt(75) == 0);
+        REQUIRE(markerCount() == 4);
+        REQUIRE(undo());
+        REQUIRE(markerAt(10) == 20);
+        REQUIRE(markerAt(40) == 10);
+        REQUIRE(markerAt(60) == 0);
+        REQUIRE(markerCount() == 4);
+
+        // Removing [12, 20): the crossing region loses the removed part, what follows moves back
+        undo = []() { return true; };
+        redo = []() { return true; };
+        REQUIRE(guides->rippleMarkers(20, -8, undo, redo));
+        REQUIRE(markerAt(5) == 0);
+        REQUIRE(markerAt(10) == 12);
+        REQUIRE(markerAt(32) == 10);
+        REQUIRE(markerAt(52) == 0);
+        REQUIRE(markerCount() == 4);
+        REQUIRE(undo());
+        REQUIRE(markerAt(10) == 20);
+        REQUIRE(markerAt(40) == 10);
+    }
+
+    SECTION("Regions in a removed span")
+    {
+        double fps = pCore->getCurrentFps();
+        auto guides = timeline->getGuideModel();
+        auto markerAt = [&](int frame) {
+            bool ok = false;
+            CommentedTime marker = guides->getMarker(GenTime(frame, fps), &ok);
+            return ok ? (marker.hasRange() ? marker.duration().frames(fps) : 0) : -1;
+        };
+        // Removing [12, 20)
+        guides->addRangeMarker(GenTime(14, fps), GenTime(4, fps), QStringLiteral("inside"));
+        guides->addRangeMarker(GenTime(16, fps), GenTime(10, fps), QStringLiteral("starts inside"));
+        guides->addMarker(GenTime(15, fps), QStringLiteral("point inside"));
+        REQUIRE(guides->rippleMarkers(20, -8, undo, redo));
+        // A region entirely removed becomes a point marker at the cut, one starting inside starts at the cut
+        // (but both land at 12: the second one replaces the first), a point marker inside stays
+        REQUIRE(markerAt(14) == -1);
+        REQUIRE(markerAt(16) == -1);
+        REQUIRE(markerAt(15) == 0);
+        REQUIRE(markerAt(12) == 6);
+        REQUIRE(undo());
+        REQUIRE(markerAt(14) == 4);
+        REQUIRE(markerAt(16) == 10);
+        REQUIRE(markerAt(15) == 0);
+    }
+
+    SECTION("Moving markers right never drops one")
+    {
+        double fps = pCore->getCurrentFps();
+        auto guides = timeline->getGuideModel();
+        // The first one lands where the second one is before it moves
+        guides->addMarker(GenTime(10, fps), QStringLiteral("first"));
+        guides->addMarker(GenTime(25, fps), QStringLiteral("second"));
+        REQUIRE(guides->rippleMarkers(0, 15, undo, redo));
+        bool ok = false;
+        REQUIRE(guides->getMarker(GenTime(25, fps), &ok).comment() == QStringLiteral("first"));
+        REQUIRE(ok);
+        REQUIRE(guides->getMarker(GenTime(40, fps), &ok).comment() == QStringLiteral("second"));
+        REQUIRE(ok);
+        REQUIRE(guides->getAllMarkers().size() == 2);
+    }
+
+    SECTION("Auto Ripple stretches a region crossing the edit point")
+    {
+        int b;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 40, b));
+        double fps = pCore->getCurrentFps();
+        timeline->getGuideModel()->addRangeMarker(GenTime(20, fps), GenTime(30, fps), QStringLiteral("region"));
+        REQUIRE(TimelineFunctions::rippleShift(timeline, 30, 15, {}, true, undo, redo) == 15);
+        bool ok = false;
+        CommentedTime region = timeline->getGuideModel()->getMarker(GenTime(20, fps), &ok);
+        REQUIRE(ok);
+        REQUIRE(region.duration().frames(fps) == 45);
+        REQUIRE(timeline->getClipPosition(b) == 55);
+    }
+
+    SECTION("Ripple drag of a clip carries the regions as the timeline does")
+    {
+        // Clip 20..40, regions crossing (10..30), covering (20..40) and after (60..70), point marker at 50
+        int a;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 20, a));
+        double fps = pCore->getCurrentFps();
+        auto guides = timeline->getGuideModel();
+        guides->addRangeMarker(GenTime(10, fps), GenTime(20, fps), QStringLiteral("crossing"));
+        guides->addRangeMarker(GenTime(20, fps), GenTime(20, fps), QStringLiteral("covering"));
+        guides->addRangeMarker(GenTime(60, fps), GenTime(10, fps), QStringLiteral("after"));
+        guides->addMarker(GenTime(50, fps), QStringLiteral("point"));
+        auto range = [&](int frame, const QString &comment) {
+            bool ok = false;
+            CommentedTime marker = guides->getMarker(GenTime(frame, fps), &ok);
+            return ok && marker.comment() == comment ? marker.duration().frames(fps) : -1;
+        };
+        // Timeline.qml startRippleDrag + drag preview + TimelineController::requestSpacerEndOperation, dragged by 10
+        auto op = TimelineFunctions::requestSpacerStartOperation(timeline, -1, 20, false, false, true);
+        REQUIRE(op.first > -1);
+        const QVector<int> selected = guides->getMarkersIdInRange(20, -1);
+        guides->moveMarkersWithoutUndo(selected, 10);
+        guides->moveMarkersWithoutUndo(selected, -10, false);
+        REQUIRE(TimelineFunctions::requestSpacerEndOperation(timeline, op.first, 20, 30, -1, 25, undo, redo));
+        REQUIRE(timeline->getClipPosition(a) == 30);
+        REQUIRE(range(10, QStringLiteral("crossing")) == 30);
+        REQUIRE(range(30, QStringLiteral("covering")) == 20);
+        REQUIRE(range(70, QStringLiteral("after")) == 10);
+        REQUIRE(range(60, QStringLiteral("point")) == 0);
+        REQUIRE(guides->getAllMarkers().size() == 4);
+    }
+
+    SECTION("Ripple drag moves only the clips starting at or after the dragged clip")
+    {
+        // A: 20..40 on track 1, B: 22..40 on track 2 (both end together)
+        QString shortBinId = KdenliveTests::createProducer(pCore->getProjectProfile(), "blue", binModel, 18);
+        int a, b;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 20, a));
+        REQUIRE(timeline->requestClipInsertion(shortBinId, tid2, 22, b));
+        // Moving B does not move A
+        auto op = TimelineFunctions::requestSpacerStartOperation(timeline, -1, 22, false, false, true);
+        REQUIRE(op.first > -1);
+        int start = timeline->getItemPosition(op.first);
+        REQUIRE(TimelineFunctions::requestSpacerEndOperation(timeline, op.first, start, start + 10, -1, -1, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 20);
+        REQUIRE(timeline->getClipPosition(b) == 32);
+        // Moving A moves B too
+        op = TimelineFunctions::requestSpacerStartOperation(timeline, -1, 20, false, false, true);
+        REQUIRE(op.first > -1);
+        start = timeline->getItemPosition(op.first);
+        REQUIRE(TimelineFunctions::requestSpacerEndOperation(timeline, op.first, start, start + 10, -1, -1, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 30);
+        REQUIRE(timeline->getClipPosition(b) == 42);
+    }
+
+    SECTION("Drop pushes the following clips of its tracks when there is no room")
+    {
+        int a, b, e, id = -1;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 0, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 25, b));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 30, e));
+        REQUIRE(TimelineFunctions::insertClipPushing(timeline, binId, tid1, 22, 20, {tid1}, false, false, id, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(id) == 22);
+        REQUIRE(timeline->getClipPosition(b) == 45);
+        REQUIRE(timeline->getClipPosition(e) == 30);
+        REQUIRE(undo());
+        REQUIRE(!timeline->isClip(id));
+        REQUIRE(timeline->getClipPosition(b) == 25);
+    }
+
+    SECTION("Drop inside a clip goes after it")
+    {
+        int a, b, id = -1;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 0, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 25, b));
+        REQUIRE(TimelineFunctions::insertClipPushing(timeline, binId, tid1, 10, 20, {tid1}, false, false, id, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 0);
+        REQUIRE(timeline->getClipPosition(id) == 20);
+        REQUIRE(timeline->getClipPosition(b) == 45);
+    }
+
+    SECTION("Drop with Auto Ripple pushes all tracks")
+    {
+        int a, b, e, id = -1;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 0, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 25, b));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 30, e));
+        REQUIRE(TimelineFunctions::insertClipPushing(timeline, binId, tid1, 22, 20, {tid1}, true, false, id, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(id) == 22);
+        REQUIRE(timeline->getClipPosition(b) == 45);
+        REQUIRE(timeline->getClipPosition(e) == 50);
+    }
+
+    SECTION("Drop where the clip fits does not move anything")
+    {
+        int a, b, id = -1;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 0, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 60, b));
+        REQUIRE(TimelineFunctions::insertClipPushing(timeline, binId, tid1, 30, 20, {tid1}, true, false, id, undo, redo));
+        REQUIRE(timeline->getClipPosition(id) == 30);
+        REQUIRE(timeline->getClipPosition(b) == 60);
