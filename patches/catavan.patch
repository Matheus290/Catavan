+TEST_CASE("Auto Ripple with crossfades and slipped clips", "[VegasRipple]")
+{
+    auto binModel = pCore->projectItemModel();
+    binModel->clean();
+    std::shared_ptr<DocUndoStack> undoStack = std::make_shared<DocUndoStack>(nullptr);
+    KdenliveDoc document(undoStack);
+    pCore->projectManager()->testSetDocument(&document);
+    QDateTime documentDate = QDateTime::currentDateTime();
+    KdenliveTests::updateTimeline(false, QString(), QString(), documentDate, 0);
+    auto timeline = document.getTimeline(document.uuid());
+    pCore->projectManager()->testSetActiveTimeline(timeline);
+    int videoTrack = timeline->getTrackIndexFromPosition(2);
+
+    // Clips with audio and video, 100 frames of material. A: 100 to 140, B: 200 to 240, both from frame 10
+    QString binId = KdenliveTests::createProducerWithSound(pCore->getProjectProfile(), binModel, 100);
+    QMap<int, QString> audioInfo;
+    audioInfo.insert(1, QStringLiteral("stream1"));
+    KdenliveTests::setAudioTargets(timeline, audioInfo);
+    int a, b;
+    REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 100, a));
+    REQUIRE(timeline->requestItemResize(a, 90, false, true));
+    REQUIRE(timeline->requestItemResize(a, 40, true, true));
+    REQUIRE(timeline->requestClipMove(a, videoTrack, 100));
+    REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 200, b));
+    REQUIRE(timeline->requestItemResize(b, 90, false, true));
+    REQUIRE(timeline->requestItemResize(b, 40, true, true));
+    REQUIRE(timeline->requestClipMove(b, videoTrack, 200));
+    const int audioA = timeline->getClipSplitPartner(a);
+    const int audioB = timeline->getClipSplitPartner(b);
+    REQUIRE(audioA > -1);
+    REQUIRE(audioB > -1);
+    const int inA = timeline->getClipIn(a);
+    const int inB = timeline->getClipIn(b);
+    Fun undo = []() { return true; };
+    Fun redo = []() { return true; };
+    // The audio part always at the same place and content as the video part
+    auto inSync = [&]() {
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(audioA) == timeline->getClipPosition(a));
+        REQUIRE(timeline->getClipIn(audioA) == timeline->getClipIn(a));
+        REQUIRE(timeline->getClipPosition(audioB) == timeline->getClipPosition(b));
+        REQUIRE(timeline->getClipIn(audioB) == timeline->getClipIn(b));
+    };
+    // B over the last 10 frames of A: a crossfade 130 to 140
+    auto crossfade = [&]() {
+        REQUIRE(timeline->requestFakeClipMove(b, videoTrack, 130, true, false, false));
+        REQUIRE(timeline->requestCrossfadeMove(b, true) == 1);
+        REQUIRE(timeline->getMixDuration(b) == 10);
+        inSync();
+    };
+
+    SECTION("Right edge of the first clip of a crossfade: the crossfade moves with the edge")
+    {
+        crossfade();
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 25, true, false, undo, redo));
+        inSync();
+        REQUIRE(timeline->getClipPlaytime(a) == 25);
+        REQUIRE(timeline->getClipIn(a) == inA);
+        REQUIRE(timeline->getClipPosition(b) == 115);
+        REQUIRE(timeline->getClipIn(b) == inB);
+        REQUIRE(timeline->getMixDuration(b) == 10);
+        REQUIRE(timeline->getMixDuration(audioB) == 10);
+        REQUIRE(undo());
+        inSync();
+        REQUIRE(timeline->getClipPlaytime(a) == 40);
+        REQUIRE(timeline->getClipPosition(b) == 130);
+        REQUIRE(timeline->getMixDuration(b) == 10);
+    }
+
+    SECTION("A clip never gets shorter than its crossfades and one frame")
+    {
+        crossfade();
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 1, true, false, undo, redo));
+        inSync();
+        REQUIRE(timeline->getClipPlaytime(a) == 11);
+        REQUIRE(timeline->getClipPosition(b) == 101);
+        REQUIRE(timeline->getMixDuration(b) == 10);
+    }
+
+    SECTION("Left edge of the second clip of a crossfade: the crossfade stays, the content slips")
+    {
+        crossfade();
+        REQUIRE(TimelineFunctions::rippleResize(timeline, b, 30, false, false, undo, redo));
+        inSync();
+        REQUIRE(timeline->getClipPosition(b) == 130);
+        REQUIRE(timeline->getClipPlaytime(b) == 30);
+        REQUIRE(timeline->getClipIn(b) == inB + 10);
+        REQUIRE(timeline->getMixDuration(b) == 10);
+    }
+
+    SECTION("A slipped clip keeps its content when it moves")
+    {
+        // The left edge slips the content of both parts; MLT used to give the old in point back on a move
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 30, false, false, undo, redo));
+        inSync();
+        REQUIRE(timeline->getClipIn(a) == inA + 10);
+        REQUIRE(timeline->requestClipMove(a, videoTrack, 300));
+        inSync();
+        REQUIRE(timeline->getClipPosition(a) == 300);
+        REQUIRE(timeline->getClipIn(a) == inA + 10);
+        // The same after a ripple: B (pulled back to 190 by the first trim) slipped, then pulled back by the right edge of A
+        REQUIRE(TimelineFunctions::rippleResize(timeline, b, 20, false, false, undo, redo));
+        REQUIRE(timeline->requestClipMove(a, videoTrack, 150));
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 10, true, false, undo, redo));
+        inSync();
+        REQUIRE(timeline->getClipPosition(b) == 170);
+        REQUIRE(timeline->getClipIn(b) == inB + 20);
+    }
+
+    SECTION("A crossfade drag needs at least two frames of overlap")
+    {
+        REQUIRE(timeline->suggestCrossfadeMove(b, videoTrack, 139, 0, 0).at(0).toInt() != 139);
+        REQUIRE(timeline->suggestCrossfadeMove(b, videoTrack, 138, 0, 0).at(0).toInt() == 138);
+    }
+
+    pCore->projectManager()->closeCurrentDocument(false, false);
+}
