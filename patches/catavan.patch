+/*
+    Catavan: overlapping clips creates a crossfade (overlapCrossfade)
+    SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+#include "catch.hpp"
+#include "test_utils.hpp"
+// test specific headers
+#include "core.h"
+#include "doc/docundostack.hpp"
+#include "doc/kdenlivedoc.h"
+#include "kdenlivesettings.h"
+#include "timeline2/model/timelinefunctions.hpp"
+
+using namespace fakeit;
+
+TEST_CASE("Crossfade by overlap", "[VegasCrossfade]")
+{
+    auto binModel = pCore->projectItemModel();
+    binModel->clean();
+    std::shared_ptr<DocUndoStack> undoStack = std::make_shared<DocUndoStack>(nullptr);
+
+    KdenliveDoc document(undoStack);
+    pCore->projectManager()->testSetDocument(&document);
+    QDateTime documentDate = QDateTime::currentDateTime();
+    KdenliveTests::updateTimeline(false, QString(), QString(), documentDate, 0);
+    auto timeline = document.getTimeline(document.uuid());
+    pCore->projectManager()->testSetActiveTimeline(timeline);
+    KdenliveSettings::setOverlapCrossfade(true);
+
+    int audioTrack = timeline->getTrackIndexFromPosition(1);
+    int videoTrack = timeline->getTrackIndexFromPosition(2);
+
+    // Clips with audio and video, 100 frames of material
+    QString binId = KdenliveTests::createProducerWithSound(pCore->getProjectProfile(), binModel, 100);
+    QMap<int, QString> audioInfo;
+    audioInfo.insert(1, QStringLiteral("stream1"));
+    KdenliveTests::setAudioTargets(timeline, audioInfo);
+
+    // A: 100 to 140, B: 200 to 240, both from frame 10 of the material
+    int a, b;
+    REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 100, a));
+    REQUIRE(timeline->requestItemResize(a, 90, false, true));
+    REQUIRE(timeline->requestItemResize(a, 40, true, true));
+    REQUIRE(timeline->requestClipMove(a, videoTrack, 100));
+    REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 200, b));
+    REQUIRE(timeline->requestItemResize(b, 90, false, true));
+    REQUIRE(timeline->requestItemResize(b, 40, true, true));
+    REQUIRE(timeline->requestClipMove(b, videoTrack, 200));
+    int audioA = timeline->getClipSplitPartner(a);
+    int audioB = timeline->getClipSplitPartner(b);
+    REQUIRE(audioA > -1);
+    REQUIRE(audioB > -1);
+    const int inA = timeline->getClipIn(a);
+    const int inB = timeline->getClipIn(b);
+    auto videoMixes = [&]() { return KdenliveTests::getTrackById_const(timeline, videoTrack)->mixCount(); };
+    auto audioMixes = [&]() { return KdenliveTests::getTrackById_const(timeline, audioTrack)->mixCount(); };
+
+    auto initialState = [&]() {
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 100);
+        REQUIRE(timeline->getClipPlaytime(a) == 40);
+        REQUIRE(timeline->getClipIn(a) == inA);
+        REQUIRE(timeline->getClipPosition(b) == 200);
+        REQUIRE(timeline->getClipPlaytime(b) == 40);
+        REQUIRE(timeline->getClipIn(b) == inB);
+        REQUIRE(timeline->getClipPosition(audioB) == 200);
+        REQUIRE(videoMixes() == 0);
+        REQUIRE(audioMixes() == 0);
+    };
+    // B dragged so that its start covers the last `overlap` frames of A, with the full content of both clips
+    auto overlapState = [&](int overlap) {
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 100);
+        REQUIRE(timeline->getClipPlaytime(a) == 40);
+        REQUIRE(timeline->getClipIn(a) == inA);
+        REQUIRE(timeline->getClipPosition(b) == 140 - overlap);
+        REQUIRE(timeline->getClipPlaytime(b) == 40);
+        REQUIRE(timeline->getClipIn(b) == inB);
+        REQUIRE(timeline->getClipPosition(audioB) == 140 - overlap);
+        REQUIRE(timeline->getClipPlaytime(audioB) == 40);
+        REQUIRE(timeline->getMixDuration(b) == overlap);
+        REQUIRE(timeline->getMixDuration(audioB) == overlap);
+        REQUIRE(videoMixes() == 1);
+        REQUIRE(audioMixes() == 1);
+    };
+    auto drag = [&](int clipId, int position) {
+        REQUIRE(timeline->canCrossfadeDrag(clipId));
+        REQUIRE(timeline->requestFakeClipMove(clipId, timeline->getClipTrackId(clipId), position, true, false, false));
+    };
+
+    initialState();
+
+    SECTION("Overlapping the end of a clip creates a crossfade on the video and audio tracks, undo and redo")
+    {
+        drag(b, 130);
+        REQUIRE(timeline->planCrossfadeMove(b, 0));
+        REQUIRE(timeline->requestCrossfadeMove(b, true) == 1);
+        overlapState(10);
+        undoStack->undo();
+        initialState();
+        undoStack->redo();
+        overlapState(10);
+    }
+
+    SECTION("Overlapping the start of a clip (A moved over B)")
+    {
+        drag(a, 165);
+        REQUIRE(timeline->requestCrossfadeMove(a, true) == 1);
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 165);
+        REQUIRE(timeline->getClipPlaytime(a) == 40);
+        REQUIRE(timeline->getClipIn(a) == inA);
+        REQUIRE(timeline->getClipPosition(b) == 200);
+        REQUIRE(timeline->getClipPlaytime(b) == 40);
+        REQUIRE(timeline->getClipIn(b) == inB);
+        REQUIRE(timeline->getMixDuration(b) == 5);
+        REQUIRE(videoMixes() == 1);
+        REQUIRE(audioMixes() == 1);
+        undoStack->undo();
+        initialState();
+    }
+
+    SECTION("Dragging again changes the crossfade, dragging away removes it and the clips keep their full length")
+    {
+        drag(b, 130);
+        REQUIRE(timeline->requestCrossfadeMove(b, true) == 1);
+        overlapState(10);
+        // Longer
+        drag(b, 120);
+        REQUIRE(timeline->requestCrossfadeMove(b, true) == 1);
+        overlapState(20);
+        // Shorter
+        drag(b, 135);
+        REQUIRE(timeline->requestCrossfadeMove(b, true) == 1);
+        overlapState(5);
+        // Away
+        drag(b, 200);
+        REQUIRE(timeline->requestCrossfadeMove(b, true) == 1);
+        initialState();
+        undoStack->undo();
+        overlapState(5);
+        undoStack->undo();
+        overlapState(20);
+        undoStack->undo();
+        overlapState(10);
+        undoStack->redo();
+        overlapState(20);
+    }
+
+    SECTION("Dragging again keeps the transition chosen for the crossfade")
+    {
+        drag(b, 130);
+        REQUIRE(timeline->requestCrossfadeMove(b, true) == 1);
+        auto track = KdenliveTests::getTrackById_const(timeline, videoTrack);
+        const QString defaultAsset = track->getMixParams(b).first;
+        timeline->switchComposition(b, QStringLiteral("wipe"));
+        REQUIRE(track->getMixParams(b).first == QStringLiteral("wipe"));
+        drag(b, 120);
+        REQUIRE(timeline->requestCrossfadeMove(b, true) == 1);
+        overlapState(20);
+        REQUIRE(track->getMixParams(b).first == QStringLiteral("wipe"));
+        undoStack->undo();
+        overlapState(10);
+        REQUIRE(track->getMixParams(b).first == QStringLiteral("wipe"));
+        undoStack->redo();
+        overlapState(20);
+        REQUIRE(track->getMixParams(b).first == QStringLiteral("wipe"));
+        // A new crossfade starts with the default transition
+        drag(b, 200);
+        REQUIRE(timeline->requestCrossfadeMove(b, true) == 1);
+        initialState();
+        int c;
+        REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 300, c));
+        REQUIRE(timeline->requestItemResize(c, 20, true, true));
+        drag(c, 235);
+        REQUIRE(timeline->requestCrossfadeMove(c, true) == 1);
+        REQUIRE(track->getMixParams(c).first == defaultAsset);
+    }
+
+    SECTION("Dragging the first clip of a crossfade away removes it too")
+    {
+        drag(b, 130);
+        REQUIRE(timeline->requestCrossfadeMove(b, true) == 1);
+        overlapState(10);
+        drag(a, 50);
+        REQUIRE(timeline->requestCrossfadeMove(a, true) == 1);
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 50);
+        REQUIRE(timeline->getClipPlaytime(a) == 40);
+        REQUIRE(timeline->getClipIn(a) == inA);
+        REQUIRE(timeline->getClipPosition(b) == 130);
+        REQUIRE(timeline->getClipPlaytime(b) == 40);
+        REQUIRE(timeline->getClipIn(b) == inB);
+        REQUIRE(videoMixes() == 0);
+        REQUIRE(audioMixes() == 0);
+        undoStack->undo();
+        overlapState(10);
+    }
+
+    SECTION("A clip between two clips overlaps both")
+    {
+        int c;
+        REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 300, c));
+        REQUIRE(timeline->requestItemResize(c, 30, true, true));
+        // C (30 frames) over the end of A (5 frames) and the start of B (7 frames): 135 to 165 with B at 158
+        REQUIRE(timeline->requestClipMove(b, videoTrack, 158));
+        drag(c, 135);
+        REQUIRE(timeline->planCrossfadeMove(c, 0));
+        REQUIRE(timeline->requestCrossfadeMove(c, true) == 1);
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(c) == 135);
+        REQUIRE(timeline->getClipPlaytime(c) == 30);
+        REQUIRE(timeline->getMixDuration(c) == 5);
+        REQUIRE(timeline->getMixDuration(b) == 7);
+        REQUIRE(videoMixes() == 2);
+        REQUIRE(audioMixes() == 2);
+        undoStack->undo();
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(c) == 300);
+        REQUIRE(videoMixes() == 0);
+    }
+
+    SECTION("Covering a clip or overlapping the two crossfades is not allowed")
+    {
+        // B exactly over A
+        drag(b, 100);
+        REQUIRE_FALSE(timeline->planCrossfadeMove(b, 0));
+        // B inside A
+        int c;
+        REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 300, c));
+        REQUIRE(timeline->requestItemResize(c, 10, true, true));
+        drag(c, 110);
+        REQUIRE_FALSE(timeline->planCrossfadeMove(c, 0));
+        // C over the crossfade of A and B
+        drag(b, 130);
+        REQUIRE(timeline->requestCrossfadeMove(b, true) == 1);
+        drag(c, 135);
+        REQUIRE_FALSE(timeline->planCrossfadeMove(c, 0));
+    }
+
+    SECTION("Without the option, the usual move")
+    {
+        KdenliveSettings::setOverlapCrossfade(false);
+        REQUIRE_FALSE(timeline->canCrossfadeDrag(b));
+        REQUIRE(timeline->requestCrossfadeMove(b, true) == -1);
+        KdenliveSettings::setOverlapCrossfade(true);
+    }
+
+    SECTION("Drag suggestions stop at the last valid position")
+    {
+        // From 200 to 100 in one step: B would cover A exactly, it stops at 101 (39 frames over A)
+        QVariantList result = timeline->suggestCrossfadeMove(b, videoTrack, 100, -1, 0);
+        REQUIRE(result.at(0).toInt() == 101);
+        REQUIRE(timeline->planCrossfadeMove(b, 0));
+        REQUIRE(timeline->requestCrossfadeMove(b, true) == 1);
+        overlapState(39);
+    }
+
+    SECTION("The crossfades of the drag, to draw them while dragging")
+    {
+        drag(b, 130);
+        QVariantList preview = timeline->crossfadePreview(b);
+        REQUIRE(preview.size() == 2);
+        for (const QVariant &p : preview) {
+            QVariantMap m = p.toMap();
+            REQUIRE(m.value(QStringLiteral("start")).toInt() == 130);
+            REQUIRE(m.value(QStringLiteral("length")).toInt() == 10);
+        }
+        drag(b, 150);
+        REQUIRE(timeline->crossfadePreview(b).isEmpty());
+    }
+
+    SECTION("Auto Ripple drag over the end of the clip before: crossfade, the clips after it follow")
+    {
+        // C after B on the video track
+        int c;
+        REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 260, c));
+        REQUIRE(timeline->requestItemResize(c, 20, true, true));
+        int audioC = timeline->getClipSplitPartner(c);
+        Fun undo = []() { return true; };
+        Fun redo = []() { return true; };
+        int cid = TimelineFunctions::requestSpacerStartOperation(timeline, -1, 200, false, false, true).first;
+        REQUIRE(cid > -1);
+        REQUIRE(timeline->getItemPosition(cid) == 200);
+        // The usual limit would be 140 (end of A): the drag goes on, over A
+        QVariantList result = timeline->suggestCrossfadeMove(cid, timeline->getItemTrackId(cid), 130, -1, 0);
+        REQUIRE(result.at(0).toInt() == 130);
+        REQUIRE(TimelineFunctions::requestSpacerEndOperation(timeline, cid, 200, 130, -1, -1, undo, redo, true, true));
+        overlapState(10);
+        REQUIRE(timeline->getClipPosition(c) == 190);
+        REQUIRE(timeline->getClipPosition(audioC) == 190);
+        undoStack->undo();
+        initialState();
+        REQUIRE(timeline->getClipPosition(c) == 260);
+        undoStack->redo();
+        overlapState(10);
+        REQUIRE(timeline->getClipPosition(c) == 190);
+    }
+
+    SECTION("A drag that takes a crossfade between its own clips along keeps it")
+    {
+        // C crossfaded with B (5 frames), then B and C dragged together over A
+        int c;
+        REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 300, c));
+        REQUIRE(timeline->requestItemResize(c, 20, true, true));
+        drag(c, 235);
+        REQUIRE(timeline->requestCrossfadeMove(c, true) == 1);
+        REQUIRE(timeline->getMixDuration(c) == 5);
+        Fun undo = []() { return true; };
+        Fun redo = []() { return true; };
+        int cid = TimelineFunctions::requestSpacerStartOperation(timeline, -1, 200, false, false, true).first;
+        REQUIRE(timeline->suggestCrossfadeMove(cid, timeline->getItemTrackId(cid), 130, -1, 0).at(0).toInt() == 130);
+        REQUIRE(TimelineFunctions::requestSpacerEndOperation(timeline, cid, 200, 130, -1, -1, undo, redo, true, true));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 100);
+        REQUIRE(timeline->getClipPlaytime(a) == 40);
+        REQUIRE(timeline->getClipPosition(b) == 130);
+        REQUIRE(timeline->getClipPlaytime(b) == 40);
+        REQUIRE(timeline->getClipIn(b) == inB);
+        REQUIRE(timeline->getMixDuration(b) == 10);
+        REQUIRE(timeline->getClipPosition(c) == 165);
+        REQUIRE(timeline->getClipPlaytime(c) == 20);
+        REQUIRE(timeline->getMixDuration(c) == 5);
+        REQUIRE(videoMixes() == 2);
+        undoStack->undo();
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(b) == 200);
+        REQUIRE(timeline->getClipPosition(c) == 235);
+        REQUIRE(timeline->getMixDuration(c) == 5);
+        REQUIRE(videoMixes() == 1);
+    }
+
+    SECTION("A drag to another track without overlaps: no crossfade, the fake track says where the clip goes")
+    {
+        int videoTrack2 = timeline->getTrackIndexFromPosition(3);
+        REQUIRE(timeline->isTrack(videoTrack2));
+        REQUIRE_FALSE(timeline->isAudioTrack(videoTrack2));
+        QVariantList result = timeline->suggestCrossfadeMove(b, videoTrack2, 200, -1, 0);
+        REQUIRE(result.at(1).toInt() == videoTrack2);
+        // Nothing to crossfade: the controller ends with the usual move to the fake track (endFakeMoveUsual)
+        REQUIRE(timeline->requestCrossfadeMove(b, true) == -1);
+        REQUIRE(KdenliveTests::getClipPtr(timeline, b)->getFakeTrackId() == videoTrack2);
+        REQUIRE(timeline->getClipTrackId(b) == videoTrack);
+    }
+
+    SECTION("A drag to another track covering a clip there is refused")
+    {
+        int videoTrack2 = timeline->getTrackIndexFromPosition(3);
+        int c;
+        REQUIRE(timeline->requestClipInsertion(binId, videoTrack2, 190, c, true, false, false));
+        REQUIRE(timeline->requestItemResize(c, 60, true, true));
+        QVariantList result = timeline->suggestCrossfadeMove(b, videoTrack2, 200, -1, 0);
+        INFO("suggested track " << result.at(1).toInt() << " position " << result.at(0).toInt() << " fake track "
+                                << KdenliveTests::getClipPtr(timeline, b)->getFakeTrackId() << " real track " << timeline->getClipTrackId(b));
+        REQUIRE(timeline->getClipTrackId(b) == videoTrack);
+        REQUIRE(timeline->getClipPosition(b) == 200);
+        REQUIRE(timeline->requestCrossfadeMove(b, true) == -1);
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipTrackId(b) == videoTrack);
+    }
+
+    pCore->projectManager()->closeCurrentDocument(false, false);
+}
+
+TEST_CASE("Crossfade by trimming an edge over a clip", "[VegasCrossfade]")
+{
+    auto binModel = pCore->projectItemModel();
+    binModel->clean();
+    std::shared_ptr<DocUndoStack> undoStack = std::make_shared<DocUndoStack>(nullptr);
+
+    KdenliveDoc document(undoStack);
+    pCore->projectManager()->testSetDocument(&document);
+    QDateTime documentDate = QDateTime::currentDateTime();
+    KdenliveTests::updateTimeline(false, QString(), QString(), documentDate, 0);
+    auto timeline = document.getTimeline(document.uuid());
+    pCore->projectManager()->testSetActiveTimeline(timeline);
+    KdenliveSettings::setOverlapCrossfade(true);
+    KdenliveSettings::setGroupTrimPush(true);
+
+    int audioTrack = timeline->getTrackIndexFromPosition(1);
+    int videoTrack = timeline->getTrackIndexFromPosition(2);
+    int videoTrack2 = timeline->getTrackIndexFromPosition(3);
+
+    QString binId = KdenliveTests::createProducerWithSound(pCore->getProjectProfile(), binModel, 100);
+    QMap<int, QString> audioInfo;
+    audioInfo.insert(1, QStringLiteral("stream1"));
+    KdenliveTests::setAudioTargets(timeline, audioInfo);
+
+    // A: 100 to 140, B: 140 to 180 (touching), both from frame 10 of the 100 frames of material, video + audio
+    int a, b;
+    REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 100, a));
+    REQUIRE(timeline->requestItemResize(a, 90, false, true));
+    REQUIRE(timeline->requestItemResize(a, 40, true, true));
+    REQUIRE(timeline->requestClipMove(a, videoTrack, 100));
+    REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 140, b));
+    REQUIRE(timeline->requestItemResize(b, 90, false, true));
+    REQUIRE(timeline->requestItemResize(b, 40, true, true));
+    REQUIRE(timeline->requestClipMove(b, videoTrack, 140));
+    int audioA = timeline->getClipSplitPartner(a);
+    int audioB = timeline->getClipSplitPartner(b);
+    REQUIRE(audioA > -1);
+    REQUIRE(audioB > -1);
+    const int inA = timeline->getClipIn(a);
+    const int inB = timeline->getClipIn(b);
+    auto videoMixes = [&]() { return KdenliveTests::getTrackById_const(timeline, videoTrack)->mixCount(); };
+    auto audioMixes = [&]() { return KdenliveTests::getTrackById_const(timeline, audioTrack)->mixCount(); };
+
+    auto initialState = [&]() {
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 100);
+        REQUIRE(timeline->getClipPlaytime(a) == 40);
+        REQUIRE(timeline->getClipIn(a) == inA);
+        REQUIRE(timeline->getClipPosition(audioA) == 100);
+        REQUIRE(timeline->getClipPlaytime(audioA) == 40);
+        REQUIRE(timeline->getClipPosition(b) == 140);
+        REQUIRE(timeline->getClipPlaytime(b) == 40);
+        REQUIRE(timeline->getClipIn(b) == inB);
+        REQUIRE(timeline->getClipPosition(audioB) == 140);
+        REQUIRE(videoMixes() == 0);
+        REQUIRE(audioMixes() == 0);
+    };
+    // The end of A over the start of B (B as it was)
+    auto rightState = [&](int overlap) {
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 100);
+        REQUIRE(timeline->getClipPlaytime(a) == 40 + overlap);
+        REQUIRE(timeline->getClipIn(a) == inA);
+        REQUIRE(timeline->getClipPlaytime(audioA) == 40 + overlap);
+        REQUIRE(timeline->getClipPosition(b) == 140);
+        REQUIRE(timeline->getClipPlaytime(b) == 40);
+        REQUIRE(timeline->getClipIn(b) == inB);
+        REQUIRE(timeline->getClipPosition(audioB) == 140);
+        REQUIRE(timeline->getClipPlaytime(audioB) == 40);
+        REQUIRE(timeline->getMixDuration(b) == overlap);
+        REQUIRE(timeline->getMixDuration(audioB) == overlap);
+        REQUIRE(videoMixes() == 1);
+        REQUIRE(audioMixes() == 1);
+    };
+
+    initialState();
+
+    SECTION("Trimming the end of a clip over the next one creates a crossfade on video and audio, undo and redo")
+    {
+        timeline->crossfadeTrimBegin(a, true, false);
+        QVariantMap preview = timeline->crossfadeTrimPreview(50, 0);
+        REQUIRE(preview.value(QStringLiteral("duration")).toInt() == 50);
+        QVariantList overlaps = preview.value(QStringLiteral("overlaps")).toList();
+        REQUIRE(overlaps.size() == 2);
+        for (const auto &overlap : overlaps) {
+            REQUIRE(overlap.toMap().value(QStringLiteral("start")).toInt() == 140);
+            REQUIRE(overlap.toMap().value(QStringLiteral("length")).toInt() == 10);
+        }
+        REQUIRE(timeline->requestCrossfadeTrim());
+        rightState(10);
+        undoStack->undo();
+        initialState();
+        undoStack->redo();
+        rightState(10);
+    }
+
+    SECTION("Trimming the start of a clip over the previous one")
+    {
+        timeline->crossfadeTrimBegin(b, false, false);
+        QVariantMap preview = timeline->crossfadeTrimPreview(46, 0);
+        REQUIRE(preview.value(QStringLiteral("duration")).toInt() == 46);
+        QVariantList overlaps = preview.value(QStringLiteral("overlaps")).toList();
+        REQUIRE(overlaps.size() == 2);
+        REQUIRE(overlaps.first().toMap().value(QStringLiteral("start")).toInt() == 134);
+        REQUIRE(timeline->requestCrossfadeTrim());
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 100);
+        REQUIRE(timeline->getClipPlaytime(a) == 40);
+        REQUIRE(timeline->getClipIn(a) == inA);
+        REQUIRE(timeline->getClipPosition(b) == 134);
+        REQUIRE(timeline->getClipPlaytime(b) == 46);
+        REQUIRE(timeline->getClipIn(b) == inB - 6);
+        REQUIRE(timeline->getClipPosition(audioB) == 134);
+        REQUIRE(timeline->getMixDuration(b) == 6);
+        REQUIRE(timeline->getMixDuration(audioB) == 6);
+        undoStack->undo();
+        initialState();
+    }
+
+    SECTION("The crossfade never covers the clip in the way, nor goes past the material")
+    {
+        timeline->crossfadeTrimBegin(a, true, false);
+        // Material: A can end at 190 at most; B ends at 180
+        QVariantMap preview = timeline->crossfadeTrimPreview(100, 0);
+        REQUIRE(preview.value(QStringLiteral("duration")).toInt() == 79);
+        REQUIRE(timeline->requestCrossfadeTrim());
+        rightState(39);
+        undoStack->undo();
+        initialState();
+    }
+
+    SECTION("With room before the next clip, the normal trim")
+    {
+        REQUIRE(timeline->requestClipMove(b, videoTrack, 160));
+        timeline->crossfadeTrimBegin(a, true, false);
+        QVariantMap preview = timeline->crossfadeTrimPreview(55, 0);
+        REQUIRE(preview.value(QStringLiteral("overlaps")).toList().isEmpty());
+        REQUIRE_FALSE(timeline->requestCrossfadeTrim());
+        // Past it: the gap is filled and the rest crossfades
+        timeline->crossfadeTrimBegin(a, true, false);
+        preview = timeline->crossfadeTrimPreview(70, 0);
+        REQUIRE(preview.value(QStringLiteral("overlaps")).toList().size() == 2);
+        REQUIRE(timeline->requestCrossfadeTrim());
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(a) == 70);
+        REQUIRE(timeline->getClipPosition(b) == 160);
+        REQUIRE(timeline->getClipPlaytime(b) == 40);
+        REQUIRE(timeline->getMixDuration(b) == 10);
+        undoStack->undo();
+        REQUIRE(timeline->getClipPlaytime(a) == 40);
+        REQUIRE(videoMixes() == 0);
+    }
+
+    SECTION("A grouped clip that follows the edge crossfades with the clip in its way, the dragged one just grows")
+    {
+        // C on another video track, aligned with A and grouped with it, nothing after it
+        QString colorId = KdenliveTests::createProducer(pCore->getProjectProfile(), "red", binModel, 200);
+        int c;
+        REQUIRE(timeline->requestClipInsertion(colorId, videoTrack2, 100, c, true, false, false));
+        REQUIRE(timeline->requestItemResize(c, 40, true, true));
+        REQUIRE(timeline->requestClipsGroup({a, audioA, c}));
+        timeline->crossfadeTrimBegin(c, true, false);
+        QVariantMap preview = timeline->crossfadeTrimPreview(48, 0);
+        REQUIRE(preview.value(QStringLiteral("duration")).toInt() == 48);
+        REQUIRE(preview.value(QStringLiteral("overlaps")).toList().size() == 2);
+        REQUIRE(timeline->requestCrossfadeTrim());
+        REQUIRE(timeline->getClipPlaytime(c) == 48);
+        rightState(8);
+        undoStack->undo();
+        REQUIRE(timeline->getClipPlaytime(c) == 40);
+        initialState();
+    }
+
+    // A over B by 10 frames, by trimming its end
+    auto makeCrossfade = [&]() {
+        timeline->crossfadeTrimBegin(a, true, false);
+        REQUIRE(timeline->crossfadeTrimPreview(50, 0).value(QStringLiteral("pending")).toBool());
+        REQUIRE(timeline->requestCrossfadeTrim());
+        rightState(10);
+    };
+
+    SECTION("Trimming back an edge with a crossfade: the crossfade is the overlap, it goes away with it")
+    {
+        makeCrossfade();
+        timeline->crossfadeTrimBegin(a, true, false);
+        QVariantMap preview = timeline->crossfadeTrimPreview(45, 0);
+        REQUIRE(preview.value(QStringLiteral("pending")).toBool());
+        REQUIRE(preview.value(QStringLiteral("duration")).toInt() == 45);
+        REQUIRE(preview.value(QStringLiteral("overlaps")).toList().size() == 2);
+        REQUIRE(timeline->requestCrossfadeTrim());
+        rightState(5);
+        // Past the start of B: no crossfade, A ends where the edge is, B keeps its full length. The live trim of the
+        // drag keeps the crossfades, and is undone before the trim is applied
+        timeline->crossfadeTrimBegin(a, true, false);
+        REQUIRE(timeline->requestItemResize(a, 35, true, false, 0, false) > 0);
+        REQUIRE(videoMixes() == 1);
+        REQUIRE(audioMixes() == 1);
+        REQUIRE(timeline->requestItemResize(a, 45, true, false, 0, false) == 45);
+        rightState(5);
+        preview = timeline->crossfadeTrimPreview(35, 0);
+        REQUIRE(preview.value(QStringLiteral("pending")).toBool());
+        REQUIRE(preview.value(QStringLiteral("overlaps")).toList().isEmpty());
+        REQUIRE(timeline->requestCrossfadeTrim());
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(a) == 35);
+        REQUIRE(timeline->getClipPlaytime(audioA) == 35);
+        REQUIRE(timeline->getClipIn(a) == inA);
+        REQUIRE(timeline->getClipPosition(b) == 140);
+        REQUIRE(timeline->getClipPlaytime(b) == 40);
+        REQUIRE(timeline->getClipIn(b) == inB);
+        REQUIRE(timeline->getClipPosition(audioB) == 140);
+        REQUIRE(timeline->getClipPlaytime(audioB) == 40);
+        REQUIRE(videoMixes() == 0);
+        REQUIRE(audioMixes() == 0);
+        undoStack->undo();
+        rightState(5);
+        undoStack->undo();
+        rightState(10);
+        // Longer again
+        timeline->crossfadeTrimBegin(a, true, false);
+        REQUIRE(timeline->crossfadeTrimPreview(60, 0).value(QStringLiteral("pending")).toBool());
+        REQUIRE(timeline->requestCrossfadeTrim());
+        rightState(20);
+    }
+
+    SECTION("The start of the second clip of a crossfade moves the same way")
+    {
+        makeCrossfade();
+        timeline->crossfadeTrimBegin(b, false, false);
+        QVariantMap preview = timeline->crossfadeTrimPreview(37, 0);
+        REQUIRE(preview.value(QStringLiteral("pending")).toBool());
+        REQUIRE(timeline->requestCrossfadeTrim());
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(a) == 50);
+        REQUIRE(timeline->getClipPosition(b) == 143);
+        REQUIRE(timeline->getClipPlaytime(b) == 37);
+        REQUIRE(timeline->getClipIn(b) == inB + 3);
+        REQUIRE(timeline->getClipPosition(audioB) == 143);
+        REQUIRE(timeline->getMixDuration(b) == 7);
+        REQUIRE(timeline->getMixDuration(audioB) == 7);
+        // Past the end of A
+        timeline->crossfadeTrimBegin(b, false, false);
+        REQUIRE(timeline->crossfadeTrimPreview(25, 0).value(QStringLiteral("pending")).toBool());
+        REQUIRE(timeline->requestCrossfadeTrim());
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 100);
+        REQUIRE(timeline->getClipPlaytime(a) == 50);
+        REQUIRE(timeline->getClipIn(a) == inA);
+        REQUIRE(timeline->getClipPosition(b) == 155);
+        REQUIRE(timeline->getClipPlaytime(b) == 25);
+        REQUIRE(timeline->getClipPosition(audioB) == 155);
+        REQUIRE(videoMixes() == 0);
+        REQUIRE(audioMixes() == 0);
+        undoStack->undo();
+        undoStack->undo();
+        rightState(10);
+    }
+
+    SECTION("The right handle of the crossfade is the end of the first clip")
+    {
+        makeCrossfade();
+        REQUIRE(timeline->crossfadeTrimBeginMix(b, false) == 50);
+        // Handle dragged 7 frames to the left
+        QVariantMap preview = timeline->crossfadeTrimPreview(43, 0);
+        REQUIRE(preview.value(QStringLiteral("pending")).toBool());
+        REQUIRE(timeline->requestCrossfadeTrim());
+        rightState(3);
+        REQUIRE(timeline->crossfadeTrimBeginMix(b, false) == 43);
+        REQUIRE(timeline->crossfadeTrimPreview(30, 0).value(QStringLiteral("pending")).toBool());
+        REQUIRE(timeline->requestCrossfadeTrim());
+        REQUIRE(timeline->getClipPlaytime(a) == 30);
+        REQUIRE(timeline->getClipPlaytime(b) == 40);
+        REQUIRE(videoMixes() == 0);
+        REQUIRE(audioMixes() == 0);
+    }
+
+    SECTION("The transition chosen for the crossfade stays when its edge moves")
+    {
+        makeCrossfade();
+        auto videoTrackPtr = KdenliveTests::getTrackById_const(timeline, videoTrack);
+        timeline->switchComposition(b, QStringLiteral("wipe"));
+        REQUIRE(videoTrackPtr->getMixParams(b).first == QStringLiteral("wipe"));
+        timeline->crossfadeTrimBegin(a, true, false);
+        REQUIRE(timeline->crossfadeTrimPreview(45, 0).value(QStringLiteral("pending")).toBool());
+        REQUIRE(timeline->requestCrossfadeTrim());
+        rightState(5);
+        REQUIRE(videoTrackPtr->getMixParams(b).first == QStringLiteral("wipe"));
+    }
+
+    SECTION("Without the option, nothing crossfades")
+    {
+        KdenliveSettings::setOverlapCrossfade(false);
+        timeline->crossfadeTrimBegin(a, true, false);
+        REQUIRE(timeline->crossfadeTrimPreview(50, 0).value(QStringLiteral("overlaps")).toList().isEmpty());
+        REQUIRE_FALSE(timeline->requestCrossfadeTrim());
+        KdenliveSettings::setOverlapCrossfade(true);
+        initialState();
+    }
+
+    pCore->projectManager()->closeCurrentDocument(false, false);
+}
diff --git a/kdenlive-26.08.2/tests/vegasgrouptest.cpp b/kdenlive-26.08.2/tests/vegasgrouptest.cpp
new file mode 100644
index 0000000..052cc94
--- /dev/null
+++ b/kdenlive-26.08.2/tests/vegasgrouptest.cpp
@@ -0,0 +1,200 @@
+/*
+    Catavan: Ungroup takes only the picked clips out of their group (ungroupSelectedOnly)
+    SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+#include "catch.hpp"
+#include "test_utils.hpp"
+// test specific headers
+#include "core.h"
+#include "doc/docundostack.hpp"
+#include "doc/kdenlivedoc.h"
+#include "kdenlivesettings.h"
+
+using namespace fakeit;
+
+TEST_CASE("Remove clips from their group", "[VegasGroup]")
+{
+    auto binModel = pCore->projectItemModel();
+    binModel->clean();
+    std::shared_ptr<DocUndoStack> undoStack = std::make_shared<DocUndoStack>(nullptr);
+
+    KdenliveDoc document(undoStack);
+    pCore->projectManager()->testSetDocument(&document);
+    QDateTime documentDate = QDateTime::currentDateTime();
+    KdenliveTests::updateTimeline(false, QString(), QString(), documentDate, 0);
+    auto timeline = document.getTimeline(document.uuid());
+    pCore->projectManager()->testSetActiveTimeline(timeline);
+
+    int videoTrack = timeline->getTrackIndexFromPosition(2);
+
+    // Three clips with audio and video: a at 0, b at 100, c at 200
+    QString binId = KdenliveTests::createProducerWithSound(pCore->getProjectProfile(), binModel, 50);
+    QMap<int, QString> audioInfo;
+    audioInfo.insert(1, QStringLiteral("stream1"));
+    KdenliveTests::setAudioTargets(timeline, audioInfo);
+    int a, b, c;
+    REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 0, a));
+    REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 100, b));
+    REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 200, c));
+    int audioA = timeline->getClipSplitPartner(a);
+    int audioB = timeline->getClipSplitPartner(b);
+    int audioC = timeline->getClipSplitPartner(c);
+    REQUIRE(audioA > -1);
+    REQUIRE(audioB > -1);
+    REQUIRE(audioC > -1);
+    using Set = std::unordered_set<int>;
+    const Set pairA{a, audioA}, pairB{b, audioB}, pairC{c, audioC};
+    auto join = [](std::initializer_list<Set> sets) {
+        Set all;
+        for (const auto &s : sets) {
+            all.insert(s.begin(), s.end());
+        }
+        return all;
+    };
+    auto groupOf = [&](int id) { return timeline->getGroupElements(id); };
+
+    SECTION("A clip leaves a group of three with its audio, the two others stay grouped")
+    {
+        REQUIRE(timeline->requestClipsGroup({a, b, c}) > -1);
+        REQUIRE(groupOf(a) == join({pairA, pairB, pairC}));
+
+        REQUIRE(timeline->requestRemoveItemsFromGroups({b}));
+        auto removedState = [&]() {
+            REQUIRE(timeline->checkConsistency());
+            REQUIRE(groupOf(a) == join({pairA, pairC}));
+            REQUIRE(groupOf(c) == join({pairA, pairC}));
+            REQUIRE(groupOf(b) == pairB);
+            REQUIRE(groupOf(audioB) == pairB);
+        };
+        removedState();
+        undoStack->undo();
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(groupOf(b) == join({pairA, pairB, pairC}));
+        undoStack->redo();
+        removedState();
+
+        // Picking the audio part takes the same pair out
+        undoStack->undo();
+        REQUIRE(timeline->requestRemoveItemsFromGroups({audioB}));
+        removedState();
+
+        // A group left with one member is removed; the pairs stay
+        REQUIRE(timeline->requestRemoveItemsFromGroups({a}));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(groupOf(a) == pairA);
+        REQUIRE(groupOf(c) == pairC);
+        undoStack->undo();
+        removedState();
+    }
+
+    SECTION("Two clips leave at once")
+    {
+        REQUIRE(timeline->requestClipsGroup({a, b, c}) > -1);
+        REQUIRE(timeline->requestRemoveItemsFromGroups({a, c}));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(groupOf(a) == pairA);
+        REQUIRE(groupOf(b) == pairB);
+        REQUIRE(groupOf(c) == pairC);
+        undoStack->undo();
+        REQUIRE(groupOf(b) == join({pairA, pairB, pairC}));
+    }
+
+    SECTION("Nested groups: the clip leaves all of them")
+    {
+        REQUIRE(timeline->requestClipsGroup({a, b}) > -1);
+        REQUIRE(timeline->requestClipsGroup({a, c}) > -1);
+        REQUIRE(groupOf(c) == join({pairA, pairB, pairC}));
+        REQUIRE(timeline->requestRemoveItemsFromGroups({a}));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(groupOf(a) == pairA);
+        REQUIRE(groupOf(b) == join({pairB, pairC}));
+        undoStack->undo();
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(groupOf(a) == join({pairA, pairB, pairC}));
+        // The inner group {a, b} is back
+        undoStack->undo();
+        REQUIRE(groupOf(a) == join({pairA, pairB}));
+    }
+
+    SECTION("A clip alone with its audio: the pair is split, as the original Ungroup")
+    {
+        REQUIRE(timeline->requestRemoveItemsFromGroups({b}));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(groupOf(b) == Set{b});
+        REQUIRE(groupOf(audioB) == Set{audioB});
+        undoStack->undo();
+        REQUIRE(groupOf(b) == pairB);
+    }
+
+    SECTION("Nothing to do for a clip in no group")
+    {
+        REQUIRE(timeline->requestClipUngroup(b));
+        REQUIRE_FALSE(timeline->requestRemoveItemsFromGroups({b}));
+        REQUIRE(timeline->checkConsistency());
+    }
+
+    pCore->projectManager()->closeCurrentDocument(false, false);
+}
+
+TEST_CASE("Moving a grouped clip to another track keeps the other kind on its tracks", "[VegasGroup]")
+{
+    auto binModel = pCore->projectItemModel();
+    binModel->clean();
+    std::shared_ptr<DocUndoStack> undoStack = std::make_shared<DocUndoStack>(nullptr);
+
+    KdenliveDoc document(undoStack);
+    pCore->projectManager()->testSetDocument(&document);
+    QDateTime documentDate = QDateTime::currentDateTime();
+    KdenliveTests::updateTimeline(false, QString(), QString(), documentDate, 0);
+    auto timeline = document.getTimeline(document.uuid());
+    pCore->projectManager()->testSetActiveTimeline(timeline);
+
+    int video1 = timeline->getTrackIndexFromPosition(2);
+    int video2 = timeline->getTrackIndexFromPosition(3);
+    REQUIRE_FALSE(timeline->isAudioTrack(video1));
+    REQUIRE_FALSE(timeline->isAudioTrack(video2));
+    QString binId = KdenliveTests::createProducerWithSound(pCore->getProjectProfile(), binModel, 50);
+    QMap<int, QString> audioInfo;
+    audioInfo.insert(1, QStringLiteral("stream1"));
+    KdenliveTests::setAudioTargets(timeline, audioInfo);
+    int v;
+    REQUIRE(timeline->requestClipInsertion(binId, video2, 100, v));
+    int a = timeline->getClipSplitPartner(v);
+    REQUIRE(a > -1);
+    const int audioTrack = timeline->getClipTrackId(a);
+
+    SECTION("Video down one track: the audio stays (real move), undo")
+    {
+        KdenliveSettings::setGroupTracksIndependent(true);
+        REQUIRE(timeline->requestClipMove(v, video1, 120));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipTrackId(v) == video1);
+        REQUIRE(timeline->getClipPosition(v) == 120);
+        REQUIRE(timeline->getClipTrackId(a) == audioTrack);
+        REQUIRE(timeline->getClipPosition(a) == 120);
+        undoStack->undo();
+        REQUIRE(timeline->getClipTrackId(v) == video2);
+        REQUIRE(timeline->getClipTrackId(a) == audioTrack);
+    }
+
+    SECTION("Video down one track: the audio stays (fake move of a drag)")
+    {
+        KdenliveSettings::setGroupTracksIndependent(true);
+        REQUIRE(timeline->requestFakeClipMove(v, video1, 100, true, false, false));
+        REQUIRE(KdenliveTests::getClipPtr(timeline, v)->getFakeTrackId() == video1);
+        int audioFake = KdenliveTests::getClipPtr(timeline, a)->getFakeTrackId();
+        REQUIRE((audioFake == -1 || audioFake == audioTrack));
+    }
+
+    SECTION("Without the option, the audio mirrors the move (upstream)")
+    {
+        KdenliveSettings::setGroupTracksIndependent(false);
+        REQUIRE(timeline->requestClipMove(v, video1, 100));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipTrackId(v) == video1);
+        REQUIRE(timeline->getClipTrackId(a) != audioTrack);
+        KdenliveSettings::setGroupTracksIndependent(true);
+    }
+
+    pCore->projectManager()->closeCurrentDocument(false, false);
+}
diff --git a/kdenlive-26.08.2/tests/vegasrippletest.cpp b/kdenlive-26.08.2/tests/vegasrippletest.cpp
