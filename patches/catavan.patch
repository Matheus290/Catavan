+int ClipModel::pitchCompensationOf(Mlt::Properties &producer)
+{
+    if (producer.get_int("warp_pitch") == 0) {
+        return 0;
+    }
+    return qstrcmp(producer.get("warp_pitch_method"), "wsola") == 0 ? 2 : 1;
