+
+void ClipModel::setPitchCompensation(Mlt::Properties &producer, int mode)
+{
+    producer.set("warp_pitch", mode > 0 ? 1 : 0);
+    // warp_pitch_method is only written once WSOLA was used, so untouched clips stay as in upstream
+    if (mode == 2) {
+        producer.set("warp_pitch_method", "wsola");
+    } else if (producer.property_exists("warp_pitch_method")) {
+        producer.set("warp_pitch_method", "rubberband");
+    }
+}
