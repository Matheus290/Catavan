diff --git a/kdenlive-26.08.2/config-kdenlive.h.cmake b/kdenlive-26.08.2/config-kdenlive.h.cmake
index 5775d13..0eb0f33 100644
--- a/kdenlive-26.08.2/config-kdenlive.h.cmake
+++ b/kdenlive-26.08.2/config-kdenlive.h.cmake
@@ -3,6 +3,10 @@
 
 #define KDENLIVE_VERSION "@KDENLIVE_VERSION_STRING@"
 #define KDENLIVE_FULL_VERSION_STRING "@KDENLIVE_FULL_VERSION_STRING@"
+// Catavan: version of the fork (KDENLIVE_VERSION stays the Kdenlive base version)
+#define CATAVAN_VERSION "@CATAVAN_VERSION@"
+#define CATAVAN_APP_ID "@CATAVAN_APP_ID@"
+#define CATAVAN_REPOSITORY "@CATAVAN_REPOSITORY@"
 
 #define MLT_PREFIX "@MLT_PREFIX@"
 #define MLT_MIN_MAJOR_VERSION @MLT_MIN_MAJOR_VERSION@
diff --git a/kdenlive-26.08.2/data/CMakeLists.txt b/kdenlive-26.08.2/data/CMakeLists.txt
index a056e68..19fbe8c 100644
--- a/kdenlive-26.08.2/data/CMakeLists.txt
+++ b/kdenlive-26.08.2/data/CMakeLists.txt
@@ -27,13 +27,15 @@ install(FILES
 
   DESTINATION ${KDE_INSTALL_DATADIR}${DATA_INSTALL_PREFIX})
 
-install(FILES kdenlive.notifyrc DESTINATION ${KDE_INSTALL_KNOTIFYRCDIR})
+# Catavan: files installed under Catavan names, apart from an installed Kdenlive
+install(FILES kdenlive.notifyrc DESTINATION ${KDE_INSTALL_KNOTIFYRCDIR} RENAME catavan.notifyrc)
 
 install(FILES profiles.xml DESTINATION ${KDE_INSTALL_DATADIR}${DATA_INSTALL_PREFIX}/export)
-install(FILES org.kde.kdenlive.appdata.xml DESTINATION ${KDE_INSTALL_METAINFODIR})
-install(FILES org.kde.kdenlive.desktop DESTINATION ${KDE_INSTALL_APPDIR})
+install(FILES org.kde.kdenlive.appdata.xml DESTINATION ${KDE_INSTALL_METAINFODIR} RENAME ${CATAVAN_APP_ID}.metainfo.xml)
+install(FILES org.kde.kdenlive.desktop DESTINATION ${KDE_INSTALL_APPDIR} RENAME ${CATAVAN_APP_ID}.desktop)
 
 find_package(SharedMimeInfo REQUIRED)
-install(FILES org.kde.kdenlive.xml westley.xml DESTINATION ${KDE_INSTALL_MIMEDIR})
+install(FILES org.kde.kdenlive.xml DESTINATION ${KDE_INSTALL_MIMEDIR} RENAME ${CATAVAN_APP_ID}.xml)
+install(FILES westley.xml DESTINATION ${KDE_INSTALL_MIMEDIR} RENAME ${CATAVAN_APP_ID}-westley.xml)
 update_xdg_mimetypes(${KDE_INSTALL_MIMEDIR})
 
