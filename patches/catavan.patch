+/*
+    Catavan: clips with the same speed on a track share one timewarp producer (shareSpeedProducers)
+    SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+#include "catch.hpp"
+#include "test_utils.hpp"
+// test specific headers
+#include "core.h"
+#include "doc/docundostack.hpp"
+#include "doc/kdenlivedoc.h"
+#include "kdenlivesettings.h"
+
+using namespace fakeit;
+
+TEST_CASE("Clips with the same speed share a producer", "[VegasSpeed]")
+{
+    auto binModel = pCore->projectItemModel();
+    binModel->clean();
+    std::shared_ptr<DocUndoStack> undoStack = std::make_shared<DocUndoStack>(nullptr);
+
+    KdenliveDoc document(undoStack);
+    pCore->projectManager()->testSetDocument(&document);
+    QDateTime documentDate = QDateTime::currentDateTime();
+    KdenliveTests::updateTimeline(false, QString(), QString(), documentDate, 0);
+    auto timeline = document.getTimeline(document.uuid());
+    pCore->projectManager()->testSetActiveTimeline(timeline);
+    KdenliveSettings::setShareSpeedProducers(true);
+
+    int videoTrack = timeline->getTrackIndexFromPosition(2);
+    int videoTrack2 = timeline->getTrackIndexFromPosition(3);
+    QString binId = KdenliveTests::createProducerWithSound(pCore->getProjectProfile(), binModel, 300);
+    QMap<int, QString> audioInfo;
+    audioInfo.insert(1, QStringLiteral("stream1"));
+    KdenliveTests::setAudioTargets(timeline, audioInfo);
+
+    // Three pieces of the same clip, at 1.1x (requestClipTimeWarp takes a percentage)
+    int a, b, c;
+    REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 0, a));
+    REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 400, b));
+    REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 800, c));
+    for (int cid : {a, b, c}) {
+        REQUIRE(timeline->requestClipTimeWarp(cid, 110., 0, true));
+    }
+    int audioA = timeline->getClipSplitPartner(a);
+    int audioB = timeline->getClipSplitPartner(b);
+    int audioC = timeline->getClipSplitPartner(c);
+    REQUIRE(audioA > -1);
+    REQUIRE(timeline->checkConsistency());
+    REQUIRE(qFuzzyCompare(timeline->getClipSpeed(a), 1.1));
+    REQUIRE(qFuzzyCompare(timeline->getClipSpeed(audioA), 1.1));
+    auto master = [&](int cid) { return KdenliveTests::getClipMasterProducer(timeline, cid); };
+
+    SECTION("One producer for the video pieces, one for the audio pieces")
+    {
+        REQUIRE(master(a) == master(b));
+        REQUIRE(master(b) == master(c));
+        REQUIRE(master(audioA) == master(audioB));
+        REQUIRE(master(audioB) == master(audioC));
+        REQUIRE(master(a) != master(audioA));
+    }
+
+    SECTION("Deleting pieces keeps the producer of the others, undo shares again")
+    {
+        REQUIRE(timeline->requestItemDeletion(a));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(master(b) == master(c));
+        REQUIRE(timeline->requestItemDeletion(b));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(c) > 0);
+        undoStack->undo();
+        undoStack->undo();
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(master(a) == master(c));
+        REQUIRE(master(b) == master(c));
+        REQUIRE(master(audioA) == master(audioC));
+    }
+
+    SECTION("Another pitch setting gets its own producer, undo shares again")
+    {
+        REQUIRE(timeline->requestClipTimeWarp(b, 110., 2, false));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(KdenliveTests::getClipPtr(timeline, b)->getPitchCompensation() == 2);
+        REQUIRE(KdenliveTests::getClipPtr(timeline, a)->getPitchCompensation() == 0);
+        REQUIRE(KdenliveTests::getClipPtr(timeline, c)->getPitchCompensation() == 0);
+        REQUIRE(master(b) != master(a));
+        REQUIRE(master(a) == master(c));
+        undoStack->undo();
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(KdenliveTests::getClipPtr(timeline, b)->getPitchCompensation() == 0);
+        REQUIRE(master(b) == master(a));
+    }
+
+    SECTION("A piece moved to another track gets the producer of that track")
+    {
+        REQUIRE(timeline->requestClipMove(c, videoTrack2, 800));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipTrackId(c) == videoTrack2);
+        REQUIRE(master(c) != master(a));
+        REQUIRE(master(a) == master(b));
+        undoStack->undo();
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(master(c) == master(a));
+    }
+
+    SECTION("Without the option, a producer per clip")
+    {
+        KdenliveSettings::setShareSpeedProducers(false);
+        int d;
+        REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 1200, d));
+        REQUIRE(timeline->requestClipTimeWarp(d, 110., 0, true));
+        REQUIRE(master(d) != master(a));
+        KdenliveSettings::setShareSpeedProducers(true);
+    }
+
+    pCore->projectManager()->closeCurrentDocument(false, false);
+}
