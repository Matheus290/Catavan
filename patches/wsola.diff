+
+bool TimelineController::rippleDeleteSelection()
+{
+    const auto sel = m_model->getCurrentSelection();
+    int start = -1;
+    int end = -1;
+    for (int id : sel) {
+        if (!m_model->isClip(id) && !m_model->isComposition(id)) {
+            continue;
+        }
+        if (m_model->trackIsLocked(m_model->getItemTrackId(id))) {
+            Q_EMIT m_model->flashLock(m_model->getItemTrackId(id));
+            return true;
+        }
+        int pos = m_model->getItemPosition(id);
+        start = start < 0 ? pos : qMin(start, pos);
+        end = qMax(end, pos + m_model->getItemPlaytime(id));
+    }
+    if (start < 0) {
+        return false;
+    }
+    Fun undo = []() { return true; };
+    Fun redo = []() { return true; };
+    int moved = TimelineFunctions::rippleDelete(m_model, sel, KdenliveSettings::autoRippleMarkers(), undo, redo);
+    if (moved == INT_MIN) {
+        undo();
+        pCore->displayMessage(i18n("Cannot delete the selection"), ErrorMessage, 500);
+        return true;
+    }
+    pCore->pushUndo(undo, redo, i18n("Ripple delete"));
+    return true;
+}
+
+int TimelineController::insertDroppedClipPushing(int previewId, const QString &binId, int tid, int position)
+{
+    if (!m_model->isClip(previewId)) {
+        return -1;
+    }
+    // Duration and tracks of the dropped clip (with its audio/video part), from the drag preview
+    const int duration = m_model->getClipPlaytime(previewId);
+    QVector<int> tracks;
+    const int previewTrack = m_model->getClipTrackId(previewId);
+    const int trackCount = m_model->getTracksCount();
+    for (int id : m_model->getGroupElements(previewId)) {
+        if (m_model->isClip(id)) {
+            // The preview may sit on another track than the drop target, keep the same layout
+            int index = m_model->getTrackPosition(m_model->getClipTrackId(id)) - m_model->getTrackPosition(previewTrack) + m_model->getTrackPosition(tid);
+            if (index >= 0 && index < trackCount) {
+                tracks << m_model->getTrackIndexFromPosition(index);
+            }
+        }
+    }
+    m_model->requestItemDeletion(previewId, false);
+    Fun undo = []() { return true; };
+    Fun redo = []() { return true; };
+    const bool ripple = autoRippleActive();
+    int id = -1;
+    if (!TimelineFunctions::insertClipPushing(m_model, binId, tid, position, duration, tracks, ripple, ripple && KdenliveSettings::autoRippleMarkers(), id,
+                                              undo, redo)) {
+        undo();
+        pCore->displayMessage(i18n("Cannot insert the clip"), ErrorMessage, 500);
+        return -1;
+    }
+    pCore->pushUndo(undo, redo, i18n("Insert clip"));
+    return id;
+}
+
+int TimelineController::rippleTrimPreview(int clipId, int size, bool right)
+{
+    if (!m_model->isClip(clipId)) {
+        return -1;
+    }
+    if (m_rippleTrimClip != clipId) {
+        m_rippleTrimClip = clipId;
+        m_rippleTrimUndo = []() { return true; };
+    }
+    // The undo of every preview step is accumulated, rippleTrimEnd uses it to restore the original state
+    Fun redo = []() { return true; };
+    Fun undo = []() { return true; };
+    if (!TimelineFunctions::rippleResize(m_model, clipId, size, right, KdenliveSettings::autoRippleMarkers(), undo, redo)) {
+        undo();
+        return -1;
+    }
+    Fun previous = m_rippleTrimUndo;
+    m_rippleTrimUndo = [undo, previous]() { return undo() && previous(); };
+    return m_model->getClipPlaytime(clipId);
+}
+
+void TimelineController::rippleTrimEnd(int clipId, bool right)
+{
+    if (m_rippleTrimClip != clipId || !m_model->isClip(clipId)) {
+        m_rippleTrimClip = -1;
+        return;
+    }
+    const int finalSize = m_model->getClipPlaytime(clipId);
+    m_rippleTrimUndo();
+    m_rippleTrimUndo = []() { return true; };
+    m_rippleTrimClip = -1;
+    Fun undo = []() { return true; };
+    Fun redo = []() { return true; };
+    if (TimelineFunctions::rippleResize(m_model, clipId, finalSize, right, KdenliveSettings::autoRippleMarkers(), undo, redo)) {
+        pCore->pushUndo(undo, redo, i18n("Ripple trim"));
+    } else {
+        undo();
+        pCore->displayMessage(i18n("Cannot resize the clip"), ErrorMessage, 500);
+    }
+}
