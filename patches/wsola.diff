+bool TimelineFunctions::rippleMoveItems(const std::shared_ptr<TimelineItemModel> &timeline, const std::unordered_set<int> &items, int delta, int floor,
+                                        Fun &undo, Fun &redo)
+{
+    if (delta == 0 || items.empty()) {
+        return true;
+    }
+    // Moving a clip alone breaks its mixes: they come out first and go back after the move
+    std::vector<RippleMix> mixes;
+    if (!removeRippleMixes(timeline, items, mixes, undo, redo)) {
+        return false;
+    }
+    // Moved items of each track, by position
+    std::map<int, std::vector<std::pair<int, int>>> perTrack;
+    for (int id : items) {
+        if (!timeline->isClip(id) && !timeline->isComposition(id)) {
+            continue;
+        }
+        int tid = timeline->getItemTrackId(id);
+        if (tid < 0 || timeline->getTrackById_const(tid)->isLocked()) {
+            continue;
+        }
+        perTrack[tid].push_back({timeline->getItemPosition(id), id});
+    }
+    for (auto &entry : perTrack) {
+        auto &list = entry.second;
+        std::sort(list.begin(), list.end());
+        int shift = delta;
+        if (delta < 0) {
+            int firstStart = list.front().first;
+            int back = -delta;
+            // Free space before the first moved item of the track
+            auto track = timeline->getTrackById_const(entry.first);
+            int gap = 0;
+            if (firstStart > 0 && track->isBlankAt(firstStart - 1)) {
+                gap = firstStart - track->getBlankStart(firstStart - 1);
+            }
+            back = qMin(back, gap);
+            if (floor > -1) {
+                back = qMin(back, qMax(0, firstStart - floor));
+            }
+            shift = -back;
+        }
+        if (shift == 0) {
+            continue;
+        }
+        // Move in the direction of the move so the items of a track never collide
+        if (shift > 0) {
+            std::reverse(list.begin(), list.end());
+        }
+        for (const auto &item : list) {
+            int id = item.second;
+            bool ok;
+            if (timeline->isClip(id)) {
+                ok = timeline->requestClipMove(id, entry.first, item.first + shift, false, true, true, true, undo, redo) == TimelineModel::MoveSuccess;
+            } else {
+                ok = timeline->requestCompositionMove(id, entry.first, timeline->m_allCompositions[id]->getForcedTrack(), item.first + shift, true, true,
+                                                      undo, redo);
+            }
+            if (!ok) {
+                return false;
+            }
+        }
+    }
+    restoreRippleMixes(timeline, mixes, undo, redo);
+    return true;
+}
+
+bool TimelineFunctions::removeRippleMixes(const std::shared_ptr<TimelineItemModel> &timeline, const std::unordered_set<int> &items,
+                                          std::vector<RippleMix> &mixes, Fun &undo, Fun &redo)
+{
+    std::unordered_set<int> seconds;
+    std::vector<RippleMix> found;
+    auto add = [&](int firstId, int secondId) {
+        if (firstId < 0 || secondId < 0 || seconds.count(secondId) > 0) {
+            return;
+        }
+        seconds.insert(secondId);
+        const std::shared_ptr<ClipModel> &second = timeline->m_allClips[secondId];
+        int afterCut = second->getMixCutPosition();
+        found.push_back({firstId, secondId, afterCut, second->getMixDuration() - afterCut,
+                         timeline->getTrackById(second->getCurrentTrackId())->getMixParams(secondId)});
+    };
+    for (int id : items) {
+        if (!timeline->isClip(id)) {
+            continue;
+        }
+        int tid = timeline->getClipTrackId(id);
+        if (tid < 0 || timeline->getTrackById_const(tid)->isLocked()) {
+            continue;
+        }
+        std::pair<MixInfo, MixInfo> mixData = timeline->getTrackById_const(tid)->getMixInfo(id);
+        add(mixData.first.firstClipId, mixData.first.secondClipId);
+        add(mixData.second.firstClipId, mixData.second.secondClipId);
+    }
+    for (const RippleMix &mix : found) {
+        if (!timeline->getTrackById(timeline->getClipTrackId(mix.secondId))->requestRemoveMix({mix.firstId, mix.secondId}, undo, redo)) {
+            return false;
+        }
+        mixes.push_back(mix);
+    }
+    return true;
+}
+
+void TimelineFunctions::restoreRippleMixes(const std::shared_ptr<TimelineItemModel> &timeline, const std::vector<RippleMix> &mixes, Fun &undo, Fun &redo)
+{
+    for (const RippleMix &mix : mixes) {
+        if (!timeline->isClip(mix.firstId) || !timeline->isClip(mix.secondId)) {
+            continue;
+        }
+        int tid = timeline->getClipTrackId(mix.secondId);
+        int cut = timeline->getClipPosition(mix.secondId);
+        if (tid < 0 || timeline->getClipTrackId(mix.firstId) != tid || timeline->getClipPosition(mix.firstId) + timeline->getClipPlaytime(mix.firstId) != cut) {
+            continue;
+        }
+        auto track = timeline->getTrackById(tid);
+        // Each side of the cut fits in what the ripple left of the other clip (up to its other mix), one frame kept
+        std::pair<MixInfo, MixInfo> firstMixes = track->getMixInfo(mix.firstId);
+        std::pair<MixInfo, MixInfo> secondMixes = track->getMixInfo(mix.secondId);
+        int firstFree = cut - (firstMixes.first.firstClipId > -1 ? firstMixes.first.firstClipInOut.second : timeline->getClipPosition(mix.firstId));
+        int secondEnd = secondMixes.second.secondClipId > -1 ? secondMixes.second.secondClipInOut.first : cut + timeline->getClipPlaytime(mix.secondId);
+        int afterCut = qMax(0, qMin(mix.afterCut, secondEnd - cut - 1));
+        int beforeCut = qMax(0, qMin(mix.beforeCut, firstFree - 1));
+        if (afterCut + beforeCut < 2) {
+            continue;
+        }
+        const QString mixId = track->isAudioTrack() ? QStringLiteral("mix") : QStringLiteral("luma");
+        Fun local_undo = []() { return true; };
+        Fun local_redo = []() { return true; };
+        // On failure (no material left to extend a clip over the cut) it reverts itself and the clips stay cut
+        if (!timeline->requestClipMix(mixId, {mix.firstId, mix.secondId}, {afterCut, beforeCut}, tid, cut, true, true, true, local_undo, local_redo,
+                                      false)) {
+            continue;
+        }
+        if (!track->isAudioTrack() && !mix.params.first.isEmpty()) {
+            track->setMixAsset(mix.secondId, mix.params.first, mix.params.second, local_undo, local_redo);
+        }
+        UPDATE_UNDO_REDO_NOLOCK(local_redo, local_undo, undo, redo);
+    }
+}
+
+int TimelineFunctions::rippleMinPlaytime(const std::shared_ptr<TimelineItemModel> &timeline, int itemId)
+{
+    int tid = timeline->getItemTrackId(itemId);
+    if (!timeline->isClip(itemId) || tid < 0) {
+        return 1;
+    }
+    int minimum = 1;
+    std::pair<MixInfo, MixInfo> mixData = timeline->getTrackById_const(tid)->getMixInfo(itemId);
+    if (mixData.first.firstClipId > -1) {
+        minimum += timeline->m_allClips[itemId]->getMixDuration();
+    }
+    if (mixData.second.secondClipId > -1) {
+        minimum += timeline->m_allClips[mixData.second.secondClipId]->getMixDuration();
+    }
+    return minimum;
+}
+
+int TimelineFunctions::rippleDelete(const std::shared_ptr<TimelineItemModel> &timeline, const std::unordered_set<int> &items, bool moveGuides, Fun &undo,
+                                    Fun &redo)
+{
+    int start = -1;
+    int end = -1;
+    for (int id : items) {
+        if (!timeline->isClip(id) && !timeline->isComposition(id)) {
+            continue;
+        }
+        int pos = timeline->getItemPosition(id);
+        start = start < 0 ? pos : qMin(start, pos);
+        end = qMax(end, pos + timeline->getItemPlaytime(id));
+    }
+    if (start < 0) {
+        return INT_MIN;
+    }
+    timeline->requestClearSelection();
+    for (int id : items) {
+        // Deleting an item deletes its group, so check it still exists
+        if (timeline->isItem(id) && !timeline->requestItemDeletion(id, undo, redo)) {
+            return INT_MIN;
+        }
+    }
+    // What starts after the deleted start moves back by the deleted duration (each track as far as it can, not before
+    // that start, so clips reaching it align there)
+    std::unordered_set<int> following;
+    for (const auto &track : timeline->m_allTracks) {
+        if (track->isLocked()) {
+            continue;
+        }
+        for (int id : timeline->getItemsInRange(track->getId(), start, -1, true)) {
+            if (timeline->getItemPosition(id) >= start) {
+                following.insert(id);
+            }
+        }
+    }
+    const int delta = start - end;
+    if (moveGuides) {
+        timeline->getGuideModel()->rippleMarkers(end, delta, undo, redo);
+    }
+    return rippleMoveItems(timeline, following, delta, start, undo, redo) ? delta : INT_MIN;
+}
+
+bool TimelineFunctions::rippleResize(const std::shared_ptr<TimelineItemModel> &timeline, int itemId, int size, bool right, bool moveGuides, Fun &undo,
+                                     Fun &redo)
+{
+    if (!timeline->isClip(itemId)) {
+        return false;
+    }
+    const int start = timeline->getItemPosition(itemId);
+    const int playtime = timeline->getItemPlaytime(itemId);
+    const int end = start + playtime;
+    const int in = timeline->getClipIn(itemId);
+    const int maxDuration = timeline->m_allClips[itemId]->getMaxDuration();
+    int delta = size - playtime;
+    if (maxDuration > 0) {
+        // Limits of the source media: after the out point on the right, before the in point on the left
+        delta = qMin(delta, right ? maxDuration - in - playtime : in);
+    }
+    // The crossfades stay whole (the one on the trimmed edge moves with it), with one frame of the clip between them
+    delta = qMax(delta, rippleMinPlaytime(timeline, itemId) - playtime);
+    if (delta == 0) {
+        return true;
+    }
+    // Parts: the clip and the items of its group sharing the trimmed edge (audio/video parts, aligned clips), each one
+    // within its own material. Pushed: grouped clips whose edge is reached when shrinking, or when growing the right edge
+    // (then each one within its own material).
+    struct Part
+    {
+        int id;
+        int delta;
+    };
+    std::vector<Part> parts = {{itemId, delta}};
+    std::vector<Part> pushed;
+    std::unordered_set<int> partIds = {itemId};
+    if (timeline->m_groups->isInGroup(itemId)) {
+        const bool push = KdenliveSettings::groupTrimPush();
+        for (int id : timeline->m_groups->getLeaves(timeline->m_groups->getRootId(itemId))) {
+            if (id == itemId || !timeline->isClip(id) || timeline->getTrackById_const(timeline->getItemTrackId(id))->isLocked()) {
+                continue;
+            }
+            int s = timeline->getItemPosition(id);
+            int e = s + timeline->getItemPlaytime(id);
+            int partMax = timeline->m_allClips[id]->getMaxDuration();
+            if (right ? e == end : s == start) {
+                int d = delta;
+                if (d > 0 && partMax > 0) {
+                    int partIn = timeline->getClipIn(id);
+                    d = qMin(d, right ? partMax - partIn - (e - s) : partIn);
+                }
+                d = qMax(d, rippleMinPlaytime(timeline, id) - (e - s));
+                if (d != 0 && (d > 0) == (delta > 0)) {
+                    parts.push_back({id, d});
+                }
+                partIds.insert(id);
+            } else if (push && delta < 0) {
+                if (right && e > end + delta && e < end && s < end + delta) {
+                    // Its right edge is reached: trimmed to the new end
+                    pushed.push_back({id, end + delta - e});
+                } else if (!right && s > start && s <= start - delta && e > start - delta) {
+                    // Its left edge is reached: trimmed to the new edge
+                    pushed.push_back({id, s - (start - delta)});
+                }
+            } else if (push && delta > 0 && right && e > end && e < end + delta && s < end) {
+                // Its right edge is reached when growing: it follows up to the new end (not moved by the ripple)
+                int d = end + delta - e;
+                if (partMax > 0) {
+                    d = qMin(d, partMax - timeline->getClipIn(id) - (e - s));
+                }
+                if (d > 0) {
+                    pushed.push_back({id, d});
+                }
+                partIds.insert(id);
+            }
+        }
+    }
+    // What follows the edge (computed before any change), group members included
+    std::unordered_set<int> following;
+    for (const auto &track : timeline->m_allTracks) {
+        if (track->isLocked()) {
+            continue;
+        }
+        for (int id : timeline->getItemsInRange(track->getId(), right ? end : start, -1, true)) {
+            if (partIds.count(id) > 0) {
+                continue;
+            }
+            int s = timeline->getItemPosition(id);
+            int e = s + timeline->getItemPlaytime(id);
+            if (right ? e > end : s >= start) {
+                following.insert(id);
+            }
+        }
+    }
+    // The clip keeps its start: its end moves, and for the left edge the content slips (the in point moves)
+    auto resizeParts = [&]() {
+        for (const Part &p : parts) {
+            // Growing from the left, the content slips first (earlier in point) so the end never passes the material;
+            // shrinking, the end comes first
+            if (!right && p.delta > 0 && !timeline->requestClipSlip(p.id, p.delta, true, undo, redo)) {
+                return false;
+            }
+            int newSize = timeline->getItemPlaytime(p.id) + p.delta;
+            if (!timeline->requestItemResize(p.id, newSize, true, true, undo, redo)) {
+                return false;
+            }
+            if (!right && p.delta < 0 && !timeline->requestClipSlip(p.id, p.delta, true, undo, redo)) {
+                return false;
+            }
+        }
+        return true;
+    };
+    auto trimPushed = [&]() {
+        for (const Part &p : pushed) {
+            int newSize = timeline->getItemPlaytime(p.id) + p.delta;
+            if (newSize >= 1 && !timeline->requestItemResize(p.id, newSize, right, true, undo, redo)) {
+                return false;
+            }
+        }
+        return true;
+    };
+    auto moveGuidesBy = [&](int from, int d) {
+        if (!moveGuides) {
+            return true;
+        }
+        return timeline->getGuideModel()->rippleMarkers(from, d, undo, redo);
+    };
+    // The crossfades of everything that changes come out first (resizing or moving one clip of a mix leaves the mix
+    // where it was) and go back at the end: a crossfade on the trimmed edge moves with it
+    std::unordered_set<int> changed = following;
+    changed.insert(partIds.begin(), partIds.end());
+    for (const Part &p : pushed) {
+        changed.insert(p.id);
+    }
+    std::vector<RippleMix> mixes;
+    if (!removeRippleMixes(timeline, changed, mixes, undo, redo)) {
+        return false;
+    }
+    bool ok;
+    if (delta > 0) {
+        // Make room, then extend the clips (revealing earlier content for the left edge)
+        ok = rippleMoveItems(timeline, following, delta, -1, undo, redo) && moveGuidesBy(right ? end : start, delta) && resizeParts() && trimPushed();
+    } else if (!resizeParts() || !trimPushed()) {
+        ok = false;
+    } else if (right) {
+        ok = rippleMoveItems(timeline, following, delta, -1, undo, redo) && moveGuidesBy(end, delta);
+    } else {
+        // Left edge: what starts after the clip start moves back, not before that start (clips reaching it align there)
+        ok = rippleMoveItems(timeline, following, delta, start, undo, redo) && moveGuidesBy(start - delta, delta);
+    }
+    if (ok) {
+        restoreRippleMixes(timeline, mixes, undo, redo);
+    }
+    return ok;
+}
+
+bool TimelineFunctions::insertClipPushing(const std::shared_ptr<TimelineItemModel> &timeline, const QString &binId, int tid, int position, int duration,
+                                          QVector<int> tracks, bool allTracks, bool moveGuides, int &id, Fun &undo, Fun &redo)
+{
+    if (!tracks.contains(tid)) {
+        tracks << tid;
+    }
+    // A drop inside a clip goes after that clip
+    int pos = qMax(0, position);
+    for (int i = 0; i < 50; i++) {
+        int newPos = pos;
+        for (int t : std::as_const(tracks)) {
+            int cid = timeline->getClipByPosition(t, newPos);
+            if (cid > -1 && timeline->getClipPosition(cid) < newPos) {
+                newPos = timeline->getClipPosition(cid) + timeline->getClipPlaytime(cid);
+            }
+        }
+        if (newPos == pos) {
+            break;
+        }
+        pos = newPos;
+    }
+    bool needRoom = false;
+    for (int t : std::as_const(tracks)) {
+        for (int item : timeline->getItemsInRange(t, pos, pos + duration)) {
+            if (timeline->isClip(item)) {
+                needRoom = true;
+            }
+        }
+    }
+    if (needRoom && rippleShift(timeline, pos, duration, allTracks ? QVector<int>() : tracks, moveGuides, undo, redo) == INT_MIN) {
+        return false;
+    }
+    return timeline->requestClipInsertion(binId, tid, pos, id, false, true, false, undo, redo);
+}
