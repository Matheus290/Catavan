+int TimelineFunctions::rippleShift(const std::shared_ptr<TimelineItemModel> &timeline, int fromPos, int delta, const QVector<int> &tracks, bool moveGuides,
+                                   Fun &undo, Fun &redo, int floor, const std::unordered_set<int> &excluded)
+{
+    std::unordered_set<int> items;
+    int maxBack = delta < 0 ? -delta : 0;
+    for (const auto &track : timeline->m_allTracks) {
+        int tid = track->getId();
+        if (track->isLocked() || (!tracks.isEmpty() && !tracks.contains(tid))) {
+            continue;
+        }
+        int firstStart = -1;
+        for (int id : timeline->getItemsInRange(tid, fromPos, -1, true)) {
+            int pos = timeline->getItemPosition(id);
+            if (pos < fromPos || excluded.count(id) > 0) {
+                // Item crossing fromPos: it stays
+                continue;
+            }
+            items.insert(id);
+            if (timeline->isClip(id) && (firstStart < 0 || pos < firstStart)) {
+                firstStart = pos;
+            }
+        }
+        if (delta < 0 && firstStart > -1) {
+            // Free space before the first moved clip of this track
+            int gap = 0;
+            if (firstStart > 0 && track->isBlankAt(firstStart - 1)) {
+                gap = firstStart - track->getBlankStart(firstStart - 1);
+            }
+            maxBack = qMin(maxBack, gap);
+            if (floor > -1) {
+                maxBack = qMin(maxBack, qMax(0, firstStart - floor));
+            }
+        }
+    }
+    if (delta < 0) {
+        delta = -maxBack;
+    }
+    if (delta == 0) {
+        return 0;
+    }
+    if (moveGuides) {
+        // Moving back, the markers between the floor and the end of the removed span stay
+        int guidesFrom = delta < 0 && floor > -1 ? qMax(fromPos, floor - delta) : fromPos;
+        if (!timeline->getGuideModel()->rippleMarkers(guidesFrom, delta, undo, redo)) {
+            return INT_MIN;
+        }
+    }
+    if (items.empty()) {
+        return delta;
+    }
+    timeline->requestClearSelection();
+    timeline->requestSetSelection(items);
+    bool result = true;
+    int itemId = *(items.begin());
+    int targetTrackId = timeline->getItemTrackId(itemId);
+    int targetPos = timeline->getItemPosition(itemId) + delta;
+    if (timeline->m_groups->isInGroup(itemId)) {
+        result = timeline->requestGroupMove(itemId, timeline->m_groups->getRootId(itemId), 0, delta, true, true, undo, redo, true, true, true, tracks);
+    } else if (timeline->isClip(itemId)) {
+        result = timeline->requestClipMove(itemId, targetTrackId, targetPos, true, true, true, true, undo, redo) == TimelineModel::MoveSuccess;
+    } else if (timeline->isComposition(itemId)) {
+        result = timeline->requestCompositionMove(itemId, targetTrackId, timeline->m_allCompositions[itemId]->getForcedTrack(), targetPos, true, true, undo,
+                                                  redo);
+    }
+    timeline->requestClearSelection();
+    return result ? delta : INT_MIN;
+}
