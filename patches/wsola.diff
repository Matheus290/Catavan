+                }
+                overlap = qMin(target, limit) - neighbourStart;
+            } else if (!right && (mixData.second.secondClipId == -1 || mixData.second.secondClipId == item.id)) {
+                int limit = neighbourStart + 1;
+                if (mixData.first.firstClipId > -1) {
+                    limit = qMax(limit, mixData.first.firstClipInOut.second);
+                }
+                overlap = neighbourEnd - qMax(target, limit);
+            }
+        }
+        if (overlap < 2) {
+            // A mix needs a frame on each side of the cut
+            item.target = right ? neighbourStart : neighbourEnd;
+            continue;
+        }
+        item.target = right ? neighbourStart + overlap : neighbourEnd - overlap;
+        item.neighbourId = neighbour;
+        item.overlap = overlap;
+        pending = true;
+        overlaps << QVariant(QVariantMap{{QStringLiteral("trackId"), item.trackId},
+                                         {QStringLiteral("start"), right ? neighbourStart : neighbourEnd - overlap},
+                                         {QStringLiteral("length"), overlap}});
+    }
+    if (!pending) {
+        return result;
+    }
+    const CrossfadeTrimItem &dragged = trim.items.front();
+    if (dragged.target > -1) {
+        result[QStringLiteral("duration")] = right ? dragged.target - dragged.start : dragged.end - dragged.target;
+    }
+    result[QStringLiteral("overlaps")] = overlaps;
+    result[QStringLiteral("pending")] = true;
+    if (right) {
+        // How to draw the clips that follow the edge: each one ends at the clip in the way or at the edge, and the clip
+        // it crossfaded with at the press shows the overlap left as its mix
+        QVariantList items;
+        for (const auto &item : trim.items) {
+            if (item.target == -1 || !isClip(item.id)) {
+                continue;
+            }
+            items << QVariant(QVariantMap{{QStringLiteral("id"), item.id},
+                                          {QStringLiteral("trackId"), item.trackId},
+                                          {QStringLiteral("start"), item.start},
+                                          {QStringLiteral("end"), item.overlap > 0 ? item.neighbourEdge : item.target},
+                                          {QStringLiteral("mixClipId"), item.mixPartner},
+                                          {QStringLiteral("mixFrames"), item.overlap}});
+        }
+        result[QStringLiteral("items")] = items;
+    }
+    return result;
+}
