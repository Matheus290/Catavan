+void MarkerListModel::setDurationsWithoutUndo(const QMap<int, int> &durations)
+{
+    QWriteLocker locker(&m_lock);
+    const double fps = pCore->getCurrentFps();
+    for (auto it = durations.constBegin(); it != durations.constEnd(); ++it) {
+        if (m_markerList.count(it.key()) == 0) {
+            continue;
+        }
+        m_markerList[it.key()].setDuration(GenTime(it.value(), fps));
+        int row = getRowfromId(it.key());
+        Q_EMIT dataChanged(index(row), index(row), {DurationRole, EndPosRole});
+    }
+}
+
+QMap<int, int> MarkerListModel::getRangesCrossing(int frame) const
+{
+    READ_LOCK();
+    const double fps = pCore->getCurrentFps();
+    QMap<int, int> ranges;
+    for (const auto &marker : m_markerList) {
+        if (!marker.second.hasRange()) {
+            continue;
+        }
+        int start = marker.second.time().frames(fps);
+        int duration = marker.second.duration().frames(fps);
+        if (start < frame && start + duration > frame) {
+            ranges.insert(marker.first, duration);
+        }
+    }
+    return ranges;
+}
