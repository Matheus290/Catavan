+bool MarkerListModel::rippleMarkers(int position, int delta, Fun &undo, Fun &redo)
+{
+    if (delta == 0) {
+        return true;
+    }
+    const QList<CommentedTime> allMarkers = getAllMarkers();
+    QWriteLocker locker(&m_lock);
+    const double fps = pCore->getCurrentFps();
+    const int cut = position + qMin(delta, 0);
+    struct Change
+    {
+        CommentedTime marker;
+        int start;
+        int end; // equal to start for a point marker
+    };
+    QList<Change> changes;
+    for (const CommentedTime &marker : allMarkers) {
+        const int start = marker.time().frames(fps);
+        const int end = start + (marker.hasRange() ? marker.duration().frames(fps) : 0);
+        int newStart = start;
+        int newEnd = end;
+        if (start >= position) {
+            newStart = start + delta;
+            newEnd = end + delta;
+        } else if (marker.hasRange()) {
+            // A region follows its content around the edit point
+            if (start >= cut) {
+                newStart = cut;
+            }
+            if (end > position) {
+                newEnd = end + delta;
+            } else if (end > cut) {
+                newEnd = cut;
+            }
+        }
+        if (newStart != start || newEnd != end) {
+            changes.append({marker, newStart, qMax(newStart, newEnd)});
+        }
+    }
+    // Moving right, the last markers go first (and the other way round), so a moved marker never lands on one that
+    // has not moved yet
+    std::sort(changes.begin(), changes.end(), [delta](const Change &a, const Change &b) {
+        return delta > 0 ? a.marker.time() > b.marker.time() : a.marker.time() < b.marker.time();
+    });
+    for (const Change &change : std::as_const(changes)) {
+        const CommentedTime &marker = change.marker;
+        if (!removeMarker(marker.time(), undo, redo)) {
+            return false;
+        }
+        const GenTime newPos(change.start, fps);
+        bool res = change.end > change.start
+                       ? addRangeMarker(newPos, GenTime(change.end - change.start, fps), marker.comment(), marker.markerType(), undo, redo)
+                       : addMarker(newPos, marker.comment(), marker.markerType(), undo, redo);
+        if (!res) {
+            return false;
+        }
+    }
+    return true;
+}
