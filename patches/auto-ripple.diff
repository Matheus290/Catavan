+TEST_CASE("Auto Ripple edges on three tracks", "[VegasRipple]")
+{
+    auto binModel = pCore->projectItemModel();
+    binModel->clean();
+    std::shared_ptr<DocUndoStack> undoStack = std::make_shared<DocUndoStack>(nullptr);
+    KdenliveDoc document(undoStack, {1, 3});
+    pCore->projectManager()->testSetDocument(&document);
+    QDateTime documentDate = QDateTime::currentDateTime();
+    KdenliveTests::updateTimeline(false, QString(), QString(), documentDate, 0);
+    auto timeline = document.getTimeline(document.uuid());
+    pCore->projectManager()->testSetActiveTimeline(timeline);
+    int t1 = timeline->getTrackIndexFromPosition(1);
+    int t2 = timeline->getTrackIndexFromPosition(2);
+    int t3 = timeline->getTrackIndexFromPosition(3);
+    QString binId = KdenliveTests::createProducer(pCore->getProjectProfile(), "red", binModel, 40);
+    Fun undo = []() { return true; };
+    Fun redo = []() { return true; };
+
+    SECTION("Left edge: the clips reached align at the edge origin, the others move by the full amount")
+    {
+        // B: 0, A: 10, C: 20. The left edge of B goes to 15: A aligns at 0, C goes to 5
+        int a, b, c;
+        REQUIRE(timeline->requestClipInsertion(binId, t1, 0, b));
+        REQUIRE(timeline->requestClipInsertion(binId, t2, 10, a));
+        REQUIRE(timeline->requestClipInsertion(binId, t3, 20, c));
+        REQUIRE(TimelineFunctions::rippleResize(timeline, b, 25, false, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(b) == 0);
+        REQUIRE(timeline->getClipPlaytime(b) == 25);
+        REQUIRE(timeline->getClipPosition(a) == 0);
+        REQUIRE(timeline->getClipPosition(c) == 5);
+    }
+
+    SECTION("Left edge twice: the second time the next clip aligns instead of moving the full amount")
+    {
+        // A: 10, B: 20. Left edge of A 6 to the right: B goes to 14; again: B aligns at 10 (moves 4, not 6)
+        int a, b;
+        REQUIRE(timeline->requestClipInsertion(binId, t1, 10, a));
+        REQUIRE(timeline->requestClipInsertion(binId, t2, 20, b));
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 34, false, false, undo, redo));
+        REQUIRE(timeline->getClipPosition(a) == 10);
+        REQUIRE(timeline->getClipPosition(b) == 14);
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 28, false, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 10);
+        REQUIRE(timeline->getClipPosition(b) == 10);
+    }
+
+    SECTION("Right edge: what ends after the old end moves by the same amount")
+    {
+        // X: 0..20, Y: 18..58 (crosses the end of X), Z: 25..65. Right edge of X to 15: Y and Z move back 5
+        int x, y, z;
+        REQUIRE(timeline->requestClipInsertion(binId, t1, 0, x));
+        REQUIRE(timeline->requestItemResize(x, 20, true, false) == 20);
+        REQUIRE(timeline->requestClipInsertion(binId, t2, 18, y));
+        REQUIRE(timeline->requestClipInsertion(binId, t3, 25, z));
+        REQUIRE(TimelineFunctions::rippleResize(timeline, x, 15, true, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(x) == 15);
+        REQUIRE(timeline->getClipPosition(y) == 13);
+        REQUIRE(timeline->getClipPosition(z) == 20);
+    }
+
+    SECTION("Right edge grown: a clip starting with it but ending later moves too")
+    {
+        // A: 0..20, B: 0..25 (same start). Right edge of A to 22: B moves 2
+        int a, b;
+        REQUIRE(timeline->requestClipInsertion(binId, t1, 0, a));
+        REQUIRE(timeline->requestItemResize(a, 20, true, false) == 20);
+        REQUIRE(timeline->requestClipInsertion(binId, t2, 0, b));
+        REQUIRE(timeline->requestItemResize(b, 25, true, false) == 25);
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 22, true, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(a) == 22);
+        REQUIRE(timeline->getClipPosition(b) == 2);
+    }
+
+    SECTION("Grouped clips: the edge pushes the grouped clips it reaches, then all follow the ripple")
+    {
+        // A: 10, B: 12, grouped. Left edge of A to 11: A back at 10, B at 11
+        int a, b;
+        REQUIRE(timeline->requestClipInsertion(binId, t1, 10, a));
+        REQUIRE(timeline->requestClipInsertion(binId, t2, 12, b));
+        REQUIRE(timeline->requestClipsGroup({a, b}) > -1);
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 39, false, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 10);
+        REQUIRE(timeline->getClipPosition(b) == 11);
+        REQUIRE(undo());
+        REQUIRE(timeline->getClipPosition(b) == 12);
+        // Left edge of A to 14 (past the start of B): B is trimmed along, then both are back at 10
+        undo = []() { return true; };
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 36, false, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 10);
+        REQUIRE(timeline->getClipPlaytime(a) == 36);
+        REQUIRE(timeline->getClipPosition(b) == 10);
+        REQUIRE(timeline->getClipPlaytime(b) == 38);
+    }
+
+    pCore->projectManager()->closeCurrentDocument(false, false);
+}
