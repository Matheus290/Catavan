+#include "catch.hpp"
+#include "test_utils.hpp"
+// test specific headers
+#include "core.h"
+#include "doc/docundostack.hpp"
+#include "doc/kdenlivedoc.h"
+
+#include <climits>
+
+using namespace fakeit;
+
+TEST_CASE("Auto Ripple", "[VegasRipple]")
+{
+    // Create timeline
+    auto binModel = pCore->projectItemModel();
+    binModel->clean();
+    std::shared_ptr<DocUndoStack> undoStack = std::make_shared<DocUndoStack>(nullptr);
+
+    KdenliveDoc document(undoStack, {1, 2});
+    pCore->projectManager()->testSetDocument(&document);
+    QDateTime documentDate = QDateTime::currentDateTime();
+    KdenliveTests::updateTimeline(false, QString(), QString(), documentDate, 0);
+    auto timeline = document.getTimeline(document.uuid());
+    pCore->projectManager()->testSetActiveTimeline(timeline);
+
+    int tid1 = timeline->getTrackIndexFromPosition(2);
+    int tid2 = timeline->getTrackIndexFromPosition(1);
+
+    // Clips of 20 frames
+    QString binId = KdenliveTests::createProducer(pCore->getProjectProfile(), "red", binModel, 20);
+
+    Fun undo = []() { return true; };
+    Fun redo = []() { return true; };
+
+    SECTION("Shift forward moves only the items starting after the position")
+    {
+        int a, b, c;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 10, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 40, b));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 50, c));
+        REQUIRE(TimelineFunctions::rippleShift(timeline, 30, 15, {}, false, undo, redo) == 15);
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 10);
+        REQUIRE(timeline->getClipPosition(b) == 55);
+        REQUIRE(timeline->getClipPosition(c) == 65);
+        REQUIRE(undo());
+        REQUIRE(timeline->getClipPosition(b) == 40);
+        REQUIRE(timeline->getClipPosition(c) == 50);
+    }
+
+    SECTION("Shift forward on some tracks only")
+    {
+        int b, c;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 40, b));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 50, c));
+        REQUIRE(TimelineFunctions::rippleShift(timeline, 30, 15, {tid1}, false, undo, redo) == 15);
+        REQUIRE(timeline->getClipPosition(b) == 55);
+        REQUIRE(timeline->getClipPosition(c) == 50);
+    }
+
+    SECTION("Shift back is limited by the free space of every track")
+    {
+        int a, b, c, d;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 0, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 40, b));
+        // Crosses position 40 on track 2: it stays and limits the move of the clip after it
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 25, c));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 60, d));
+        REQUIRE(TimelineFunctions::rippleShift(timeline, 40, -20, {}, false, undo, redo) == -15);
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 0);
+        REQUIRE(timeline->getClipPosition(b) == 25);
+        REQUIRE(timeline->getClipPosition(c) == 25);
+        REQUIRE(timeline->getClipPosition(d) == 45);
+    }
+
+    SECTION("Ripple delete pulls back all tracks")
+    {
+        int a, b, c, d;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 0, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 20, b));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 40, c));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 50, d));
+        REQUIRE(TimelineFunctions::rippleDelete(timeline, {b}, false, undo, redo) == -20);
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(!timeline->isClip(b));
+        REQUIRE(timeline->getClipPosition(a) == 0);
+        REQUIRE(timeline->getClipPosition(c) == 20);
+        REQUIRE(timeline->getClipPosition(d) == 30);
+        REQUIRE(undo());
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipsCount() == 4);
+        REQUIRE(timeline->getClipPosition(c) == 40);
+        REQUIRE(timeline->getClipPosition(d) == 50);
+    }
+
+    SECTION("Ripple delete of a clip crossed by a later clip on another track")
+    {
+        // A: 10..30 on track 1, B: 15..35 on track 2. Deleting A moves B back to where A started
+        int a, b;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 10, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 15, b));
+        REQUIRE(TimelineFunctions::rippleDelete(timeline, {a}, false, undo, redo) != INT_MIN);
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(b) == 10);
+    }
+
+    SECTION("Ripple delete keeps the gap that existed before the next clip")
+    {
+        // A: 10..12, B at 15: B moves back the duration of A only
+        QString tinyBinId = KdenliveTests::createProducer(pCore->getProjectProfile(), "green", binModel, 2);
+        int a, b;
+        REQUIRE(timeline->requestClipInsertion(tinyBinId, tid1, 10, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 15, b));
+        REQUIRE(TimelineFunctions::rippleDelete(timeline, {a}, false, undo, redo) != INT_MIN);
+        REQUIRE(timeline->getClipPosition(b) == 13);
+    }
+
+    SECTION("Ripple trim of the right edge")
+    {
+        // A: 0..20 (from a 60 frames source, so it can grow) and B: 20..40 on track 1, C: 30..50 on track 2
+        QString longBinId = KdenliveTests::createProducer(pCore->getProjectProfile(), "yellow", binModel, 60);
+        int a, b, c;
+        REQUIRE(timeline->requestClipInsertion(longBinId, tid1, 0, a));
+        REQUIRE(timeline->requestItemResize(a, 20, true, false) == 20);
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 20, b));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 30, c));
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 15, true, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(a) == 15);
+        REQUIRE(timeline->getClipPosition(b) == 15);
+        REQUIRE(timeline->getClipPosition(c) == 25);
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 30, true, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(a) == 30);
+        REQUIRE(timeline->getClipPosition(b) == 30);
+        REQUIRE(timeline->getClipPosition(c) == 40);
+        REQUIRE(undo());
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(a) == 20);
+        REQUIRE(timeline->getClipPosition(b) == 20);
+        REQUIRE(timeline->getClipPosition(c) == 30);
+    }
+
+    SECTION("Ripple trim of the left edge keeps the clip start")
+    {
+        // A: 10..30 and B: 30..50 on track 1
+        int a, b;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 10, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 30, b));
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 15, false, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 10);
+        REQUIRE(timeline->getClipPlaytime(a) == 15);
+        REQUIRE(timeline->getClipIn(a) == 5);
+        REQUIRE(timeline->getClipPosition(b) == 25);
+        // Extend it back from the left
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 20, false, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 10);
+        REQUIRE(timeline->getClipPlaytime(a) == 20);
+        REQUIRE(timeline->getClipIn(a) == 0);
+        REQUIRE(timeline->getClipPosition(b) == 30);
+    }
+
+    SECTION("Ripple trim moves what starts after the clip start, as the drag does")
+    {
+        // A: 0..20 on track 1, B: 10..30 on track 2 (parallel), D: 40..60 on track 1
+        int a, b, d;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 0, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 10, b));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 40, d));
+        // Left edge of B 2 frames to the right: B keeps its start, D (starts after B) moves back, A stays
+        REQUIRE(TimelineFunctions::rippleResize(timeline, b, 18, false, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(b) == 10);
+        REQUIRE(timeline->getClipPlaytime(b) == 18);
+        REQUIRE(timeline->getClipPosition(a) == 0);
+        REQUIRE(timeline->getClipPosition(d) == 38);
+        // Right edge of A 2 frames to the left: B and D (start after A) move back too
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 18, true, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(a) == 18);
+        REQUIRE(timeline->getClipPosition(b) == 8);
+        REQUIRE(timeline->getClipPosition(d) == 36);
+    }
+
+    SECTION("Ripple trim also moves the members of the group that follow, each one alone")
+    {
+        // A: 0..20 grouped with G: 25..45 on track 1, C: 30..50 on track 2
+        int a, g, c;
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 0, a));
+        REQUIRE(timeline->requestClipInsertion(binId, tid1, 25, g));
+        REQUIRE(timeline->requestClipInsertion(binId, tid2, 30, c));
