+        REQUIRE(timeline->getClipPosition(g) == 20);
+        REQUIRE(timeline->getClipPosition(c) == 25);
+        // Left edge: the start of A stays, what starts after it moves back
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 10, false, false, undo, redo));
