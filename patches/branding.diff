+void MainWindow::connectSpeedSlider(Monitor *monitor)
+{
+    if (!m_speedSlider || !monitor) {
+        return;
+    }
+    // Catavan: the slider follows the speed set by play, J/K/L or the slider itself; below 0x or beyond 4x
+    // (J/L only) it stays at its end and the label shows the real speed
+    auto showSpeed = [this](double speed) {
+        QSignalBlocker blocker(m_speedSlider);
+        m_speedSlider->setValue(qRound(qBound(0., speed, 4.) * 100));
+        m_speedLabel->setText(QStringLiteral("%1x").arg(speed, 0, 'f', 2));
+    };
+    MonitorProxy *proxy = monitor->getControllerProxy();
+    connect(proxy, &MonitorProxy::speedChanged, this, [proxy, showSpeed]() {
+        double speed = proxy->property("speed").toDouble();
+        // A pause (0) keeps the speed of the next play
+        if (!qFuzzyIsNull(speed)) {
+            showSpeed(speed);
+            KdenliveSettings::setMonitorPlaybackSpeed(speed);
+        }
+    });
+    connect(monitor, &Monitor::playbackSpeedChanged, this, showSpeed);
+}
