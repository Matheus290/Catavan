+// (0 < |s| <= max_speed, s != 1; negative = backwards), every output frame covers |s| source frames: the filter fetches
+// the audio of the source frames the playback went through, and squeezes it into the duration
+// of one frame, either by resampling (the pitch follows the speed) or with WSOLA (preserve_pitch,
+// the pitch is kept).
+
+#include "wsola_algorithm.h"
+
+#include <framework/mlt.h>
+#include <framework/mlt_log.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+namespace {
+
+const int MAX_CHANNELS = 32;
+// Larger jumps or backward moves are seeks: start over
+const int MAX_GAP = 12;
+// Source frames fetched ahead when WSOLA starts over
+const int WSOLA_PRIME_FRAMES = 3;
+
+struct private_data
+{
+    int channels{0};
+    int frequency{0};
+    bool wsola{false};
+    // Source frame up to which the audio was fetched (exclusive), -1 when starting over
+    mlt_position fetched_until{-1};
+    // Fractional source position reached by the output (in frames)
+    double cursor{0.0};
+    // Last position seen, to detect seeks
+    mlt_position last_position{-1};
+    // Playing backwards: fetched_until is then the lowest source frame fetched
+    bool reverse{false};
+    // Resampling mode: queued source audio, one vector per channel, and the read position in it
+    std::vector<std::vector<float>> fifo;
+    double read_pos{0.0};
+    wsola::AudioRendererAlgorithm *algo{nullptr};
+    // Diagnostic log, one line per frame (environment variable MONITORSPEED_LOG = file path)
+    FILE *log{nullptr};
+    bool log_checked{false};
+};
+
+FILE *diagnostic_log(private_data *pdata)
+{
+    if (!pdata->log_checked) {
+        pdata->log_checked = true;
+        const char *path = getenv("MONITORSPEED_LOG");
+        if (path && *path) {
+            pdata->log = fopen(path, "w");
+            if (pdata->log) {
+                fprintf(pdata->log, "# position speed seek from until wanted got queued_before queued_after\n");
+            }
+        }
+    }
+    return pdata->log;
+}
+
+// Source samples waiting to be played
+long queued_samples(private_data *pdata)
+{
+    if (pdata->wsola) {
+        return pdata->algo ? pdata->algo->BufferedFrames() : 0;
+    }
+    return pdata->fifo.empty() ? 0 : (long) pdata->fifo[0].size() - (long) pdata->read_pos;
+}
+
+void reset(private_data *pdata)
+{
+    pdata->fetched_until = -1;
+    pdata->last_position = -1;
+    for (auto &channel : pdata->fifo) {
+        channel.clear();
+    }
+    pdata->read_pos = 0.0;
+    if (pdata->algo) {
+        pdata->algo->FlushBuffers();
+    }
+}
+
+// Convert the common sample formats to planar float, returns false for unsupported ones
+bool to_planar_float(const void *data, mlt_audio_format format, int channels, int samples, std::vector<float> &out)
+{
+    out.resize((size_t) channels * samples);
+    switch (format) {
+    case mlt_audio_float:
+        std::memcpy(out.data(), data, sizeof(float) * out.size());
+        return true;
+    case mlt_audio_f32le:
+        for (int i = 0; i < samples; i++)
+            for (int c = 0; c < channels; c++)
+                out[(size_t) c * samples + i] = static_cast<const float *>(data)[(size_t) i * channels + c];
+        return true;
+    case mlt_audio_s16:
+        for (int i = 0; i < samples; i++)
+            for (int c = 0; c < channels; c++)
+                out[(size_t) c * samples + i] = static_cast<const int16_t *>(data)[(size_t) i * channels + c] / 32768.0f;
+        return true;
+    case mlt_audio_s32le:
+        for (int i = 0; i < samples; i++)
+            for (int c = 0; c < channels; c++)
+                out[(size_t) c * samples + i] = static_cast<const int32_t *>(data)[(size_t) i * channels + c] / 2147483648.0f;
+        return true;
+    case mlt_audio_s32:
+        for (size_t i = 0; i < out.size(); i++)
+            out[i] = static_cast<const int32_t *>(data)[i] / 2147483648.0f;
+        return true;
+    default:
+        return false;
+    }
+}
+
+// Append planar float audio to the fifo / WSOLA queue
+void enqueue(private_data *pdata, const float *data, int samples)
+{
+    if (pdata->wsola) {
+        const float *planes[MAX_CHANNELS];
+        for (int c = 0; c < pdata->channels; c++) {
+            planes[c] = data + (size_t) samples * c;
+        }
+        pdata->algo->EnqueueBuffer(planes, samples);
+    } else {
+        for (int c = 0; c < pdata->channels; c++) {
+            const float *plane = data + (size_t) samples * c;
+            pdata->fifo[c].insert(pdata->fifo[c].end(), plane, plane + samples);
+        }
+    }
+}
+
+// Write `samples` output samples covering `speed * samples` source samples
+void render(private_data *pdata, float *out, int samples, double speed)
+{
+    if (pdata->wsola) {
+        wsola::AudioBus::ChannelVector planes;
+        for (int c = 0; c < pdata->channels; c++) {
+            planes.push_back(out + (size_t) samples * c);
+        }
+        auto bus = wsola::AudioBus::CreateWrapper(planes, samples);
+        int rendered = pdata->algo->FillBuffer(bus.get(), 0, samples, speed);
+        if (rendered < samples) {
+            // WSOLA filling its look-ahead after a (re)start: leading silence
+            int missing = samples - rendered;
+            for (int c = 0; c < pdata->channels; c++) {
+                float *plane = planes[c];
+                std::memmove(plane + missing, plane, sizeof(float) * rendered);
+                std::fill_n(plane, missing, 0.0f);
+            }
+        }
+        return;
+    }
+    // Linear resampling, the pitch follows the speed
+    size_t available = pdata->fifo.empty() ? 0 : pdata->fifo[0].size();
+    for (int c = 0; c < pdata->channels; c++) {
+        const std::vector<float> &src = pdata->fifo[c];
+        float *dst = out + (size_t) samples * c;
+        double pos = pdata->read_pos;
+        for (int i = 0; i < samples; i++, pos += speed) {
+            size_t index = (size_t) pos;
+            if (index + 1 < available) {
+                double frac = pos - (double) index;
+                dst[i] = (float) (src[index] * (1.0 - frac) + src[index + 1] * frac);
+            } else {
+                dst[i] = index < available ? src[index] : 0.0f;
+            }
+        }
+    }
+    pdata->read_pos += speed * samples;
+    // On underrun (short audio after a start), resync instead of staying behind forever
+    pdata->read_pos = std::min(pdata->read_pos, (double) available);
+    // Drop what was consumed
+    size_t consumed = std::min(available, (size_t) pdata->read_pos);
+    if (consumed > 0) {
+        for (auto &channel : pdata->fifo) {
+            channel.erase(channel.begin(), channel.begin() + (long) consumed);
+        }
+        pdata->read_pos -= (double) consumed;
+    }
+}
+
+int monitorspeed_get_audio(mlt_frame frame,
+                           void **buffer,
+                           mlt_audio_format *format,
+                           int *frequency,
+                           int *channels,
+                           int *samples)
+{
+    mlt_filter filter = static_cast<mlt_filter>(mlt_frame_pop_audio(frame));
+    mlt_properties filter_properties = MLT_FILTER_PROPERTIES(filter);
+    private_data *pdata = static_cast<private_data *>(filter->child);
+    double speed = mlt_properties_get_double(MLT_FRAME_PROPERTIES(frame), "_speed");
+    double max_speed = mlt_properties_get_double(filter_properties, "max_speed");
+    if (max_speed <= 0.0) {
+        max_speed = 4.0;
+    }
+
+    if (!(speed != 0.0) || speed == 1.0 || std::fabs(speed) > max_speed || *channels > MAX_CHANNELS || *channels <= 0
+        || *frequency <= 0 || *samples <= 0) {
+        mlt_service_lock(MLT_FILTER_SERVICE(filter));
+        reset(pdata);
+        mlt_service_unlock(MLT_FILTER_SERVICE(filter));
+        return mlt_frame_get_audio(frame, buffer, format, frequency, channels, samples);
+    }
+
+    mlt_service_lock(MLT_FILTER_SERVICE(filter));
+
+    bool wsola = mlt_properties_get_int(filter_properties, "preserve_pitch") != 0;
+    if (pdata->channels != *channels || pdata->frequency != *frequency || pdata->wsola != wsola) {
+        delete pdata->algo;
+        pdata->algo = nullptr;
+        pdata->channels = *channels;
+        pdata->frequency = *frequency;
+        pdata->wsola = wsola;
+        pdata->fifo.assign(*channels, {});
+        if (wsola) {
+            pdata->algo = new wsola::AudioRendererAlgorithm;
+            pdata->algo->Initialize(*channels, *frequency);
+        }
+        reset(pdata);
+    }
+
+    const bool reverse = speed < 0.0;
+    const double rate = std::fabs(speed);
+    mlt_position position = mlt_frame_get_position(frame);
+    bool seek = pdata->last_position < 0 || reverse != pdata->reverse
+                || (reverse ? (position > pdata->last_position || pdata->last_position - position > MAX_GAP)
+                            : (position < pdata->last_position || position - pdata->last_position > MAX_GAP));
+    if (seek) {
+        // Start (or seek): the output starts at this source frame
+        reset(pdata);
+        pdata->reverse = reverse;
+        pdata->fetched_until = reverse ? position + 1 : position;
+        pdata->cursor = position;
+    } else if (!reverse && position != pdata->last_position) {
+        // Follow the producer, its fractional position is not visible here
+        pdata->cursor = std::max(pdata->cursor, (double) position);
+    }
+    pdata->last_position = position;
+
+    // The source frames this output frame goes through: forward up to the fractional position reached,
+    // backwards from this frame up to the frames already played (the producers deliver audio from the frame position)
+    double fps = mlt_profile_fps(mlt_service_profile(MLT_FILTER_SERVICE(filter)));
+    mlt_position from = pdata->fetched_until;
+    mlt_position until = (mlt_position) std::ceil(pdata->cursor + speed);
+    if (seek && pdata->wsola && !reverse) {
+        // WSOLA needs some audio ahead before it outputs anything: prime it on (re)start, otherwise every speed
+        // change starts with tens of milliseconds of silence
+        until += WSOLA_PRIME_FRAMES;
+    }
+    if (reverse) {
+        from = position;
+        until = pdata->fetched_until;
+    }
+    int error = 0;
+    long queued_before = queued_samples(pdata);
+    int wanted_log = 0, got_log = 0;
+    if (until > from) {
+        int wanted = 0;
+        for (mlt_position p = from; p < until; p++) {
+            wanted += mlt_audio_calculate_frame_samples(fps, *frequency, p);
+        }
+        // The producers deliver the audio of one frame at their frame rate: forcing fps / frames makes them
+        // deliver the audio of all the source frames at once, continuous (avformat, mix, tractor, timewarp)
+        mlt_properties_set_double(MLT_FRAME_PROPERTIES(frame), "producer_consumer_fps", fps / (double) (until - from));
+        mlt_audio_format in_format = mlt_audio_float;
+        int in_frequency = *frequency;
+        int in_channels = *channels;
+        int in_samples = wanted;
+        void *in_buffer = nullptr;
+        error = mlt_frame_get_audio(frame, &in_buffer, &in_format, &in_frequency, &in_channels, &in_samples);
+        if (!error && in_format != mlt_audio_float && frame->convert_audio) {
+            frame->convert_audio(frame, &in_buffer, &in_format, mlt_audio_float);
+        }
+        mlt_log_debug(MLT_FILTER_SERVICE(filter), "Fetch %d frames: wanted %d, got %d\n", (int) (until - from), wanted, in_samples);
+        wanted_log = wanted;
+        got_log = error ? -1 : in_samples;
+        std::vector<float> planar;
+        if (!error && in_buffer && in_channels == *channels && in_samples > 0
+            && to_planar_float(in_buffer, in_format, in_channels, in_samples, planar)) {
+            if (reverse) {
+                // Played backwards: the samples of each channel in reverse order
+                for (int c = 0; c < in_channels; c++) {
+                    std::reverse(planar.begin() + (long) c * in_samples, planar.begin() + (long) (c + 1) * in_samples);
+                }
+            }
+            enqueue(pdata, planar.data(), in_samples);
+        } else if (!error) {
+            mlt_log_debug(MLT_FILTER_SERVICE(filter), "Unusable audio: format %d, %d channels, %d samples\n", in_format, in_channels, in_samples);
+        }
+        pdata->fetched_until = reverse ? from : until;
+    } else {
+        // Nothing new to fetch (slower than 1x, the frame repeats): drop the audio stack of the producers,
+        // otherwise a later mlt_frame_get_audio() (the audio consumer) would run it and replace our output
+        // with the original audio of the frame
+        mlt_deque stack = MLT_FRAME_AUDIO_STACK(frame);
+        while (mlt_deque_count(stack) > 0) {
+            mlt_deque_pop_back(stack);
+        }
+    }
+    pdata->cursor += speed;
+
+    // One frame of output
+    struct mlt_audio_s out;
+    mlt_audio_set_values(&out, NULL, *frequency, mlt_audio_float, *samples, *channels);
+    mlt_audio_alloc_data(&out);
+    render(pdata, static_cast<float *>(out.data), out.samples, rate);
+    if (FILE *log = diagnostic_log(pdata)) {
+        fprintf(log, "%d %.3f %d %d %d %d %d %ld %ld\n", (int) position, speed, seek ? 1 : 0, (int) from, (int) until,
+                wanted_log, got_log, queued_before, queued_samples(pdata));
+        fflush(log);
+    }
+    mlt_frame_set_audio(frame, out.data, out.format, 0, out.release_data);
+    mlt_audio_get_values(&out, buffer, frequency, format, samples, channels);
+    // Tell the audio consumers (sdl2_audio, rtaudio) to play it with the normal timing
+    mlt_properties_set_int(MLT_FRAME_PROPERTIES(frame), "monitorspeed_audio", 1);
+
+    mlt_service_unlock(MLT_FILTER_SERVICE(filter));
+    return error;
+}
+
+mlt_frame filter_process(mlt_filter filter, mlt_frame frame)
+{
+    mlt_frame_push_audio(frame, (void *) filter);
+    mlt_frame_push_audio(frame, (void *) monitorspeed_get_audio);
+    return frame;
+}
+
+void close_filter(mlt_filter filter)
+{
+    private_data *pdata = static_cast<private_data *>(filter->child);
+    if (pdata) {
+        if (pdata->log) {
+            fclose(pdata->log);
+        }
+        delete pdata->algo;
+        delete pdata;
+        filter->child = NULL;
+    }
+}
+
+} // namespace
+
+extern "C" {
+
+mlt_filter filter_monitorspeed_init(mlt_profile profile, mlt_service_type type, const char *id, char *arg)
+{
+    mlt_filter filter = mlt_filter_new();
+    if (!filter) {
+        return NULL;
+    }
+    filter->child = new private_data;
+    mlt_properties_set_int(MLT_FILTER_PROPERTIES(filter), "preserve_pitch", arg ? atoi(arg) : 0);
+    mlt_properties_set_double(MLT_FILTER_PROPERTIES(filter), "max_speed", 4.0);
+    filter->process = filter_process;
+    filter->close = close_filter;
+    return filter;
+}
+}
