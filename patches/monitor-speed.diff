+schema_version: 7.2
+type: filter
+identifier: monitorspeed
+title: Monitor Playback Speed Audio
+version: 1
+copyright: Matheus Salvalagio
+license: LGPLv2.1
+language: en
+tags:
+  - Audio
+  - Hidden
+description: >
+  Attach to a consumer. When the frames come from a producer played at a speed
+  other than 1 (between -max_speed and max_speed, negative = backwards), each output frame gets the audio of
+  the source frames the playback went through, squeezed into the duration of
+  one frame: resampled (the pitch follows the speed) or time stretched with
+  WSOLA (preserve_pitch, the pitch is kept). At speed 1 the audio is passed
+  through.
+parameters:
+  - identifier: preserve_pitch
+    argument: yes
+    title: Preserve pitch
+    type: boolean
+    default: 0
+    mutable: yes
+    readonly: no
+    widget: checkbox
+  - identifier: max_speed
+    title: Maximum speed
+    description: Above this speed the audio is passed through (the consumer mutes it).
+    type: float
+    default: 4
+    minimum: 0
+    mutable: yes
+    readonly: no
