+void VideoWidget::showEdgeFrame(const QString &binId, int frame)
+{
+    m_edgeFrameActive = true;
+    m_edgeBinId = binId;
+    m_edgeFrame = frame;
+    m_edgeFramePending = true;
+    if (!m_edgeFrameBusy) {
+        renderEdgeFrame();
+    }
+}
+
+void VideoWidget::hideEdgeFrame()
+{
+    if (!m_edgeFrameActive) {
+        return;
+    }
+    m_edgeFrameActive = false;
+    m_edgeFramePending = false;
+    if (!m_edgeFrameBusy) {
+        m_edgeProducer.reset();
+        m_edgeProducerBinId.clear();
+    }
+    // Back to the last frame of the playing producer
+    m_mutex.lock();
+    m_sharedFrame = m_frameRenderer ? m_frameRenderer->getDisplayFrame() : SharedFrame();
+    m_mutex.unlock();
+    quickWindow()->update();
+}
+
+void VideoWidget::renderEdgeFrame()
+{
+    m_edgeFrameBusy = true;
+    m_edgeFramePending = false;
+    std::shared_ptr<ProjectClip> binClip;
+    if (m_edgeBinId != m_edgeProducerBinId || !m_edgeProducer) {
+        m_edgeProducer.reset();
+        m_edgeProducerBinId = m_edgeBinId;
+        binClip = pCore->projectItemModel()->getClipByBinID(m_edgeBinId);
+    }
+    const int position = m_edgeFrame;
+    const QSize size = m_profileSize;
+    // The producer is only used by this job; a new job starts after edgeFrameReady()
+    (void)QtConcurrent::run([this, binClip, position, size]() {
+        if (binClip) {
+            std::shared_ptr<Mlt::Producer> prod = binClip->cloneProducer(true);
+            if (prod && prod->is_valid()) {
+                prod->set("audio_index", -1);
+                prod->set("set.test_audio", 1);
+                if (binClip->clipType() != ClipType::Timeline && binClip->clipType() != ClipType::Playlist) {
+                    Mlt::Filter scaler(pCore->getProjectProfile(), "swscale");
+                    Mlt::Filter padder(pCore->getProjectProfile(), "resize");
+                    Mlt::Filter converter(pCore->getProjectProfile(), "avcolor_space");
+                    prod->attach(scaler);
+                    prod->attach(padder);
+                    prod->attach(converter);
+                }
+                m_edgeProducer = prod;
+            }
+        }
+        Mlt::Frame *frame = nullptr;
+        if (m_edgeProducer) {
+            int duration = m_edgeProducer->get_length();
+            m_edgeProducer->seek(duration > 0 ? qBound(0, position, duration - 1) : position);
+            frame = m_edgeProducer->get_frame();
+            if (frame && frame->is_valid()) {
+                frame->set("consumer.deinterlacer", "onefield");
+                frame->set("consumer.top_field_first", -1);
+                frame->set("consumer.rescale", "bilinear");
+                // Same format and size as the frames of the monitor consumer
+                mlt_image_format format = mlt_image_yuv420p;
+                int width = size.width();
+                int height = size.height();
+                if (!frame->get_image(format, width, height) || format != mlt_image_yuv420p) {
+                    delete frame;
+                    frame = nullptr;
+                }
+            } else {
+                delete frame;
+                frame = nullptr;
+            }
+        }
+        QMetaObject::invokeMethod(this, [this, frame]() { edgeFrameReady(frame); }, Qt::QueuedConnection);
+    });
+}
+
+void VideoWidget::edgeFrameReady(Mlt::Frame *frame)
+{
+    m_edgeFrameBusy = false;
+    if (m_edgeFrameActive && frame) {
+        m_mutex.lock();
+        m_sharedFrame = SharedFrame(*frame);
+        m_mutex.unlock();
+        quickWindow()->update();
+    }
+    delete frame;
+    if (!m_edgeFrameActive) {
+        m_edgeProducer.reset();
+        m_edgeProducerBinId.clear();
+    } else if (m_edgeFramePending) {
+        renderEdgeFrame();
+    }
+}
