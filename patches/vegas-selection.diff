@@ -0,0 +1,88 @@
+/*
+    Catavan: Shift+click selects the items between two items, as in Vegas (vegasSelection)
+    SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+#include "catch.hpp"
+#include "test_utils.hpp"
+// test specific headers
+#include "core.h"
+#include "doc/docundostack.hpp"
+#include "doc/kdenlivedoc.h"
+
+using namespace fakeit;
+
+TEST_CASE("Items between two clicked items", "[VegasSelection]")
+{
+    auto binModel = pCore->projectItemModel();
+    binModel->clean();
+    std::shared_ptr<DocUndoStack> undoStack = std::make_shared<DocUndoStack>(nullptr);
+
+    KdenliveDoc document(undoStack);
+    pCore->projectManager()->testSetDocument(&document);
+    QDateTime documentDate = QDateTime::currentDateTime();
+    KdenliveTests::updateTimeline(false, QString(), QString(), documentDate, 0);
+    auto timeline = document.getTimeline(document.uuid());
+    pCore->projectManager()->testSetActiveTimeline(timeline);
+
+    // Video tracks from the bottom: v1, v2 and a new v3 on top
+    int v1 = timeline->getTrackIndexFromPosition(2);
+    int v2 = timeline->getTrackIndexFromPosition(3);
+    int v3;
+    REQUIRE(timeline->requestTrackInsertion(-1, v3));
+    REQUIRE(timeline->getTrackPosition(v3) == 4);
+
+    QString binId = KdenliveTests::createProducer(pCore->getProjectProfile(), "red", binModel, 50);
+    // v1: a [0, 50), b [100, 150), c [200, 250), f [250, 300) right after c
+    // v2: d [120, 170), g [400, 450)
+    // v3: e [60, 110)
+    int a, b, c, f, d, g, e;
+    REQUIRE(timeline->requestClipInsertion(binId, v1, 0, a));
+    REQUIRE(timeline->requestClipInsertion(binId, v1, 100, b));
+    REQUIRE(timeline->requestClipInsertion(binId, v1, 200, c));
+    REQUIRE(timeline->requestClipInsertion(binId, v1, 250, f));
+    REQUIRE(timeline->requestClipInsertion(binId, v2, 120, d));
+    REQUIRE(timeline->requestClipInsertion(binId, v2, 400, g));
+    REQUIRE(timeline->requestClipInsertion(binId, v3, 60, e));
+    using Set = std::unordered_set<int>;
+
+    SECTION("On one track, the clips between the two, in either order")
+    {
+        REQUIRE(timeline->getItemsBetween(a, c) == Set{a, b, c});
+        REQUIRE(timeline->getItemsBetween(c, a) == Set{a, b, c});
+        // f starts where c ends: it is not between a and c
+        REQUIRE(timeline->getItemsBetween(a, b) == Set{a, b});
+    }
+
+    SECTION("Across tracks, the tracks in between and the time from the first start to the last end")
+    {
+        // [0, 170) on v1 and v2: a, b, d; c and g are later
+        REQUIRE(timeline->getItemsBetween(a, d) == Set{a, b, d});
+        // [0, 110) on v1 to v3: b crosses the range, d starts after it
+        REQUIRE(timeline->getItemsBetween(a, e) == Set{a, b, e});
+        // [60, 250) from v3 down to v1: e, d, b, c (not a, which ends at 50)
+        REQUIRE(timeline->getItemsBetween(e, c) == Set{e, d, b, c});
+    }
+
+    SECTION("Locked tracks in between are skipped")
+    {
+        timeline->setTrackLockedState(v2, true);
+        REQUIRE(timeline->getItemsBetween(e, c) == Set{e, b, c});
+        timeline->setTrackLockedState(v2, false);
+        REQUIRE(timeline->getItemsBetween(e, c) == Set{e, d, b, c});
+    }
+
+    SECTION("Without a valid anchor, only the clicked item")
+    {
+        REQUIRE(timeline->getItemsBetween(-1, b) == Set{b});
+        REQUIRE(timeline->getItemsBetween(b, b) == Set{b});
+        REQUIRE(timeline->getItemsBetween(a, -1).empty());
+    }
+
+    SECTION("The selection made from it")
+    {
+        REQUIRE(timeline->requestSetSelection(timeline->getItemsBetween(a, c)));
+        REQUIRE(timeline->getCurrentSelection() == Set{a, b, c});
+    }
+
+    pCore->projectManager()->closeCurrentDocument(false, false);
+}
