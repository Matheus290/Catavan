+int TimelineModel::requestCrossfadeMove(int clipId, bool logUndo)
+{
+    Fun undo = []() { return true; };
+    Fun redo = []() { return true; };
+    int result = requestCrossfadeMove(clipId, undo, redo);
+    if (result == 1 && logUndo) {
+        PUSH_UNDO(undo, redo, i18n("Create mix"));
+    }
+    return result;
+}
+
+int TimelineModel::requestCrossfadeMove(int clipId, Fun &undo, Fun &redo)
+{
+    QWriteLocker locker(&m_lock);
+    if (!canCrossfadeDrag(clipId)) {
+        return -1;
+    }
+    const std::shared_ptr<ClipModel> &mainClip = m_allClips[clipId];
+    int sourceTrack = mainClip->getCurrentTrackId();
+    int targetTrack = mainClip->getFakeTrackId() > -1 ? mainClip->getFakeTrackId() : sourceTrack;
+    int deltaPos = mainClip->getFakePosition() > -1 ? mainClip->getFakePosition() - mainClip->getPosition() : 0;
+    int deltaTrack = getTrackPosition(targetTrack) - getTrackPosition(sourceTrack);
+    if (deltaPos == 0 && deltaTrack == 0) {
+        // A click: the mixes stay as they are
+        return -1;
+    }
+    std::vector<CrossfadeOverlap> overlaps;
+    if (!planCrossfadeMove(clipId, 0, &overlaps)) {
+        // The usual move decides (it fails on a collision)
+        return -1;
+    }
+    const std::unordered_set<int> items = crossfadeMovingItems(clipId);
+    // Mixes of the moved clips with clips that stay
+    std::vector<std::pair<int, int>> mixes;
+    for (int item : items) {
+        if (!isClip(item)) {
+            continue;
+        }
+        std::pair<MixInfo, MixInfo> mixData = getTrackById_const(getClipTrackId(item))->getMixInfo(item);
+        if (mixData.first.firstClipId > -1 && items.count(mixData.first.firstClipId) == 0) {
+            mixes.emplace_back(mixData.first.firstClipId, item);
+        }
+        if (mixData.second.secondClipId > -1 && items.count(mixData.second.secondClipId) == 0) {
+            mixes.emplace_back(item, mixData.second.secondClipId);
+        }
+    }
+    if (overlaps.empty() && mixes.empty()) {
+        return -1;
+    }
+    // Every clip whose edges change: its full in/out (removing a mix cuts the two clips at the cut position) and how
+    // much of its start and end the new crossfades take (a mix is cut in the middle of the overlap, the mix then
+    // extends the two clips back over it)
+    struct Edges
+    {
+        int fullIn;
+        int fullOut;
+        int head;
+        int tail;
+    };
+    std::unordered_map<int, Edges> edges;
+    auto addClip = [this, &edges](int cid) {
+        if (edges.count(cid) == 0) {
+            edges[cid] = {m_allClips[cid]->getIn(), m_allClips[cid]->getOut(), 0, 0};
+        }
+    };
+    for (const auto &mix : mixes) {
+        addClip(mix.first);
+        addClip(mix.second);
+    }
+    for (const auto &overlap : overlaps) {
+        addClip(overlap.firstId);
+        addClip(overlap.secondId);
+        edges[overlap.firstId].tail += overlap.length - overlap.length / 2;
+        edges[overlap.secondId].head += overlap.length / 2;
+    }
+    // The transition chosen for each removed mix (video tracks: the audio mix has only one kind), to keep it when the
+    // crossfade is rebuilt between the same clips, or on the same side of the moved clip
+    struct MixAsset
+    {
+        int firstId;
+        int secondId;
+        std::pair<QString, QVector<QPair<QString, QVariant>>> params;
+    };
+    std::vector<MixAsset> mixAssets;
+    for (const auto &mix : mixes) {
+        auto track = getTrackById(getClipTrackId(mix.second));
+        if (!track->isAudioTrack()) {
+            mixAssets.push_back({mix.first, mix.second, track->getMixParams(mix.second)});
+        }
+    }
+    Fun local_undo = []() { return true; };
+    Fun local_redo = []() { return true; };
+    bool ok = true;
+    for (const auto &mix : mixes) {
+        ok = ok && getTrackById(getClipTrackId(mix.second))->requestRemoveMix(mix, local_undo, local_redo);
+    }
+    // Brings an edge of each clip to its final place: shrinking before the move (to make room), growing after it
+    auto adjustEdges = [this, &edges, &local_undo, &local_redo](bool shrink) {
+        for (const auto &e : edges) {
+            const std::shared_ptr<ClipModel> &clip = m_allClips[e.first];
+            int head = clip->getIn() - e.second.fullIn;
+            if (shrink ? head < e.second.head : head > e.second.head) {
+                if (!clip->requestResize(clip->getPlaytime() + head - e.second.head, false, local_undo, local_redo)) {
+                    return false;
+                }
+            }
+            int tail = e.second.fullOut - clip->getOut();
+            if (shrink ? tail < e.second.tail : tail > e.second.tail) {
+                if (!clip->requestResize(clip->getPlaytime() + tail - e.second.tail, true, local_undo, local_redo)) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    };
+    ok = ok && adjustEdges(true);
+    if (ok) {
+        if (items.size() > 1) {
+            ok = requestGroupMove(clipId, m_groups->getRootId(clipId), deltaTrack, deltaPos, true, true, local_undo, local_redo);
+        } else {
+            ok = requestClipMove(clipId, targetTrack, mainClip->getPosition() + deltaPos, true, true, true, true, local_undo, local_redo) == MoveSuccess;
+        }
+    }
+    ok = ok && adjustEdges(false);
+    for (const auto &overlap : overlaps) {
+        if (!ok) {
+            break;
+        }
+        int firstPart = overlap.length - overlap.length / 2;
+        int secondPart = overlap.length / 2;
+        const QString mixId = getTrackById_const(overlap.trackId)->isAudioTrack() ? QStringLiteral("mix") : QStringLiteral("luma");
+        ok = requestClipMix(mixId, {overlap.firstId, overlap.secondId}, {firstPart, secondPart}, overlap.trackId, overlap.start + secondPart, true, true,
+                            true, local_undo, local_redo, false);
+        if (!ok) {
+            break;
+        }
+        const MixAsset *previous = nullptr;
+        for (const auto &asset : mixAssets) {
+            if (asset.firstId == overlap.firstId && asset.secondId == overlap.secondId) {
+                previous = &asset;
+                break;
+            }
+        }
+        if (!previous) {
+            for (const auto &asset : mixAssets) {
+                bool movedFirst = items.count(overlap.firstId) > 0;
+                if ((movedFirst && asset.firstId == overlap.firstId) || (!movedFirst && asset.secondId == overlap.secondId)) {
+                    previous = &asset;
+                    break;
+                }
+            }
+        }
+        if (previous) {
+            getTrackById(overlap.trackId)->setMixAsset(overlap.secondId, previous->params.first, previous->params.second, local_undo, local_redo);
+        }
+    }
+    for (int item : items) {
+        if (isClip(item)) {
+            m_allClips[item]->cleanFakeState();
+            QModelIndex modelIndex = makeClipIndexFromID(item);
+            if (modelIndex.isValid()) {
+                notifyChange(modelIndex, modelIndex, {FakeTrackIdRole, FakePositionRole});
+            }
+        } else if (isComposition(item)) {
+            m_allCompositions[item]->cleanFakeState();
+        }
+    }
+    if (!ok) {
+        qWarning() << "crossfade move failed, reverting";
+        local_undo();
+        return 0;
+    }
+    UPDATE_UNDO_REDO(local_redo, local_undo, undo, redo);
+    return 1;
+}
+
+void TimelineModel::crossfadeTrimBegin(int clipId, bool right, bool singleResize)
+{
+    QReadLocker locker(&m_lock);
+    m_crossfadeTrim = CrossfadeTrim();
+    if (!canCrossfadeDrag(clipId)) {
+        return;
+    }
+    m_crossfadeTrim.clipId = clipId;
+    m_crossfadeTrim.right = right;
+    // Same items as the group resize in requestItemResize
+    std::unordered_set<int> items = {clipId};
+    if (!m_singleSelectionMode && !singleResize && m_groups->isInGroup(clipId)) {
+        items = m_groups->getLeaves(m_groups->getRootId(clipId));
+    }
+    for (int id : items) {
+        if (!isItem(id)) {
+            continue;
+        }
+        int tid = getItemTrackId(id);
+        int start = qMax(0, getItemPosition(id));
+        int mixPartner = -1;
+        int in = 0;
+        if (isClip(id)) {
+            if (tid == -1) {
+                continue;
+            }
+            std::pair<MixInfo, MixInfo> mixData = getTrackById_const(tid)->getMixInfo(id);
+            mixPartner = right ? mixData.second.secondClipId : mixData.first.firstClipId;
+            if (mixPartner > -1 && items.count(mixPartner) > 0) {
+                // A crossfade inside the group: the normal trim decides
+                mixPartner = -2;
+            }
+            in = m_allClips.at(id)->getIn();
+        }
+        CrossfadeTrimItem item{id, tid, start, start + getItemPlaytime(id), in, mixPartner, -1, -1, 0, -1};
+        if (id == clipId) {
+            m_crossfadeTrim.items.insert(m_crossfadeTrim.items.begin(), item);
+        } else {
+            m_crossfadeTrim.items.push_back(item);
+        }
+    }
+}
+
+int TimelineModel::crossfadeTrimBeginMix(int secondClipId, bool singleResize)
+{
+    int firstClipId = -1;
+    {
+        QReadLocker locker(&m_lock);
+        if (isClip(secondClipId) && getClipTrackId(secondClipId) > -1) {
+            firstClipId = getTrackById_const(getClipTrackId(secondClipId))->getMixInfo(secondClipId).first.firstClipId;
+        }
+    }
+    crossfadeTrimBegin(firstClipId, true, singleResize);
+    return m_crossfadeTrim.clipId > -1 ? getClipPlaytime(firstClipId) : -1;
+}
+
+QVariantMap TimelineModel::crossfadeTrimPreview(int size, int snapDistance)
+{
+    QWriteLocker locker(&m_lock);
+    CrossfadeTrim &trim = m_crossfadeTrim;
+    QVariantList overlaps;
+    QVariantMap result{{QStringLiteral("duration"), size}, {QStringLiteral("overlaps"), overlaps}, {QStringLiteral("pending"), false}};
+    if (trim.clipId == -1 || trim.items.empty() || !isClip(trim.clipId) || size < 1) {
+        return result;
+    }
+    const bool right = trim.right;
+    const CrossfadeTrimItem main = trim.items.front();
+    int edge = right ? main.start + size : main.end - size;
+    if (snapDistance > 0) {
+        edge = suggestSnapPoint(edge, snapDistance);
+    }
+    if (right ? edge <= main.start : edge >= main.end) {
+        return result;
+    }
+    std::unordered_map<int, std::pair<int, int>> pressed;
+    for (const auto &item : trim.items) {
+        pressed[item.id] = {item.start, item.end};
+    }
+    bool pending = false;
+    for (auto &item : trim.items) {
+        item.target = -1;
+        item.neighbourId = -1;
+        item.overlap = 0;
+        // The items that follow the edge, as in requestItemResize: an aligned edge, and the edges the drag crosses
+        // (groupTrimPush: shrinking, and growing to the right)
+        bool follows = item.id == trim.clipId;
+        if (!follows) {
+            bool push = KdenliveSettings::groupTrimPush() && isClip(item.id);
+            if (right) {
+                follows = item.end == main.end || (push && edge < main.end && item.end > edge && item.end < main.end && item.start < edge) ||
+                          (push && edge > main.end && item.end > main.end && item.end < edge && item.start < main.end);
+            } else {
+                follows = item.start == main.start || (push && edge > main.start && item.start < edge && item.start > main.start && item.end > edge);
+            }
+        }
+        if (!follows || item.mixPartner == -2) {
+            continue;
+        }
+        const bool growing = right ? edge > item.end : edge < item.start;
+        if (item.mixPartner == -1 && !growing) {
+            // Shrinking an edge without crossfade
+            item.target = edge;
+            continue;
+        }
+        int target = edge;
+        if (!isClip(item.id)) {
+            item.target = target;
+            continue;
+        }
+        const std::shared_ptr<ClipModel> &clip = m_allClips.at(item.id);
+        int maxDuration = clip->getMaxDuration();
+        if (maxDuration > 0) {
+            // Up to the end of its material
+            target = right ? qMin(target, item.start + maxDuration - item.in) : qMax(target, item.start - item.in);
+        }
+        auto track = getTrackById_const(item.trackId);
+        // The clip in the way: the one it crossfades with, or the nearest one after (before) the edge, as it was at the
+        // press
+        int neighbour = item.mixPartner;
+        int neighbourStart = 0;
+        int neighbourEnd = 0;
+        if (neighbour > -1) {
+            neighbourStart = getClipPosition(neighbour);
+            neighbourEnd = neighbourStart + getClipPlaytime(neighbour);
+        } else {
+            for (const auto &other : track->m_allClips) {
+                if (other.first == item.id) {
+                    continue;
+                }
+                int otherStart = other.second->getPosition();
+                int otherEnd = otherStart + other.second->getPlaytime();
+                if (pressed.count(other.first) > 0) {
+                    otherStart = pressed[other.first].first;
+                    otherEnd = pressed[other.first].second;
+                }
+                if (right ? (otherStart >= item.end && (neighbour == -1 || otherStart < neighbourStart))
+                          : (otherEnd <= item.start && (neighbour == -1 || otherEnd > neighbourEnd))) {
+                    neighbour = other.first;
+                    neighbourStart = otherStart;
+                    neighbourEnd = otherEnd;
+                }
+            }
+        }
+        item.neighbourEdge = right ? neighbourStart : neighbourEnd;
+        if (item.mixPartner > -1) {
+            // The crossfade is the overlap: it follows the edge, and goes away with it
+            pending = true;
+            item.neighbourId = neighbour;
+        }
+        if (neighbour == -1 || (right ? target <= neighbourStart : target >= neighbourEnd)) {
+            item.target = target;
+            continue;
+        }
+        // Over the clip in the way if it can crossfade: not a grouped clip, not into the mix at its other end, never
+        // covering it
+        int overlap = 0;
+        if (pressed.count(neighbour) == 0 && !track->isLocked()) {
+            std::pair<MixInfo, MixInfo> mixData = track->getMixInfo(neighbour);
+            if (right && (mixData.first.firstClipId == -1 || mixData.first.firstClipId == item.id)) {
+                int limit = neighbourEnd - 1;
+                if (mixData.second.secondClipId > -1) {
+                    limit = qMin(limit, mixData.second.secondClipInOut.first);
+                }
+                overlap = qMin(target, limit) - neighbourStart;
+            } else if (!right && (mixData.second.secondClipId == -1 || mixData.second.secondClipId == item.id)) {
+                int limit = neighbourStart + 1;
+                if (mixData.first.firstClipId > -1) {
+                    limit = qMax(limit, mixData.first.firstClipInOut.second);
+                }
+                overlap = neighbourEnd - qMax(target, limit);
+            }
+        }
+        if (overlap < 2) {
+            // A mix needs a frame on each side of the cut
+            item.target = right ? neighbourStart : neighbourEnd;
+            continue;
+        }
+        item.target = right ? neighbourStart + overlap : neighbourEnd - overlap;
+        item.neighbourId = neighbour;
+        item.overlap = overlap;
+        pending = true;
+        overlaps << QVariant(QVariantMap{{QStringLiteral("trackId"), item.trackId},
+                                         {QStringLiteral("start"), right ? neighbourStart : neighbourEnd - overlap},
+                                         {QStringLiteral("length"), overlap}});
+    }
+    if (!pending) {
+        return result;
+    }
+    const CrossfadeTrimItem &dragged = trim.items.front();
+    if (dragged.target > -1) {
+        result[QStringLiteral("duration")] = right ? dragged.target - dragged.start : dragged.end - dragged.target;
+    }
+    result[QStringLiteral("overlaps")] = overlaps;
+    result[QStringLiteral("pending")] = true;
+    if (right) {
+        // How to draw the clips that follow the edge: each one ends at the clip in the way or at the edge, and the clip
+        // it crossfaded with at the press shows the overlap left as its mix
+        QVariantList items;
+        for (const auto &item : trim.items) {
+            if (item.target == -1 || !isClip(item.id)) {
+                continue;
+            }
+            items << QVariant(QVariantMap{{QStringLiteral("id"), item.id},
+                                          {QStringLiteral("trackId"), item.trackId},
+                                          {QStringLiteral("start"), item.start},
+                                          {QStringLiteral("end"), item.overlap > 0 ? item.neighbourEdge : item.target},
+                                          {QStringLiteral("mixClipId"), item.mixPartner},
+                                          {QStringLiteral("mixFrames"), item.overlap}});
+        }
+        result[QStringLiteral("items")] = items;
+    }
+    return result;
+}
+
+bool TimelineModel::requestCrossfadeTrim()
+{
+    QWriteLocker locker(&m_lock);
+    const CrossfadeTrim trim = m_crossfadeTrim;
+    m_crossfadeTrim = CrossfadeTrim();
+    bool pending = false;
+    for (const auto &item : trim.items) {
+        pending = pending || item.neighbourId > -1;
+    }
+    if (!pending) {
+        return false;
+    }
+    const bool right = trim.right;
+    Fun undo = []() { return true; };
+    Fun redo = []() { return true; };
+    // Brings an edge of a clip to a position
+    auto resizeTo = [this](int id, int position, bool rightEdge, Fun &local_undo, Fun &local_redo) {
+        int start = getItemPosition(id);
+        int size = rightEdge ? position - start : start + getItemPlaytime(id) - position;
+        if (size == getItemPlaytime(id)) {
+            return true;
+        }
+        return size > 0 && requestItemResize(id, size, rightEdge, true, local_undo, local_redo);
+    };
+    for (const auto &item : trim.items) {
+        if (item.target == -1) {
+            continue;
+        }
+        Fun local_undo = []() { return true; };
+        Fun local_redo = []() { return true; };
+        bool ok = true;
+        int firstPart = item.overlap - item.overlap / 2;
+        int secondPart = item.overlap / 2;
