+std::unordered_set<int> TimelineModel::getItemsBetween(int anchorId, int itemId)
+{
+    std::unordered_set<int> items;
+    if (!isItem(itemId)) {
+        return items;
+    }
+    items.insert(itemId);
+    if (anchorId == itemId || !isItem(anchorId)) {
+        return items;
+    }
+    items.insert(anchorId);
+    // The rows of the tracks, from the bottom; the subtitle track is shown above the others
+    const int tracksCount = getTracksCount();
+    auto rowOf = [this, tracksCount](int id) {
+        const int tid = getItemTrackId(id);
+        return tid == -2 ? tracksCount : getTrackPosition(tid);
+    };
+    const int firstRow = qMin(rowOf(anchorId), rowOf(itemId));
+    const int lastRow = qMax(rowOf(anchorId), rowOf(itemId));
+    const int start = qMin(getItemPosition(anchorId), getItemPosition(itemId));
+    const int end = qMax(getItemPosition(anchorId) + getItemPlaytime(anchorId), getItemPosition(itemId) + getItemPlaytime(itemId));
+    for (int row = firstRow; row <= qMin(lastRow, tracksCount - 1); row++) {
+        const int tid = getTrackIndexFromPosition(row);
+        if (getTrackById_const(tid)->isLocked()) {
+            continue;
+        }
+        const auto trackItems = getItemsInRange(tid, start, end, true);
+        items.insert(trackItems.begin(), trackItems.end());
+    }
+    if (lastRow == tracksCount && m_subtitleModel) {
+        const auto subs = m_subtitleModel->getItemsInRange(-1, start, end);
+        items.insert(subs.begin(), subs.end());
+    }
+    return items;
+}
