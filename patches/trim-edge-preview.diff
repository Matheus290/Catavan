+void TimelineController::showTrimEdgeFrame(int clipId, bool right, int size)
+{
+    if (!KdenliveSettings::trimEdgePreview() || pCore->activeTool() != ToolType::SelectTool || !m_model->isClip(clipId)) {
+        return;
+    }
+    std::shared_ptr<ClipModel> clip = m_model->getClipPtr(clipId);
+    if (clip->isAudioOnly() || clip->clipState() == PlaylistState::AudioOnly) {
+        return;
+    }
+    // Source frame of the edge, as computed for the clip thumbnails
+    int pos = right ? (size > 0 ? clip->getIn() + size - 1 : clip->getOut()) : clip->getIn();
+    double speed = clip->getSpeed();
+    int frame = speed >= 0 ? qRound(pos * speed) : qRound((clip->getMaxDuration() - pos) * -speed - 1);
+    pCore->monitorManager()->projectMonitor()->showEdgeFrame(clip->binId(), qMax(0, frame));
+}
