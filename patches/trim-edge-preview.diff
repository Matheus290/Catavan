+double Monitor::normalPlaySpeed()
+{
+    if (!KdenliveSettings::monitorSpeedSlider() || qFuzzyIsNull(KdenliveSettings::monitorPlaybackSpeed())) {
+        return 1.;
+    }
+    return KdenliveSettings::monitorPlaybackSpeed();
