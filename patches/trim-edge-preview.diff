+void TimelineController::setClickedItem(int itemId, bool add)
+{
+    const auto selection = m_model->getCurrentSelection();
+    if (add) {
+        // Shift+click: the previous clicks still count if the selection only grew by the clicked item (and its group)
+        auto previous = m_clickedSelection;
+        const auto added = m_model->getGroupElements(itemId);
+        previous.insert(added.begin(), added.end());
+        add = previous == selection;
+    }
+    if (!add) {
+        m_clickedItems.clear();
+    }
+    m_clickedItems.insert(itemId);
+    m_clickedSelection = selection;
+}
+
+void TimelineController::selectItemsBetween(int anchorId, int itemId, bool addToSelect)
+{
