+
+void Monitor::setPlaybackSpeed(double speed)
+{
+    if (!m_playAction->isActive()) {
+        return;
+    }
+    if (qFuzzyIsNull(speed)) {
+        pause();
+        return;
+    }
+    m_glMonitor->switchPlay(true, speed);
+}
+
+void Monitor::stepPlaybackSpeed(int direction)
+{
+    double base = m_playAction->isActive() ? m_glMonitor->playSpeed() : KdenliveSettings::monitorPlaybackSpeed();
+    bool beyond = direction > 0 ? (base >= 4. || base < -4.) : (base > 4. || base <= -4.);
+    double speed = std::round((base + direction * (beyond ? 1. : 0.25)) * 100.) / 100.;
+    KdenliveSettings::setMonitorPlaybackSpeed(speed);
+    Q_EMIT playbackSpeedChanged(speed);
+    if (qFuzzyIsNull(speed)) {
+        pause();
+        return;
+    }
+    if (!m_playAction->isActive()) {
+        m_startPlaybackPos = position();
+    }
+    updatePlayAction(true);
+    m_glMonitor->switchPlay(true, speed);
+}
+
+void Monitor::resetPlaybackSpeed()
+{
+    KdenliveSettings::setMonitorPlaybackSpeed(1.);
+    Q_EMIT playbackSpeedChanged(1.);
+    if (m_playAction->isActive()) {
+        m_glMonitor->switchPlay(true, 1.);
+    }
+}
