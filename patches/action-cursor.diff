+    if (itemsToSelect.empty()) {
+        return;
+    }
+    if (addToSelect) {
+        const auto selection = m_model->getCurrentSelection();
+        itemsToSelect.insert(selection.begin(), selection.end());
+    }
+    m_model->requestSetSelection(itemsToSelect);
+}
