+        if (!m_model->isClip(id) && !m_model->isComposition(id)) {
+            continue;
+        }
+        if (m_model->trackIsLocked(m_model->getItemTrackId(id))) {
+            Q_EMIT m_model->flashLock(m_model->getItemTrackId(id));
+            return true;
+        }
+        int pos = m_model->getItemPosition(id);
+        start = start < 0 ? pos : qMin(start, pos);
+        end = qMax(end, pos + m_model->getItemPlaytime(id));
+    }
+    if (start < 0) {
+        return false;
+    }
+    Fun undo = []() { return true; };
+    Fun redo = []() { return true; };
