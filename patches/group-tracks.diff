+/*
+    Catavan: Ungroup takes only the picked clips out of their group (ungroupSelectedOnly)
+    SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+#include "catch.hpp"
+#include "test_utils.hpp"
+// test specific headers
+#include "core.h"
+#include "doc/docundostack.hpp"
+#include "doc/kdenlivedoc.h"
+#include "kdenlivesettings.h"
+
+using namespace fakeit;
+
+TEST_CASE("Remove clips from their group", "[VegasGroup]")
+{
+    auto binModel = pCore->projectItemModel();
+    binModel->clean();
+    std::shared_ptr<DocUndoStack> undoStack = std::make_shared<DocUndoStack>(nullptr);
+
+    KdenliveDoc document(undoStack);
+    pCore->projectManager()->testSetDocument(&document);
+    QDateTime documentDate = QDateTime::currentDateTime();
+    KdenliveTests::updateTimeline(false, QString(), QString(), documentDate, 0);
+    auto timeline = document.getTimeline(document.uuid());
+    pCore->projectManager()->testSetActiveTimeline(timeline);
+
+    int videoTrack = timeline->getTrackIndexFromPosition(2);
+
+    // Three clips with audio and video: a at 0, b at 100, c at 200
+    QString binId = KdenliveTests::createProducerWithSound(pCore->getProjectProfile(), binModel, 50);
+    QMap<int, QString> audioInfo;
+    audioInfo.insert(1, QStringLiteral("stream1"));
+    KdenliveTests::setAudioTargets(timeline, audioInfo);
+    int a, b, c;
+    REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 0, a));
+    REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 100, b));
+    REQUIRE(timeline->requestClipInsertion(binId, videoTrack, 200, c));
+    int audioA = timeline->getClipSplitPartner(a);
+    int audioB = timeline->getClipSplitPartner(b);
+    int audioC = timeline->getClipSplitPartner(c);
+    REQUIRE(audioA > -1);
+    REQUIRE(audioB > -1);
+    REQUIRE(audioC > -1);
+    using Set = std::unordered_set<int>;
+    const Set pairA{a, audioA}, pairB{b, audioB}, pairC{c, audioC};
+    auto join = [](std::initializer_list<Set> sets) {
+        Set all;
+        for (const auto &s : sets) {
+            all.insert(s.begin(), s.end());
+        }
+        return all;
+    };
+    auto groupOf = [&](int id) { return timeline->getGroupElements(id); };
+
+    SECTION("A clip leaves a group of three with its audio, the two others stay grouped")
+    {
+        REQUIRE(timeline->requestClipsGroup({a, b, c}) > -1);
+        REQUIRE(groupOf(a) == join({pairA, pairB, pairC}));
+
+        REQUIRE(timeline->requestRemoveItemsFromGroups({b}));
+        auto removedState = [&]() {
+            REQUIRE(timeline->checkConsistency());
+            REQUIRE(groupOf(a) == join({pairA, pairC}));
+            REQUIRE(groupOf(c) == join({pairA, pairC}));
+            REQUIRE(groupOf(b) == pairB);
+            REQUIRE(groupOf(audioB) == pairB);
+        };
+        removedState();
+        undoStack->undo();
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(groupOf(b) == join({pairA, pairB, pairC}));
+        undoStack->redo();
+        removedState();
+
+        // Picking the audio part takes the same pair out
+        undoStack->undo();
+        REQUIRE(timeline->requestRemoveItemsFromGroups({audioB}));
+        removedState();
+
+        // A group left with one member is removed; the pairs stay
+        REQUIRE(timeline->requestRemoveItemsFromGroups({a}));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(groupOf(a) == pairA);
+        REQUIRE(groupOf(c) == pairC);
+        undoStack->undo();
+        removedState();
+    }
+
+    SECTION("Two clips leave at once")
+    {
+        REQUIRE(timeline->requestClipsGroup({a, b, c}) > -1);
+        REQUIRE(timeline->requestRemoveItemsFromGroups({a, c}));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(groupOf(a) == pairA);
+        REQUIRE(groupOf(b) == pairB);
+        REQUIRE(groupOf(c) == pairC);
+        undoStack->undo();
+        REQUIRE(groupOf(b) == join({pairA, pairB, pairC}));
+    }
+
+    SECTION("Nested groups: the clip leaves all of them")
+    {
+        REQUIRE(timeline->requestClipsGroup({a, b}) > -1);
+        REQUIRE(timeline->requestClipsGroup({a, c}) > -1);
+        REQUIRE(groupOf(c) == join({pairA, pairB, pairC}));
+        REQUIRE(timeline->requestRemoveItemsFromGroups({a}));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(groupOf(a) == pairA);
+        REQUIRE(groupOf(b) == join({pairB, pairC}));
+        undoStack->undo();
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(groupOf(a) == join({pairA, pairB, pairC}));
+        // The inner group {a, b} is back
+        undoStack->undo();
+        REQUIRE(groupOf(a) == join({pairA, pairB}));
+    }
+
+    SECTION("A clip alone with its audio: the pair is split, as the original Ungroup")
+    {
+        REQUIRE(timeline->requestRemoveItemsFromGroups({b}));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(groupOf(b) == Set{b});
+        REQUIRE(groupOf(audioB) == Set{audioB});
+        undoStack->undo();
+        REQUIRE(groupOf(b) == pairB);
+    }
+
+    SECTION("Nothing to do for a clip in no group")
+    {
+        REQUIRE(timeline->requestClipUngroup(b));
+        REQUIRE_FALSE(timeline->requestRemoveItemsFromGroups({b}));
+        REQUIRE(timeline->checkConsistency());
+    }
+
+    pCore->projectManager()->closeCurrentDocument(false, false);
+}
+
+TEST_CASE("Moving a grouped clip to another track keeps the other kind on its tracks", "[VegasGroup]")
+{
+    auto binModel = pCore->projectItemModel();
+    binModel->clean();
+    std::shared_ptr<DocUndoStack> undoStack = std::make_shared<DocUndoStack>(nullptr);
+
+    KdenliveDoc document(undoStack);
+    pCore->projectManager()->testSetDocument(&document);
+    QDateTime documentDate = QDateTime::currentDateTime();
+    KdenliveTests::updateTimeline(false, QString(), QString(), documentDate, 0);
+    auto timeline = document.getTimeline(document.uuid());
+    pCore->projectManager()->testSetActiveTimeline(timeline);
+
+    int video1 = timeline->getTrackIndexFromPosition(2);
+    int video2 = timeline->getTrackIndexFromPosition(3);
+    REQUIRE_FALSE(timeline->isAudioTrack(video1));
+    REQUIRE_FALSE(timeline->isAudioTrack(video2));
+    QString binId = KdenliveTests::createProducerWithSound(pCore->getProjectProfile(), binModel, 50);
+    QMap<int, QString> audioInfo;
+    audioInfo.insert(1, QStringLiteral("stream1"));
+    KdenliveTests::setAudioTargets(timeline, audioInfo);
+    int v;
+    REQUIRE(timeline->requestClipInsertion(binId, video2, 100, v));
+    int a = timeline->getClipSplitPartner(v);
+    REQUIRE(a > -1);
+    const int audioTrack = timeline->getClipTrackId(a);
+
+    SECTION("Video down one track: the audio stays (real move), undo")
+    {
+        KdenliveSettings::setGroupTracksIndependent(true);
+        REQUIRE(timeline->requestClipMove(v, video1, 120));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipTrackId(v) == video1);
+        REQUIRE(timeline->getClipPosition(v) == 120);
+        REQUIRE(timeline->getClipTrackId(a) == audioTrack);
+        REQUIRE(timeline->getClipPosition(a) == 120);
+        undoStack->undo();
+        REQUIRE(timeline->getClipTrackId(v) == video2);
+        REQUIRE(timeline->getClipTrackId(a) == audioTrack);
+    }
+
+    SECTION("Video down one track: the audio stays (fake move of a drag)")
+    {
+        KdenliveSettings::setGroupTracksIndependent(true);
+        REQUIRE(timeline->requestFakeClipMove(v, video1, 100, true, false, false));
+        REQUIRE(KdenliveTests::getClipPtr(timeline, v)->getFakeTrackId() == video1);
+        int audioFake = KdenliveTests::getClipPtr(timeline, a)->getFakeTrackId();
+        REQUIRE((audioFake == -1 || audioFake == audioTrack));
+    }
+
+    SECTION("Without the option, the audio mirrors the move (upstream)")
+    {
+        KdenliveSettings::setGroupTracksIndependent(false);
+        REQUIRE(timeline->requestClipMove(v, video1, 100));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipTrackId(v) == video1);
+        REQUIRE(timeline->getClipTrackId(a) != audioTrack);
+        KdenliveSettings::setGroupTracksIndependent(true);
+    }
+
+    pCore->projectManager()->closeCurrentDocument(false, false);
+}
