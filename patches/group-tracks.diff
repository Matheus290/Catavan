+bool TimelineModel::requestCrossfadeTrim()
+{
+    QWriteLocker locker(&m_lock);
+    const CrossfadeTrim trim = m_crossfadeTrim;
+    m_crossfadeTrim = CrossfadeTrim();
+    bool pending = false;
+    for (const auto &item : trim.items) {
+        pending = pending || item.neighbourId > -1;
+    }
+    if (!pending) {
+        return false;
+    }
+    const bool right = trim.right;
+    Fun undo = []() { return true; };
+    Fun redo = []() { return true; };
+    // Brings an edge of a clip to a position
+    auto resizeTo = [this](int id, int position, bool rightEdge, Fun &local_undo, Fun &local_redo) {
+        int start = getItemPosition(id);
+        int size = rightEdge ? position - start : start + getItemPlaytime(id) - position;
+        if (size == getItemPlaytime(id)) {
+            return true;
+        }
+        return size > 0 && requestItemResize(id, size, rightEdge, true, local_undo, local_redo);
+    };
+    for (const auto &item : trim.items) {
+        if (item.target == -1) {
+            continue;
+        }
+        Fun local_undo = []() { return true; };
+        Fun local_redo = []() { return true; };
+        bool ok = true;
+        int firstPart = item.overlap - item.overlap / 2;
+        int secondPart = item.overlap / 2;
+        std::pair<int, int> clips = right ? std::make_pair(item.id, item.neighbourId) : std::make_pair(item.neighbourId, item.id);
+        std::pair<QString, QVector<QPair<QString, QVariant>>> mixParams;
+        bool keepAsset = false;
+        if (item.mixPartner > -1) {
+            // The crossfade it had goes away (the two clips are cut where it was cut), then is made again from the new
+            // overlap with the same transition
+            auto track = getTrackById(item.trackId);
+            if (!track->isAudioTrack()) {
+                mixParams = track->getMixParams(clips.second);
+                keepAsset = true;
+            }
+            ok = track->requestRemoveMix(clips, local_undo, local_redo);
+        }
+        // Each clip to its new edge; with a crossfade, the clip and the one in the way meet in the middle of the
+        // overlap and the mix extends both back over it (as requestCrossfadeMove)
+        int itemEdge = item.target;
+        int neighbourEdge = -1;
+        int cut = -1;
+        if (item.neighbourId > -1) {
+            if (item.overlap > 0) {
+                cut = right ? item.target - item.overlap + secondPart : item.target + secondPart;
+                itemEdge = cut;
+                neighbourEdge = cut;
+            } else if (item.mixPartner > -1) {
+                // Back to the full length of the clip it crossfaded with
+                neighbourEdge = item.neighbourEdge;
+            }
+        }
+        // Shrinking first, to make room
+        bool itemShrinks = right ? itemEdge < getItemPosition(item.id) + getItemPlaytime(item.id) : itemEdge > getItemPosition(item.id);
+        if (ok && itemShrinks) {
+            ok = resizeTo(item.id, itemEdge, right, local_undo, local_redo);
+        }
+        if (ok && neighbourEdge > -1) {
+            ok = resizeTo(item.neighbourId, neighbourEdge, !right, local_undo, local_redo);
+        }
+        if (ok && !itemShrinks) {
+            ok = resizeTo(item.id, itemEdge, right, local_undo, local_redo);
+        }
+        if (ok && item.overlap > 0) {
+            const QString mixId = getTrackById_const(item.trackId)->isAudioTrack() ? QStringLiteral("mix") : QStringLiteral("luma");
+            ok = requestClipMix(mixId, clips, {firstPart, secondPart}, item.trackId, cut, true, true, true, local_undo, local_redo, false);
+            if (ok && keepAsset) {
+                getTrackById(item.trackId)->setMixAsset(clips.second, mixParams.first, mixParams.second, local_undo, local_redo);
+            }
+        }
+        if (!ok) {
+            local_undo();
+            if (item.id == trim.clipId) {
+                qWarning() << "crossfade trim failed, reverting";
+                undo();
+                return false;
+            }
+            // A grouped item that cannot follow is left as it is (groupTrimPush)
+            continue;
+        }
+        UPDATE_UNDO_REDO(local_redo, local_undo, undo, redo);
+    }
+    PUSH_UNDO(undo, redo, i18n("Resize clip"));
+    return true;
+}
