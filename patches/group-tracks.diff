+
+bool TimelineModel::planCrossfadeMove(int clipId, int delta, std::vector<CrossfadeOverlap> *overlaps) const
+{
+    if (overlaps) {
+        overlaps->clear();
+    }
+    const std::unordered_set<int> items = crossfadeMovingItems(clipId);
+    // A clip that stays can be overlapped by one moved clip only
+    std::unordered_set<int> overlapped;
+    for (int item : items) {
+        if (!isClip(item)) {
+            // Compositions and subtitles move along, they don't crossfade
+            continue;
+        }
+        const std::shared_ptr<ClipModel> &clip = m_allClips.at(item);
+        int tid = clip->getFakeTrackId() > -1 ? clip->getFakeTrackId() : clip->getCurrentTrackId();
+        if (!isTrack(tid)) {
+            return false;
+        }
+        int pos = (clip->getFakePosition() > -1 ? clip->getFakePosition() : clip->getPosition()) + delta;
+        int end = pos + clip->getPlaytime();
+        if (pos < 0) {
+            return false;
+        }
+        auto track = getTrackById_const(tid);
+        int before = -1, after = -1;
+        int beforeLength = 0, afterStart = 0, afterLength = 0;
+        for (const auto &other : track->m_allClips) {
+            if (items.count(other.first) > 0) {
+                continue;
+            }
+            int otherStart = other.second->getPosition();
+            int otherEnd = otherStart + other.second->getPlaytime();
+            if (otherEnd <= pos || otherStart >= end) {
+                continue;
+            }
+            if (otherStart < pos && otherEnd < end && before == -1) {
+                // Its end is under the start of the moved clip
+                before = other.first;
+                beforeLength = otherEnd - pos;
+            } else if (otherStart > pos && otherEnd > end && after == -1) {
+                // Its start is under the end of the moved clip
+                after = other.first;
+                afterStart = otherStart;
+                afterLength = end - otherStart;
+            } else {
+                // Covered, covering or a third clip
+                return false;
+            }
+        }
+        if (before == -1 && after == -1) {
+            continue;
+        }
+        if (track->isLocked() || beforeLength + afterLength > end - pos) {
+            // The two crossfades of the moved clip may not overlap
+            return false;
+        }
+        if ((before > -1 && beforeLength < 2) || (after > -1 && afterLength < 2)) {
+            // A crossfade is cut in the middle: one frame would leave one of its sides empty
+            return false;
+        }
+        if (before > -1) {
+            if (overlapped.count(before) > 0) {
+                return false;
+            }
+            overlapped.insert(before);
+            std::pair<MixInfo, MixInfo> mixData = track->getMixInfo(before);
+            // Not into the mix at its start, and no mix at its end with a clip that stays
+            if (mixData.first.firstClipId > -1 && pos < mixData.first.firstClipInOut.second) {
+                return false;
+            }
+            if (mixData.second.secondClipId > -1 && items.count(mixData.second.secondClipId) == 0) {
+                return false;
+            }
+            if (overlaps) {
+                overlaps->push_back({before, item, tid, pos, beforeLength});
+            }
+        }
+        if (after > -1) {
+            if (overlapped.count(after) > 0) {
+                return false;
+            }
+            overlapped.insert(after);
+            std::pair<MixInfo, MixInfo> mixData = track->getMixInfo(after);
+            if (mixData.second.secondClipId > -1 && end > mixData.second.secondClipInOut.first) {
+                return false;
+            }
+            if (mixData.first.firstClipId > -1 && items.count(mixData.first.firstClipId) == 0) {
+                return false;
+            }
+            if (overlaps) {
+                overlaps->push_back({item, after, tid, afterStart, afterLength});
+            }
+        }
+    }
+    return true;
+}
+
+QVariantList TimelineModel::crossfadePreview(int clipId) const
+{
+    QVariantList result;
+    std::vector<CrossfadeOverlap> overlaps;
+    if (canCrossfadeDrag(clipId) && planCrossfadeMove(clipId, 0, &overlaps)) {
+        for (const auto &overlap : overlaps) {
+            result << QVariant(QVariantMap{{QStringLiteral("trackId"), overlap.trackId},
+                                           {QStringLiteral("start"), overlap.start},
+                                           {QStringLiteral("length"), overlap.length}});
+        }
+    }
+    return result;
+}
