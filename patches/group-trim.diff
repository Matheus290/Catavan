+bool TimelineModel::requestRemoveItemsFromGroups(const std::unordered_set<int> &itemIds, bool logUndo)
+{
+    QWriteLocker locker(&m_lock);
+    TRACE(itemIds, logUndo);
+    requestClearSelection();
+    // The unit that leaves: the item, or its audio/video pair when the pair is inside a larger group
+    std::unordered_set<int> units;
+    for (int id : itemIds) {
+        int unit = id;
+        for (int parent = m_groups->getDirectAncestor(id); parent != -1; parent = m_groups->getDirectAncestor(parent)) {
+            if (m_groups->getType(parent) == GroupType::AVSplit && m_groups->getDirectAncestor(parent) != -1) {
+                unit = parent;
+            }
+        }
+        if (m_groups->getDirectAncestor(unit) != -1) {
+            units.insert(unit);
+        }
+    }
+    if (units.empty()) {
+        TRACE_RES(false);
+        return false;
+    }
+    Fun undo = []() { return true; };
+    Fun redo = []() { return true; };
+    bool result = true;
+    // Rebuilds the subtree of gid without the units: each group on the way is destructed (its children become roots)
+    // and grouped again with what remains. Returns the id of the remaining subtree, -1 when nothing remains.
+    std::function<int(int)> rebuild = [&](int gid) -> int {
+        if (units.count(gid) > 0) {
+            return -1;
+        }
+        const std::unordered_set<int> subtree = m_groups->getSubtree(gid);
+        if (!isGroup(gid) || std::none_of(subtree.begin(), subtree.end(), [&](int id) { return units.count(id) > 0; })) {
+            return gid;
+        }
+        GroupType type = m_groups->getType(gid);
+        const std::unordered_set<int> children = m_groups->getDirectChildren(gid);
+        if (!m_groups->ungroupItem(gid, undo, redo)) {
+            result = false;
+            return gid;
+        }
+        std::unordered_set<int> kept;
+        for (int child : children) {
+            int remaining = rebuild(child);
+            if (remaining > -1) {
+                kept.insert(remaining);
+            }
+        }
+        if (kept.size() < 2) {
+            return kept.empty() ? -1 : *kept.begin();
+        }
+        int newGroup = m_groups->groupItems(kept, undo, redo, type);
+        result = result && newGroup > -1;
+        return newGroup;
+    };
+    std::unordered_set<int> roots;
+    std::transform(units.begin(), units.end(), std::inserter(roots, roots.begin()), [&](int id) { return m_groups->getRootId(id); });
+    for (int root : roots) {
+        rebuild(root);
+    }
+    if (!result) {
+        bool undone = undo();
+        Q_ASSERT(undone);
+        TRACE_RES(false);
+        return false;
+    }
+    // we make sure that the undo and the redo are going to unselect before doing anything else
+    Fun unselect = [this]() { return requestClearSelection(); };
+    PUSH_FRONT_LAMBDA(unselect, undo);
+    PUSH_FRONT_LAMBDA(unselect, redo);
+    if (logUndo) {
+        PUSH_UNDO(undo, redo, i18n("Remove from group"));
+    }
+    TRACE_RES(true);
+    return true;
+}
