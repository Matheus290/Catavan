+        REQUIRE(TimelineFunctions::rippleResize(timeline, x, 15, true, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(x) == 15);
+        REQUIRE(timeline->getClipPosition(y) == 13);
+        REQUIRE(timeline->getClipPosition(z) == 20);
+    }
+
+    SECTION("Right edge grown: a clip starting with it but ending later moves too")
+    {
+        // A: 0..20, B: 0..25 (same start). Right edge of A to 22: B moves 2
+        int a, b;
+        REQUIRE(timeline->requestClipInsertion(binId, t1, 0, a));
+        REQUIRE(timeline->requestItemResize(a, 20, true, false) == 20);
+        REQUIRE(timeline->requestClipInsertion(binId, t2, 0, b));
+        REQUIRE(timeline->requestItemResize(b, 25, true, false) == 25);
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 22, true, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPlaytime(a) == 22);
+        REQUIRE(timeline->getClipPosition(b) == 2);
+    }
+
+    SECTION("Grouped clips: the edge pushes the grouped clips it reaches, then all follow the ripple")
+    {
+        // A: 10, B: 12, grouped. Left edge of A to 11: A back at 10, B at 11
+        int a, b;
+        REQUIRE(timeline->requestClipInsertion(binId, t1, 10, a));
+        REQUIRE(timeline->requestClipInsertion(binId, t2, 12, b));
+        REQUIRE(timeline->requestClipsGroup({a, b}) > -1);
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 39, false, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 10);
+        REQUIRE(timeline->getClipPosition(b) == 11);
+        REQUIRE(undo());
+        REQUIRE(timeline->getClipPosition(b) == 12);
+        // Left edge of A to 14 (past the start of B): B is trimmed along, then both are back at 10
+        undo = []() { return true; };
+        REQUIRE(TimelineFunctions::rippleResize(timeline, a, 36, false, false, undo, redo));
+        REQUIRE(timeline->checkConsistency());
+        REQUIRE(timeline->getClipPosition(a) == 10);
+        REQUIRE(timeline->getClipPlaytime(a) == 36);
+        REQUIRE(timeline->getClipPosition(b) == 10);
+        REQUIRE(timeline->getClipPlaytime(b) == 38);
+    }
+
+    pCore->projectManager()->closeCurrentDocument(false, false);
+}
