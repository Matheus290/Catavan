+void TimelineController::splitClipsAtCursor()
+{
+    const int position = pCore->getMonitorPosition();
+    const auto selection = m_model->getCurrentSelection();
+    bool hasSelectedClip = false;
+    {
+        QMutexLocker lk(&m_metaMutex);
+        for (int cid : selection) {
+            if (!m_model->isClip(cid) && !m_model->isSubTitle(cid)) {
+                continue;
+            }
+            hasSelectedClip = true;
+            int start = m_model->getItemPosition(cid);
+            if (position > start && position < start + m_model->getItemPlaytime(cid)) {
+                // Cutting the other clips of the selection is handled in TimelineFunctions
+                TimelineFunctions::requestClipCut(m_model, cid, position);
+                return;
+            }
+        }
+    }
+    if (hasSelectedClip) {
+        pCore->displayMessage(i18n("No clip to cut"), ErrorMessage, 500);
+        return;
+    }
+    QMutexLocker lk(&m_metaMutex);
+    TimelineFunctions::requestClipCutAll(m_model, position, true);
+}
