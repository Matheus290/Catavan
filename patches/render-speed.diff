+/* Catavan: a small per thread cache of initialized swscale contexts. Creating a context with its slice threads for
+ * every frame (and every slice of the sliced conversions) took a good part of the render time; the render workers
+ * and the mlt_slices threads live as long as the consumer, so the contexts are reused frame after frame. */
+#define SWS_CACHE_SIZE (8)
+
+typedef struct
+{
+    mlt_sws_params params;
+    struct SwsContext *context;
+    int luma_result;
+} sws_cache_entry;
+
+typedef struct
+{
+    sws_cache_entry entries[SWS_CACHE_SIZE]; // most recently used first
+    int count;
+} sws_cache;
+
+static pthread_key_t sws_cache_key;
+static pthread_once_t sws_cache_once = PTHREAD_ONCE_INIT;
+
+static void sws_cache_free(void *data)
+{
+    sws_cache *cache = data;
+    for (int i = 0; i < cache->count; i++)
+        sws_freeContext(cache->entries[i].context);
+    free(cache);
+}
+
+static void sws_cache_init_key(void)
+{
+    pthread_key_create(&sws_cache_key, sws_cache_free);
+}
+
+void mlt_sws_params_init(mlt_sws_params *params,
+                         int src_width,
+                         int src_height,
+                         int src_format,
+                         int dst_width,
+                         int dst_height,
+                         int dst_format,
+                         int flags)
+{
+    memset(params, 0, sizeof(*params));
+    params->src_width = src_width;
+    params->src_height = src_height;
+    params->src_format = src_format;
+    params->dst_width = dst_width;
+    params->dst_height = dst_height;
+    params->dst_format = dst_format;
+    params->flags = flags;
+    params->src_h_chr_pos = params->src_v_chr_pos = -513;
+    params->dst_h_chr_pos = params->dst_v_chr_pos = -513;
+}
+
+struct SwsContext *mlt_sws_cached_context(const mlt_sws_params *params, int *luma_result)
+{
+    pthread_once(&sws_cache_once, sws_cache_init_key);
+    sws_cache *cache = pthread_getspecific(sws_cache_key);
+    if (!cache) {
+        cache = calloc(1, sizeof(*cache));
+        if (!cache || pthread_setspecific(sws_cache_key, cache)) {
+            free(cache);
+            return NULL;
+        }
+    }
+
+    int found = -1;
+    for (int i = 0; i < cache->count; i++) {
+        if (!memcmp(&cache->entries[i].params, params, sizeof(*params))) {
+            found = i;
+            break;
+        }
+    }
+    sws_cache_entry entry;
+    if (found >= 0) {
+        entry = cache->entries[found];
+        memmove(&cache->entries[1], &cache->entries[0], found * sizeof(entry));
+    } else {
+        struct SwsContext *context = sws_alloc_context();
+        if (!context)
+            return NULL;
+        av_opt_set_int(context, "srcw", params->src_width, 0);
+        av_opt_set_int(context, "srch", params->src_height, 0);
+        av_opt_set_int(context, "src_format", params->src_format, 0);
+        av_opt_set_int(context, "dstw", params->dst_width, 0);
+        av_opt_set_int(context, "dsth", params->dst_height, 0);
+        av_opt_set_int(context, "dst_format", params->dst_format, 0);
+        av_opt_set_int(context, "sws_flags", params->flags, 0);
+        av_opt_set_int(context, "src_h_chr_pos", params->src_h_chr_pos, 0);
+        av_opt_set_int(context, "src_v_chr_pos", params->src_v_chr_pos, 0);
+        av_opt_set_int(context, "dst_h_chr_pos", params->dst_h_chr_pos, 0);
+        av_opt_set_int(context, "dst_v_chr_pos", params->dst_v_chr_pos, 0);
+#if LIBSWSCALE_VERSION_MAJOR >= 6
+        if (params->threads > 0)
+            av_opt_set_int(context, "threads", params->threads, 0);
+#endif
+        if (sws_init_context(context, NULL, NULL) < 0) {
+            sws_freeContext(context);
+            return NULL;
+        }
+        entry.params = *params;
+        entry.context = context;
+        entry.luma_result = params->set_luma_transfer ? mlt_set_luma_transfer(context,
+                                                                               params->src_colorspace,
+                                                                               params->dst_colorspace,
+                                                                               params->src_full_range,
+                                                                               params->dst_full_range)
+                                                      : 0;
+        if (cache->count == SWS_CACHE_SIZE)
+            sws_freeContext(cache->entries[--cache->count].context);
+        memmove(&cache->entries[1], &cache->entries[0], cache->count * sizeof(entry));
+        cache->count++;
+    }
+    cache->entries[0] = entry;
+    if (luma_result)
+        *luma_result = entry.luma_result;
+    return entry.context;
+}
+
+#if LIBSWSCALE_VERSION_MAJOR >= 6
+static void buffer_not_owned(void *opaque, uint8_t *data)
+{
+    (void) opaque;
+    (void) data;
+}
+
+/* Catavan: an AVFrame over planes it does not own, reference counted so that sws_scale_frame neither copies the
+ * input nor allocates the output. */
+static int wrap_planes(AVFrame *frame, uint8_t **data, int *stride, int format, int width, int height)
+{
+    frame->width = width;
+    frame->height = height;
+    frame->format = format;
+    for (int i = 0; i < 4; i++) {
+        frame->data[i] = data[i];
+        frame->linesize[i] = stride[i];
+    }
+    int size = av_image_get_buffer_size(format, width, height, 1);
+    frame->buf[0] = av_buffer_create(data[0], size > 0 ? size : 1, buffer_not_owned, NULL, 0);
+    return frame->buf[0] ? 0 : -1;
+}
+
+int mlt_sws_scale_planes(struct SwsContext *context,
+                         uint8_t **src_data,
+                         int *src_stride,
+                         int src_format,
+                         int src_width,
+                         int src_height,
+                         uint8_t **dst_data,
+                         int *dst_stride,
+                         int dst_format,
+                         int dst_width,
+                         int dst_height)
+{
+    int result = -1;
+    AVFrame *src = av_frame_alloc();
+    AVFrame *dst = av_frame_alloc();
+    if (src && dst && !wrap_planes(src, src_data, src_stride, src_format, src_width, src_height)
+        && !wrap_planes(dst, dst_data, dst_stride, dst_format, dst_width, dst_height)) {
+        result = sws_scale_frame(context, dst, src);
+        if (result >= 0 && dst->data[0] != dst_data[0])
+            result = -1;
+    }
+    av_frame_free(&src);
+    av_frame_free(&dst);
+    return result < 0 ? result : 0;
+}
+#endif
